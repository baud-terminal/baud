    /// IND: down one line, scrolling the region if already at its bottom.[m
    ///[m
    /// **The column is not touched.** This used to reset `cx`, which made `LF`[m
    /// and `ESC D` behave as `NEL`. `[[source: ctlseqs]]` defines IND as index[m
    /// only, and LNM (mode 20, reset by default) is what decides whether LF[m
    /// also returns to column 1 -- so the old behaviour was LNM permanently on.[m
    #[inline(always)][m
    pub(crate) fn index(&mut self) {[m
        if self.cy == self.scroll_bot {[m
            self.scroll_region_up(Count::ONE);[m
        } else if let Some(r) = self.cy.next(self.rows) {[m
            self.cy = r;[m
        }[m
        // The destination line starts empty of spans.[m
        //[m
        // Load-bearing for chunk invariance, not tidiness: without it runs[m
        // accumulate on a line across index operations, so whether MAXRUN[m
        // overflows -- and therefore whether the line gets promoted -- depends[m
        // on how the input happened to be split into reads. Dropping this line[m
        // broke ingest_is_chunk_invariant.[m
        //[m
        // KNOWN GAP: this also means IND onto an *existing* unpromoted line[m
        // discards its spans, where the spec moves the cursor without touching[m
        // content. Recorded in docs/vt-coverage.md rather than fixed here,[m
        // because fixing it means bounding run growth some other way and that[m
        // needs its own measurement.[m
        let i = self.line();[m
        self.s.nrun[i.index()] = RunCount::ZERO;[m
    }[m
[m
    /// CR + IND: what autowrap does at the right margin, and what NEL is.[m
    #[inline(always)][m
    /// NEL, and the wrap at the right margin.[m
    ///[m
    /// Returns to the **left margin**, not to column 0. With DECSLRM set, text[m
    /// wrapping to column 0 would leave the scrolling region entirely, which is[m
    /// the whole thing side margins exist to prevent.[m
    pub(crate) fn wrap(&mut self) {[m
        self.cx = self.left_margin;[m
        self.index();[m
    }[m
[m
    /// RI. Up one line, scrolling the region down if already at its top.[m
    ///[m
    /// Was keyed on row 0 rather than the region top, so `ESC M` inside a[m
    /// scrolling region scrolled the whole screen.[m
:[K[K:[K[K    #[inline(always)][m
    pub(crate) fn reverse_index(&mut self) {[m
        if self.cy == self.scroll_top {[m
            self.scroll_region_down(Count::ONE);[m
        } else if self.cy.index() > 0 {[m
            self.cy = self.cy.up(Count::ONE);[m
        }[m
    }[m
[m
    /// LF. Adds the carriage return only when LNM is set.[m
    #[inline(always)][m
    pub(crate) fn line_feed(&mut self) {[m
        self.index();[m
        if self.modes.is_set(ModeBit::LineFeedNewLine) {[m
            self.cx = Col::ZERO;[m
        }[m
    }[m
[m
    /// Origin for row addressing, and the row a CUP parameter is relative to.[m
    ///[m
    /// `[[source: vt510-decom]]`: "When DECOM is set, the home cursor position[m
    /// is at the upper-left corner of the screen, within the margins. The[m
    /// starting point for line numbers depends on the current top margin[m
    /// setting. The cursor cannot move outside of the margins."[m
    pub(crate) fn origin_row(&self) -> Row {[m
        if self.modes.is_set(ModeBit::Origin) {[m
            self.scroll_top[m
        } else {[m
            Row::ZERO[m
        }[m
    }[m
[m
    /// Clamp a row to the margins when DECOM confines the cursor to them.[m
    pub(crate) fn confine(&self, r: Row) -> Row {[m
        if !self.modes.is_set(ModeBit::Origin) {[m
            return r;[m
        }[m
        Row::from_index([m
            r.index()[m
                .clamp(self.scroll_top.index(), self.scroll_bot.index()),[m
        )[m
    }[m
}[m
