impl<'a> Term<'a> {[m
    /// `ESC ( ) * + <C>` — designate a character set into a G-slot.[m
    ///[m
    /// Designating does not change what is displayed until the slot is invoked[m
    /// into GL by SO/SI, which is why this only records.[m
    pub(crate) fn designate(&mut self, slot: GSlot, c: StreamByte) {[m
        self.g[slot.index()] = Charset::from_final(c);[m
        self.refresh_flags();[m
    }[m
[m
    /// `ESC ( % 6` — designate a set whose final takes two bytes.[m
    pub(crate) fn designate_multi(&mut self, slot: GSlot, inter: StreamByte, c: StreamByte) {[m
        let set = Charset::from_multi(inter, c);[m
        if set == Charset::Other {[m
            // A two-byte final the specification does not list. Counted rather[m
            // than recorded, so it cannot look designated.[m
            self.unsupported.inc();[m
        }[m
        self.g[slot.index()] = set;[m
        self.refresh_flags();[m
    }[m
[m
    /// The set designated into one G-slot, invoked or not.[m
    ///[m
    /// `Term::charset` reports GL only, so a designation into G1, G2 or G3 was[m
    /// invisible from outside -- `ESC ) 0` recorded the line-drawing set and[m
    /// nothing could observe that it had. A renderer needs all four, because[m
    /// SO/SI can invoke any of them without another designation.[m
    pub fn charset_in(&self, slot: GSlot) -> Charset {[m
        self.g[slot.index()][m
    }[m
[m
    /// How incoming bytes are decoded. `ESC % @` / `ESC % G` select it.[m
    pub fn input_encoding(&self) -> InputEncoding {[m
        self.encoding[m
    }[m
[m
    /// Whether replies use 7-bit or 8-bit C1 introducers. S7C1T / S8C1T.[m
    pub fn c1_transmit(&self) -> C1Transmit {[m
        self.c1[m
    }[m
[m
    /// The character set currently invoked into GL.[m
    pub fn charset(&self) -> Charset {[m
        self.g[self.gl.index()][m
    }[m
}[m
