/// East Asian Ambiguous characters are 1 or 2 columns depending on locale.[m
///[m
/// `[[source: uax11]]` § 5: narrow when the context is unavailable. For a[m
/// `no_std` core with no locale it is always unavailable, so `Narrow` is the[m
/// default — and it is what xterm does too, whose `cjkWidth` defaults false.[m
#[derive(Clone, Copy, PartialEq, Eq, Default, Debug)][m
pub enum AmbiguousWidth {[m
    #[default][m
    Narrow,[m
    Wide,[m
}[m
[m
/// Width in cells.[m
///[m
/// Font-independent by wire contract, not preference: `ncurses` on the far end[m
/// computes columns with `wcwidth`, so a terminal using font advances would[m
/// drift from the application's model of the screen. Verified against[m
/// alacritty, whose model crate has no font dependency at all.[m
///[m
/// Consequence encoded below: [`DisplayWidth::measure`] takes a [`WidthTable`][m
/// and nothing else. A font change cannot invalidate a cached width, because a[m
/// font never entered the computation.[m
#[derive(Clone, Copy, PartialEq, Eq, FromBytes, IntoBytes, Immutable, KnownLayout)][m
#[repr(transparent)][m
pub struct DisplayWidth(pub(crate) u32);[m
[m
impl DisplayWidth {[m
    pub const ZERO: DisplayWidth = DisplayWidth(0);[m
    /// The only constructor. Caching this measured 14 us against 2223 us to[m
    /// recompute from bytes, for 15k lines — 4 bytes per line.[m
    pub(crate) fn cells(self) -> u32 {[m
        self.0[m
    }[m
    /// Byte length *is* column count, but only for a byte-per-column encoding.[m
    /// Callable only where a `Bytes<Printable>` or `Bytes<DecGraphics>` proof[m
    /// exists, which is what makes it sound.[m
    pub(crate) fn from_len(n: ByteLen) -> DisplayWidth {[m
        DisplayWidth(n.index() as u32)[m
    }[m
}[m
[m
impl WidthTable {[m
    pub const DIAG: WidthTable = WidthTable {[m
        ambiguous: AmbiguousWidth::Narrow,[m
    };[m
}[m
