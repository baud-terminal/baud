    /// DECRC. Restores the cursor and rendition DECSC saved, **clamped to the[m
    /// grid that exists now**.[m
    ///[m
    /// The save may predate a resize, and `resize` homes the cursor but cannot[m
:[K[K:[K[K    /// touch a position already stored. Restoring row 49 into a one-row grid[m
    /// left `cy` outside it, and `cy` is not only a report: writes and erases[m
    /// index with it, and `View::phys` is a single conditional subtract that[m
    /// assumes it is in range. `Term::cursor` already clamps the *column* for[m
    /// exactly this reason -- "a 200-column page has no column 201" -- and the[m
    /// row had the same hole with none of the clamping.[m
    ///[m
    /// `cx` clamps to `cols` rather than `cols - 1` so the deferred-wrap[m
    /// sentinel survives a restore on an unchanged grid: with autowrap on, `cx`[m
    /// legitimately sits one past the last column until the next write[m
    /// consumes it, and flattening that here would turn a saved wrap-pending[m
    /// state into an ordinary one.[m
    ///[m
    /// One implementation because DECRC arrives two ways -- `ESC 8` and[m
    /// `CSI u`'s sibling in the escape table -- and two copies of a clamp is[m
    /// how one of them comes to lack it.[m
    pub(crate) fn restore_cursor(&mut self) {[m
        self.place_saved(self.saved);[m
    }[m
[m
    /// Apply a saved cursor and rendition, clamped to the current grid.[m
    ///[m
    /// Shared with `?1049 l`, which `[[source: ctlseqs]]` defines as restoring[m
    /// "cursor as in DECRC" -- so it is the same operation and must not be a[m
    /// second implementation. It was one, and the second lacked the clamp.[m
    pub(crate) fn place_saved(&mut self, saved: Option<(Row, Col, StyleId, StyleWord, CellFlags)>) {[m
        let Some((r, c, st, sw, fl)) = saved else {[m
            return;[m
        };[m
        self.cy = Row::from_index(r.index().min(self.rows.index() - 1));[m
        self.cx = Col::at_index(c.index().min(self.cols.index()));[m
        self.style = st;[m
        self.style_raw = sw;[m
        self.flags = fl;[m
    }[m
}[m
