# Rust/Cargo
target/
# Cargo.lock IS committed. This template produces a binary; for a library,
# delete it and add `Cargo.lock` here instead.

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# Local secrets, loaded by devenv's dotenv (devenv.nix: dotenv.enable).
.env

# pre-commit — generated by devenv's git-hooks module, not authored here.
.pre-commit-config.yaml

# Nix build results
result
result-*

# Editor
.vscode/
.idea/

# macOS
.DS_Store

# Internal tracking. Anchored with a leading slash deliberately: git matches a
# bare `todo.md` pattern at ANY depth, so an unanchored entry here would also
# swallow e.g. `docs/todo.md` in a project that wants to commit one.
/todo.md
/TODO.md
/config.toml

# Claude Code's own directory: local settings, workflows, worktrees and
# session research, some of it third-party source under its own licence
# (GPL among it). None of it is this repository's, and one `git add -A`
# would commit all of it. Anchored like the entries above.
/.claude/

# rustc ICE reports, which a crashing compiler leaves where it ran
rustc-ice-*.txt

# A build tree that got in once: an ad-hoc command's `$S` was unset, cargo
# wrote to a literal `$S/`, and `git add -A` committed 139 files and
# 59.5 MB of rlibs in ee9ceef. `target/` above did not match it. The
# pattern is deliberately the literal name rather than a glob: a shell
# variable that reaches the filesystem unexpanded is the bug, and naming
# it keeps the next one visible rather than silently ignored.
$S/

# The tour's MP4 and its timeline, which `--record assets/demo/tour.mp4`
# writes beside its committed record: the MP4 is uploaded, not kept here,
# and an untracked file would make the next take's tree dirty.
/assets/demo/tour.mp4
/assets/demo/tour.timeline.tsv
# Its two versions, which `scripts/demo-sound.sh` writes beside it, and the
# directory that run works in.
/assets/demo/tour.silent.mp4
/assets/demo/tour.clicks.mp4
/assets/demo/.tour.sound.*/
