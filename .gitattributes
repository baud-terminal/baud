# Byte-exact fixtures. A recording is a terminal's input as it arrived, carriage returns included,
# and a patch applied as text drops a line's CR, so recordings never pass through text handling.
tools/tests/**/*.raw binary
*.png binary
*.jpg binary
*.gif binary
*.ppm binary
*.ttf binary
*.otf binary
*.spv binary
*.mp4 binary
*.pdf binary
# The source captures are pinned by SHA-256 in docs/research/sources/MANIFEST.toml, so their line ends are the capture's.
docs/research/sources/** -text
# Licence texts keep the CRLF line ends they ship with.
LICENSES/windows-terminal-MIT.txt -text
crates/baud-app/fonts/glyphs/languages/hebrew/OFL.txt -text
crates/baud-app/fonts/glyphs/languages/hebrew/stage/CascadiaMono-OFL.txt -text
crates/baud-app/fonts/symbols-nerd-font/icon-licences/codicons/LICENSE.txt -text
crates/baud-app/fonts/symbols-nerd-font/icon-licences/weather-icons/OFL.txt -text
crates/baud-font/tests/fonts/SourceCodeVF-LICENSE.txt -text
crates/baud-font/tests/var/SourceCodeVF-LICENSE.txt -text
