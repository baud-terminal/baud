+                    o.from.push(Col::at_index(own.col.index() + 1));
+                    o.level.push(l);
+                    src.push(row.window);
+                }
+            }
+            if !rtl {
+                for _ in 0..pad {
+                    o.from.push(Col::ZERO);
+                    o.level.push(level);
+                    src.push(None);
+                }
+            }
+            if o.from.len() != cols {
+                return false;
+            }
+            disp.push(Disp::Line(o, src));
+        }
+        let (Some(first), Some(last)) = (
+            rows.first().and_then(|r| r.window),
+            rows.last().and_then(|r| r.window),
+        ) else {
+            return false;
+        };
+        self.proto.0 += rows.len();
+        self.proto.1 += disp.len();
+        self.broken.push((first, last, disp));
+        true
+    }
