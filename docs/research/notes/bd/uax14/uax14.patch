+    /// **PROTOTYPE (uax14): the paragraph re-broken the way a text engine
+    /// breaks it**: the resolved text cut into lines at UAX #14 break
+    /// opportunities (`[[source: uax14]]`; LB2-LB31, no tailoring) so each
+    /// line fills at most the window's width -- a space at a line's end
+    /// hangs past it and is not drawn, as CSS's `pre-wrap` hangs it -- a
+    /// word wider than the line cut at a cell (UAX #14's emergency break),
+    /// and each line ordered by L1-L2 on its own (UAX #9 3.4). Only a
+    /// paragraph whose rows are all in the window; otherwise W1.
+    #[cfg(feature = "proto-uax14-wrap")]
+    fn rebreak(
+        &mut self,
+        term: &Term<'_>,
+        rows: &[ParaRow<'_>],
+        ranges: &[(core::ops::Range<usize>, Col)],
+        level: BidiLevel,
+    ) -> bool {
+        let _ = term;
+        if rows.iter().any(|r| r.window.is_none()) {
+            return false;
+        }
+        let cols = self.orders.cols.index();
+        let rtl = level.direction() == baud_domain::BidiDirection::Rtl;
+        let begin = ranges.first().map_or(0, |r| r.0.start);
+        let end = ranges.last().map_or(0, |r| r.0.end);
+        let n = end - begin;
+        if n == 0 {
+            return false;
+        }
+        let mut prow = vec![0usize; n];
+        for (p, (rg, _)) in ranges.iter().enumerate() {
+            for t in rg.clone() {
+                prow[t - begin] = p;
+            }
+        }
+        let width: Vec<usize> = (0..n)
+            .map(|k| {
+                let o = self.owner[begin + k];
+                if o.lead != Lead::First {
+                    return 0;
+                }
+                let cells = rows[prow[k]].cells;
+                match cells.get(o.col.index() + 1).is_some_and(|c| c.content.is_wide_tail()) {
+                    true => 2,
+                    false => 1,
+                }
+            })
+            .collect();
+        let mut allow = vec![false; n + 1];
+        baud_domain::line_breaks(&self.text[begin..end], |i, b| {
+            allow[i] = b != baud_domain::LineBreak::Prohibited;
+        });
+        let next_lead = |t: usize| {
+            let mut u = t + 1;
+            while u < n && self.owner[begin + u].lead != Lead::First {
+                u += 1;
+            }
+            u
+        };
+        // Greedy fill: the last opportunity whose ink fits.
+        let mut lines: Vec<core::ops::Range<usize>> = Vec::new();
+        let mut s = 0;
+        while s < n {
+            let (mut w, mut ink) = (0usize, 0usize);
+            let (mut best, mut cut): (Option<usize>, Option<usize>) = (None, None);
+            let mut t = s;
+            while t < n {
+                let u = next_lead(t);
+                let cw: usize = width[t..u].iter().sum();
+                let nw = w + cw;
+                let ni = if self.text[begin + t] == ' ' { ink } else { nw };
+                if ni > cols {
+                    cut = Some(t);
+                    break;
+                }
+                (w, ink, t) = (nw, ni, u);
+                if t < n && allow[t] {
+                    best = Some(t);
+                }
+            }
+            let e = match cut {
+                None => n,
+                Some(c) => match best {
+                    Some(b) if b > s => b,
+                    _ if c > s => c,
+                    _ => next_lead(s),
+                },
+            };
+            lines.push(s..e);
+            s = e;
+        }
+        let mut disp: Vec<Disp> = Vec::with_capacity(lines.len());
+        for line in &lines {
+            // A space at the line's end past its width hangs.
+            let mut hung = vec![false; line.len()];
+            let mut drawn: usize = width[line.clone()].iter().sum();
+            let mut k = line.end;
+            while drawn > cols && k > line.start && self.text[begin + k - 1] == ' ' {
+                k -= 1;
+                hung[k - line.start] = true;
+                drawn -= width[k];
+            }
+            if drawn > cols {
+                return false;
+            }
+            let (ls, le) = (begin + line.start, begin + line.end);
+            if self.order_line(ls..le).is_none() {
+                return false;
+            }
+            let levels = self.levels.clone();
+            let mut o = RowOrder {
+                from: Vec::with_capacity(cols),
+                to: Vec::new(),
+                level: Vec::with_capacity(cols),
+                swaps: Vec::new(),
+            };
+            let mut src: Vec<Option<Row>> = Vec::with_capacity(cols);
+            let pad = cols - drawn;
+            if rtl {
+                for _ in 0..pad {
+                    o.from.push(Col::ZERO);
+                    o.level.push(level);
+                    src.push(None);
+                }
+            }
+            for &t in &self.order {
+                let t = usize::from(t);
+                let own = self.owner[t];
+                if own.lead != Lead::First || hung[t - ls] {
+                    continue;
+                }
+                let l = levels[t - ls];
+                let row = &rows[prow[t - begin]];
+                o.from.push(own.col);
+                o.level.push(l);
+                src.push(row.window);
+                let cell = row.cells[own.col.index()];
+                if l.direction() == baud_domain::BidiDirection::Rtl {
+                    match mirror(term, cell) {
+                        Mirror::Glyph(m) => o.swaps.push((Col::at_index(o.from.len() - 1), m)),
+                        Mirror::Missing => self.unmirrored.bump(),
