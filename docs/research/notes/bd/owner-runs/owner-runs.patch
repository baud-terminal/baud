+#[cfg(feature = "owner-runs")]
+impl Reorder {
+    /// **Prototype: the owner-runs layout of the window**, after
+    /// [`Reorder::lay_out`] has made today's maps. Each paragraph wholly in
+    /// the window that spans more than one stored row and holds a
+    /// foreign-direction run is re-broken: its levels resolved whole, its
+    /// text split at each run's ends (snapped to UAX #14 opportunities),
+    /// each piece wrapped at UAX #14 opportunities within the width, and
+    /// each display line ordered by L1-L2 over the paragraph's levels.
+    /// Every other paragraph keeps today's rows. Display lines are laid
+    /// down from the window's top; what passes the window's last row is
+    /// dropped and reported.
+    fn lay_out_runs(&mut self, term: &Term<'_>, vp: &Viewport<'_>) {
+        use baud_domain::{BidiClass, BidiDirection, LineBreak, line_breaks};
+        self.runs_report.clear();
+        let (nrows, ncols) = (vp.rows().index(), vp.cols().index());
+        let mut display: Vec<PackedCell> = Vec::new();
+        let mut levels_out: Vec<Option<RowOrder>> = Vec::new();
+        let mut dropped = 0usize;
+        let mut push_line = |cells: Vec<PackedCell>, order: Option<RowOrder>, display: &mut Vec<PackedCell>, levels_out: &mut Vec<Option<RowOrder>>| {
+            if levels_out.len() >= nrows {
+                dropped += 1;
+                return;
+            }
+            display.extend_from_slice(&cells);
+            levels_out.push(order);
+        };
+        let mut y = 0;
+        let mut rebroken_any = false;
+        while y < nrows {
+            let first = y;
+            while y + 1 < nrows && vp.wrapped(Row::from_index(y)) == Wrap::Continues {
+                y += 1;
+            }
+            let last = y;
+            y += 1;
+            let keep = |me: &Self, display: &mut Vec<PackedCell>, levels_out: &mut Vec<Option<RowOrder>>, push: &mut dyn FnMut(Vec<PackedCell>, Option<RowOrder>, &mut Vec<PackedCell>, &mut Vec<Option<RowOrder>>)| {
+                for r in first..=last {
+                    let row = Row::from_index(r);
+                    let mut cells = vec![PackedCell::EMPTY; ncols];
+                    me.orders.permute(row, vp.row(row), &mut cells);
+                    push(cells, me.orders.rows[r].clone(), display, levels_out);
+                }
+            };
+            // Only a paragraph that wraps, wholly in the window, not a table.
+            let whole = !(first == 0 && term.looking_back(Rows::of_index(1)) == Rows::of_index(1) && term.view(Rows::of_index(1)).wrapped(Row::ZERO) == Wrap::Continues)
+                && !(last + 1 == nrows && vp.wrapped(Row::from_index(last)) == Wrap::Continues);
+            if last == first || !whole {
+                keep(self, &mut display, &mut levels_out, &mut push_line);
+                continue;
+            }
+            // The paragraph's text, each codepoint's stored row and column.
+            let mut text: Vec<char> = Vec::new();
+            let mut at: Vec<(usize, Col, Lead, usize)> = Vec::new(); // row, col, lead, width
+            let mut table = false;
+            for r in first..=last {
+                let cells = vp.row(Row::from_index(r));
+                let end = row_end(cells);
+                for (c, &cell) in cells[..end.index()].iter().enumerate() {
+                    if cell.content.is_wide_tail() {
+                        continue;
+                    }
+                    let wide = cells.get(c + 1).is_some_and(|n| n.content.is_wide_tail());
+                    let w = if wide { 2 } else { 1 };
+                    if cell.content.is_empty() {
+                        text.push(ERASED);
+                        at.push((r, Col::at_index(c), Lead::First, 1));
+                        continue;
+                    }
+                    let base = term.base_of(cell).drawn().as_codepoint()
+                        .and_then(|c| char::from_u32(c.value())).unwrap_or('\u{FFFD}');
+                    table |= !cell.flags.is_marked() && is_column_rule(base);
+                    text.push(base);
+                    at.push((r, Col::at_index(c), Lead::First, w));
+                    if cell.flags.is_marked() {
+                        for m in term.cluster_marks(cell) {
+                            if let Some(m) = char::from_u32(m) {
+                                text.push(m);
+                                at.push((r, Col::at_index(c), Lead::Attached, 0));
+                            }
+                        }
+                    }
+                }
+            }
+            if table || text.is_empty() {
+                keep(self, &mut display, &mut levels_out, &mut push_line);
+                continue;
+            }
+            let Ok(plevel) = self.bidi.resolve(&text, DIRECTION) else {
+                keep(self, &mut display, &mut levels_out, &mut push_line);
+                continue;
+            };
+            let levels: Vec<BidiLevel> = self.bidi.levels().to_vec();
+            let prtl = plevel.direction() == BidiDirection::Rtl;
+            // Foreign stretches: maximal ranges above the paragraph level
+            // holding a strong letter of the other direction.
+            let foreign = |c: char| {
+                let k = BidiProps::of(c).class;
+                match prtl {
+                    true => k == BidiClass::L,
+                    false => matches!(k, BidiClass::R | BidiClass::AL),
+                }
+            };
+            let mut stretches: Vec<(usize, usize)> = Vec::new();
+            let mut i = 0;
+            while i < text.len() {
+                if levels[i].number() > plevel.number() {
+                    let s = i;
+                    while i < text.len() && levels[i].number() > plevel.number() {
+                        i += 1;
+                    }
+                    let crosses = at[s].0 != at[i - 1].0;
+                    if text[s..i].iter().any(|&c| foreign(c))
+                        && (!self.runs.crossing_only() || crosses)
+                    {
+                        stretches.push((s, i));
+                    }
+                } else {
+                    i += 1;
+                }
+            }
+            if stretches.is_empty() {
+                keep(self, &mut display, &mut levels_out, &mut push_line);
+                continue;
+            }
+            // UAX #14 opportunities, by position (a break before text[p]).
+            let mut allowed = vec![false; text.len() + 1];
+            line_breaks(&text, |p, b| allowed[p] = b != LineBreak::Prohibited);
+            let mut cuts: Vec<usize> = Vec::new();
+            let mut raw = 0usize;
+            for &(s, e) in &stretches {
+                let lo = cuts.last().copied().unwrap_or(0);
+                if s > 0 {
+                    match (lo + 1..=s).rev().find(|&p| allowed[p]) {
+                        Some(p) => cuts.push(p),
+                        None => {
+                            raw += 1;
+                            cuts.push(s)
+                        }
+                    }
+                }
+                if e < text.len() {
+                    let lo = cuts.last().copied().unwrap_or(0);
+                    match (e.max(lo + 1)..text.len()).find(|&p| allowed[p]) {
+                        Some(p) => cuts.push(p),
+                        None => {
+                            raw += 1;
+                            cuts.push(e)
+                        }
+                    }
+                }
+            }
+            cuts.dedup();
+            // Pieces, each wrapped to the width at its last opportunity.
+            let mut bounds = vec![0usize];
+            bounds.extend(cuts.iter().copied().filter(|&p| p > 0 && p < text.len()));
+            bounds.push(text.len());
+            bounds.dedup();
+            let mut lines: Vec<(usize, usize)> = Vec::new();
+            let mut charbreaks = 0usize;
+            for w in bounds.windows(2) {
+                let (mut a, b) = (w[0], w[1]);
+                while a < b {
+                    let mut width = 0usize;
+                    let mut fit = a;
+                    let mut best: Option<usize> = None;
+                    let mut t = a;
+                    while t < b {
+                        let nw = width + at[t].3;
+                        if nw > ncols {
+                            break;
+                        }
+                        width = nw;
+                        t += 1;
+                        while t < b && at[t].2 == Lead::Attached {
+                            t += 1;
+                        }
+                        fit = t;
+                        if t < b && allowed[t] {
+                            best = Some(t);
+                        }
+                    }
+                    let end = if fit == b { b } else {
+                        match best {
+                            Some(p) => p,
+                            None => {
+                                charbreaks += 1;
+                                fit.max(a + 1)
+                            }
+                        }
+                    };
+                    lines.push((a, end));
+                    a = end;
+                }
+            }
+            // Each line ordered by L1-L2 over the paragraph's levels.
+            let mut desc = Vec::new();
+            self.rule.clear();
+            self.rule.resize(text.len(), Rule::No);
+            let mut solo: Option<Box<Bidi<CONTEXT>>> = None;
+            for &(a, b) in &lines {
+                let line_rtl = match self.runs.natural() {
+                    true => text[a..b]
+                        .iter()
+                        .find_map(|&ch| match BidiProps::of(ch).class {
+                            BidiClass::L => Some(false),
+                            BidiClass::R | BidiClass::AL => Some(true),
+                            _ => None,
+                        })
+                        .unwrap_or(prtl),
+                    false => prtl,
+                };
+                if self.order_line(a..b).is_none() {
+                    continue;
+                }
+                let mut lv = core::mem::take(&mut self.levels);
+                // Own edge: a line whose direction is not the paragraph's
+                // is ordered in its own direction, as a paragraph alone.
+                if line_rtl != prtl {
+                    let sb = solo.get_or_insert_with(|| Box::new(Bidi::new()));
+                    let d = if line_rtl { BidiParagraph::Rtl } else { BidiParagraph::Ltr };
+                    if sb.resolve(&text[a..b], d).is_ok() {
+                        let mut piece = vec![0u16; b - a];
+                        if let Ok(l) = sb.reorder(0..b - a, &mut piece) {
+                            lv = l.to_vec();
+                            self.order = piece.iter().map(|&o| o + a as u16).collect();
+                        }
+                    }
+                }
+                let mut vis: Vec<PackedCell> = Vec::new();
+                let mut vl: Vec<BidiLevel> = Vec::new();
+                let mut from: Vec<Col> = Vec::new();
+                for &t in &self.order {
+                    let t = usize::from(t);
+                    let (r, c, lead, w) = at[t];
+                    if lead != Lead::First {
+                        continue;
+                    }
+                    let l = lv[t - a];
+                    let mut cell = vp.row(Row::from_index(r))[c.index()];
+                    if l.direction() == BidiDirection::Rtl {
+                        if let Mirror::Glyph(m) = mirror(term, cell) {
+                            cell.content = m;
+                            cell.flags = cell.flags.without_cluster();
+                        }
+                    }
+                    vis.push(cell);
+                    vl.push(l);
+                    from.push(c);
+                    if w == 2 {
+                        vis.push(vp.row(Row::from_index(r))[c.index() + 1]);
+                        vl.push(l);
+                        from.push(Col::at_index(c.index() + 1));
+                    }
+                }
+                self.levels = lv;
+                let pad = ncols.saturating_sub(vis.len());
+                let mut cells = Vec::with_capacity(ncols);
+                let mut lev = Vec::with_capacity(ncols);
+                let mut fr = Vec::with_capacity(ncols);
+                if line_rtl {
+                    cells.extend(core::iter::repeat_n(PackedCell::EMPTY, pad));
+                    lev.extend(core::iter::repeat_n(plevel, pad));
+                    fr.extend((0..pad).map(|_| Col::ZERO));
+                }
+                cells.extend(vis);
+                lev.extend(vl);
+                fr.extend(from);
+                if !line_rtl {
+                    cells.extend(core::iter::repeat_n(PackedCell::EMPTY, pad));
+                    lev.extend(core::iter::repeat_n(plevel, pad));
+                    fr.extend((0..pad).map(|_| Col::ZERO));
+                }
+                cells.truncate(ncols);
+                let s0 = at[a];
+                let s1 = at[b - 1];
+                desc.push(format!(
+                    "    line text[{a}..{b}) = stored (row {},col {})..=(row {},col {}) {} {:?}",
+                    s0.0, s0.1.index(), s1.0, s1.1.index(),
+                    if line_rtl { "rtl-edge" } else { "ltr-edge" },
+                    text[a..b].iter().collect::<String>()
+                ));
+                push_line(
+                    cells,
+                    Some(RowOrder { from: fr, to: vec![Col::ZERO; ncols], level: lev, swaps: Vec::new() }),
+                    &mut display,
+                    &mut levels_out,
+                );
+            }
+            // Permutation check: every non-erased stored cell drawn once.
+            let mut want: Vec<(usize, usize)> = Vec::new();
+            for r in first..=last {
+                for (c, cell) in vp.row(Row::from_index(r)).iter().enumerate() {
+                    if !cell.content.is_empty() {
+                        want.push((r, c));
+                    }
+                }
+            }
+            let mut got: Vec<(usize, usize)> = Vec::new();
+            for &(a, b) in &lines {
+                for t in a..b {
+                    let (r, c, lead, w) = at[t];
+                    if lead == Lead::First && text[t] != ERASED {
+                        got.push((r, c.index()));
+                        if w == 2 {
+                            got.push((r, c.index() + 1));
+                        }
+                    }
+                }
+            }
+            want.sort();
+            got.sort();
+            let contiguous = lines.windows(2).all(|w| w[0].1 == w[1].0)
+                && lines.first().is_some_and(|l| l.0 == 0)
+                && lines.last().is_some_and(|l| l.1 == text.len());
+            self.runs_report.push(format!(
+                "  paragraph stored rows {}..={} ({} rows) -> {} display lines; level {}; stretches {:?}; cuts {:?}; raw (no opportunity) cuts {raw}; char breaks {charbreaks}; permutation {}; contiguous {}",
+                first, last, last - first + 1, lines.len(), plevel.number(), stretches, cuts,
+                if want == got { "ok" } else { "MISMATCH" }, contiguous
+            ));
+            self.runs_report.extend(desc);
+            rebroken_any = true;
+        }
+        self.runs_report.push(format!("  window rows {nrows}; display rows used {}; dropped past the window {dropped}", levels_out.len()));
+        if !rebroken_any {
+            return;
+        }
+        while levels_out.len() < nrows {
+            display.extend(core::iter::repeat_n(PackedCell::EMPTY, ncols));
+            levels_out.push(None);
+        }
+        self.orders.rows = levels_out;
+        self.orders.display = Some(display);
+        self.orders.any = Any::Yes;
+    }
+}
