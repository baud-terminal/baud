@@ -0,0 +1,30 @@
+//! Scratch prototype (bidi-wrap/owner-runs), never shipped: the owner's
+//! 2026-10-24 idea, a soft-wrapped paragraph that mixes directions drawn
+//! with each foreign-direction run on display lines of its own.
+
+/// Which runs get lines of their own, and where a display line's padding
+/// goes.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Mode {
+    /// Today's layout (W1).
+    Off,
+    /// Every foreign run; every display line against the paragraph's edge
+    /// (per-line UAX #9).
+    AllParagraphEdge,
+    /// Every foreign run; each display line against its own first strong
+    /// letter's edge.
+    AllNaturalEdge,
+    /// Only a foreign run the wrap splits; the paragraph's edge.
+    CrossingParagraphEdge,
+    /// Only a foreign run the wrap splits; each line's own edge.
+    CrossingNaturalEdge,
+}
+
+impl Mode {
+    pub fn natural(self) -> bool {
+        matches!(self, Mode::AllNaturalEdge | Mode::CrossingNaturalEdge)
+    }
+    pub fn crossing_only(self) -> bool {
+        matches!(self, Mode::CrossingParagraphEdge | Mode::CrossingNaturalEdge)
+    }
+}
