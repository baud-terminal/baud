+#[cfg(feature = "proto-runs-plus-words")]
+impl Reorder {
+    /// PROTOTYPE: re-lays the paragraph last resolved, `rows`, if it holds
+    /// more than one direction run; answers whether it did.
+    fn proto_relay(
+        &mut self,
+        term: &Term<'_>,
+        rows: &[ParaRow<'_>],
+        _ranges: &[(core::ops::Range<usize>, Col)],
+        level: BidiLevel,
+    ) -> bool {
+        let _ = term;
+        if rows.len() < 2 || rows.iter().any(|r| r.window.is_none()) {
+            return false;
+        }
+        let cols = self.orders.cols.index();
+        let n = self.text.len();
+        let all: Vec<BidiLevel> = self.bidi.levels().to_vec();
+        if all.len() != n {
+            return false;
+        }
+        // Cells as units, in logical order.
+        let mut units: Vec<proto::Unit> = Vec::new();
+        for t in 0..n {
+            if self.owner[t].lead != Lead::First {
+                continue;
+            }
+            if let Some(u) = units.last_mut() {
+                u.end = t;
+            }
+            let own = self.owner[t];
+            let wide = rows[own.row]
+                .cells
+                .get(own.col.index() + 1)
+                .is_some_and(|c| c.content.is_wide_tail());
+            units.push(proto::Unit {
+                start: t,
+                end: n,
+                width: 1 + usize::from(wide),
+                level: all[t],
+            });
+        }
+        let nu = units.len();
+        if nu == 0 {
+            return false;
+        }
+        // The gate, part 1: a letter of the direction opposite the
+        // paragraph's (L in a right-to-left paragraph, R or AL in a
+        // left-to-right one). Digits alone never re-lay a paragraph.
+        let para_rtl = level.direction() == baud_domain::BidiDirection::Rtl;
+        let foreign: Vec<bool> = units
+            .iter()
+            .map(|u| {
+                let c = BidiProps::of(self.text[u.start]).class;
+                match para_rtl {
+                    true => c == baud_domain::BidiClass::L,
+                    false => matches!(c, baud_domain::BidiClass::R | baud_domain::BidiClass::AL),
+                }
+            })
+            .collect();
+        if !foreign.contains(&true) {
+            return false;
+        }
+        // UAX #14 opportunities, before each text position.
+        let mut allow = vec![false; n + 1];
+        baud_domain::line_breaks(&self.text, |i, b| {
+            allow[i] = b != baud_domain::LineBreak::Prohibited;
+        });
+        let allowed = |j: usize| j < nu && allow[units[j].start];
+        // BD7 level runs, each start snapped forward to an opportunity.
+        let starts: Vec<usize> = (1..nu)
+            .filter(|&j| units[j].level != units[j - 1].level)
+            .collect();
+        let mut bounds: Vec<usize> = Vec::new();
+        for (i, &k) in starts.iter().enumerate() {
+            let next = starts.get(i + 1).copied().unwrap_or(nu);
+            match (k..nu).find(|&j| allowed(j)) {
+                Some(j) if j <= next => bounds.push(j),
+                Some(j) => {
+                    self.stats.boundaries_unsnapped += 1;
+                    bounds.push(j);
+                }
+                None => {
+                    if next != nu {
+                        self.stats.boundaries_unsnapped += 1;
+                    }
+                }
+            }
+        }
+        bounds.sort_unstable();
+        bounds.dedup();
+        bounds.retain(|&j| j > 0 && j < nu);
+        if bounds.is_empty() {
+            return false;
+        }
+        let seg_start = |j: usize| -> usize {
+            bounds
+                .iter()
+                .rev()
+                .find(|&&b| b <= j)
+                .copied()
+                .unwrap_or(0)
+        };
+        let seg_end = |j: usize| -> usize { bounds.iter().find(|&&b| b > j).copied().unwrap_or(nu) };
+        // The gate, part 2: the terminal's own wrap (a stored row boundary)
+        // falls strictly inside a segment holding an opposite-direction
+        // letter. Otherwise the paragraph is drawn as stored (W1).
+        let cuts_foreign = (1..nu).any(|j| {
+            self.owner[units[j].start].row != self.owner[units[j - 1].start].row
+                && seg_start(j) < j
+                && foreign[seg_start(j)..seg_end(j)].contains(&true)
+        });
+        if !cuts_foreign {
+            return false;
+        }
+        // Lines, greedily in cells.
+        let mut lines: Vec<(usize, usize)> = Vec::new();
+        let mut s = 0;
+        while s < nu {
+            let (mut e, mut w) = (s, 0);
+            while e < nu && w + units[e].width <= cols {
+                w += units[e].width;
+                e += 1;
+            }
+            if e == nu {
+                lines.push((s, nu));
+                break;
+            }
+            if e == s {
+                e = s + 1;
+            }
+            let b = if bounds.binary_search(&e).is_ok() {
+                e
+            } else {
+                let g = seg_start(e);
+                if g > s {
+                    g
+                } else {
+                    match (s + 1..=e).rev().find(|&j| allowed(j)) {
+                        Some(j) => j,
+                        None => {
+                            self.stats.emergency_breaks += 1;
+                            e
+                        }
+                    }
+                }
+            };
+            lines.push((s, b));
+            s = b;
+        }
+        // Each line ordered on its own (L1-L2).
+        let rtl = level.direction() == baud_domain::BidiDirection::Rtl;
+        let mut laid: Vec<proto::Laid> = Vec::with_capacity(lines.len());
+        for &(a, b) in &lines {
+            let tr = units[a].start..units[b - 1].end;
+            let width: usize = units[a..b].iter().map(|u| u.width).sum();
+            if width > cols {
+                return false;
+            }
+            self.piece.clear();
+            self.piece.resize(tr.len(), 0);
+            let Ok(lv) = self.bidi.reorder(tr.clone(), &mut self.piece) else {
+                return false;
+            };
+            let lv = lv.to_vec();
+            let mut o = RowOrder {
+                from: Vec::with_capacity(cols),
+                to: vec![Col::ZERO; cols],
+                level: Vec::with_capacity(cols),
+                swaps: Vec::new(),
+            };
+            let mut src: Vec<Option<Row>> = Vec::with_capacity(cols);
+            let pad = cols - width;
+            if rtl {
+                for _ in 0..pad {
+                    o.from.push(Col::ZERO);
+                    o.level.push(level);
+                    src.push(None);
+                }
+            }
+            for &t in &self.piece {
+                let t = usize::from(t);
+                let own = self.owner[t];
+                if own.lead != Lead::First {
+                    continue;
+                }
+                let l = lv[t - tr.start];
+                let row = &rows[own.row];
+                let y = row.window;
+                o.from.push(own.col);
+                o.level.push(l);
+                src.push(y);
+                if l.direction() == baud_domain::BidiDirection::Rtl {
+                    match mirror(term, row.cells[own.col.index()]) {
+                        Mirror::Glyph(m) => o.swaps.push((Col::at_index(o.from.len() - 1), m)),
+                        Mirror::Missing => self.unmirrored.bump(),
+                        Mirror::Not => {}
+                    }
+                }
+                if row
+                    .cells
+                    .get(own.col.index() + 1)
+                    .is_some_and(|c| c.content.is_wide_tail())
+                {
+                    o.from.push(Col::at_index(own.col.index() + 1));
+                    o.level.push(l);
+                    src.push(y);
+                }
+            }
+            if !rtl {
+                for _ in 0..pad {
+                    o.from.push(Col::ZERO);
+                    o.level.push(level);
+                    src.push(None);
+                }
+            }
+            if o.from.len() != cols {
+                return false;
+            }
+            laid.push(proto::Laid { order: o, src });
+        }
+        let (Some(first), Some(last)) = (
+            rows.first().and_then(|r| r.window),
+            rows.last().and_then(|r| r.window),
+        ) else {
+            return false;
+        };
+        self.stats.paragraphs_relaid += 1;
+        self.stats.stored_rows += rows.len();
+        self.stats.display_rows += laid.len();
+        self.relaid.push((first, last, laid));
+        true
+    }
+
+    /// PROTOTYPE: the window's display rows, re-laid paragraphs in place of
+    /// their stored rows, the rest pushed down; the bottom dropped.
+    fn proto_finish(&mut self, nrows: usize) {
+        if self.relaid.is_empty() {
+            return;
+        }
+        let relaid = core::mem::take(&mut self.relaid);
+        let old = core::mem::take(&mut self.orders.rows);
+        let mut rows: Vec<Option<RowOrder>> = Vec::with_capacity(nrows);
+        let mut disp: Vec<proto::Disp> = Vec::with_capacity(nrows);
+        let (mut y, mut k) = (0, 0);
+        while y < nrows {
+            if let Some((first, last, laid)) = relaid.get(k).filter(|p| p.0.index() == y) {
+                let _ = first;
+                for l in laid {
+                    rows.push(Some(l.order.clone()));
+                    disp.push(proto::Disp::Laid(l.src.clone()));
+                }
+                y = last.index() + 1;
+                k += 1;
+            } else {
+                rows.push(old.get(y).cloned().flatten());
+                disp.push(proto::Disp::Stored(Row::from_index(y)));
+                y += 1;
+            }
+        }
+        self.stats.dropped_rows = rows.len().saturating_sub(nrows);
+        rows.truncate(nrows);
+        disp.truncate(nrows);
+        while rows.len() < nrows {
+            rows.push(None);
+            disp.push(proto::Disp::Blank);
+        }
+        self.orders.rows = rows;
+        self.orders.display = Some(disp);
+        self.orders.any = Any::Yes;
+    }
+
+    /// PROTOTYPE: the last layout's counts.
+    pub fn proto_stats(&self) -> proto::Stats {
+        self.stats
+    }
+}
