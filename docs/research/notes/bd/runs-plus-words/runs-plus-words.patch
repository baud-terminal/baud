+/// **PROTOTYPE, never shipped: "runs-plus-words".** A soft-wrapped
+/// paragraph holding more than one direction run is re-broken for display:
+/// the paragraph's levels are resolved whole (unchanged), its BD7 level
+/// runs are snapped forward to the next UAX #14 break opportunity
+/// (`baud_domain::line_breaks`), and lines are filled greedily in cells;
+/// where the fill would cut a run that began on the line, the run starts
+/// the next line instead, and inside a run that began at or before the
+/// line's start the line ends at the last opportunity (else at the cell,
+/// UAX #14's emergency mode). Each display line is then ordered by L1-L2
+/// on its own (UAX #9 3.4: break, then reorder). A paragraph with one run
+/// is left exactly as stored. Display rows past the window are dropped
+/// from the bottom (top anchored).
+#[cfg(feature = "proto-runs-plus-words")]
+pub mod proto {
+    use super::*;
+
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub(crate) enum Disp {
+        Stored(Row),
+        Laid(Vec<Option<Row>>),
+        Blank,
+    }
+
+    #[derive(Clone, Debug, PartialEq, Eq)]
+    pub(crate) struct Laid {
+        pub(super) order: RowOrder,
+        pub(super) src: Vec<Option<Row>>,
+    }
+
+    /// Per-layout counts.
+    #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+    pub struct Stats {
+        pub paragraphs_relaid: usize,
+        pub stored_rows: usize,
+        pub display_rows: usize,
+        pub boundaries_unsnapped: usize,
+        pub emergency_breaks: usize,
+        pub dropped_rows: usize,
+    }
+
+    pub(super) struct Unit {
+        pub start: usize,
+        pub end: usize,
+        pub width: usize,
+        pub level: BidiLevel,
+    }
+}
+
+#[cfg(feature = "proto-runs-plus-words")]
+impl Orders {
+    /// PROTOTYPE: display row `d`'s cells into `out`.
+    pub fn permute_display(&self, d: Row, vp: &Viewport<'_>, out: &mut [PackedCell]) {
+        let Some(disp) = &self.display else {
+            return self.permute(d, vp.row(d), out);
+        };
+        match disp.get(d.index()) {
+            Some(proto::Disp::Stored(y)) => self.permute(d, vp.row(*y), out),
+            Some(proto::Disp::Laid(src)) => {
+                let Some(o) = self.row(d) else {
+                    out.fill(PackedCell::EMPTY);
+                    return;
+                };
+                for (v, dst) in out.iter_mut().enumerate() {
+                    *dst = match (src.get(v).copied().flatten(), o.from.get(v)) {
+                        (Some(y), Some(c)) => {
+                            vp.row(y).get(c.index()).copied().unwrap_or(PackedCell::EMPTY)
+                        }
+                        _ => PackedCell::EMPTY,
+                    };
+                }
+                for &(v, content) in &o.swaps {
+                    if let Some(dst) = out.get_mut(v.index()) {
+                        dst.content = content;
+                        dst.flags = dst.flags.without_cluster();
+                    }
+                }
+            }
+            Some(proto::Disp::Blank) | None => out.fill(PackedCell::EMPTY),
+        }
+    }
+
+    /// PROTOTYPE: the stored row display row `d` takes its rendition from.
+    pub fn display_stored(&self, d: Row) -> Option<Row> {
+        match &self.display {
+            None => Some(d),
+            Some(disp) => match disp.get(d.index()) {
+                Some(proto::Disp::Stored(y)) => Some(*y),
+                Some(proto::Disp::Laid(src)) => src.iter().flatten().next().copied(),
+                _ => None,
+            },
+        }
+    }
+
+    /// PROTOTYPE: every display row's cells as stored `(row, col)`, `None`
+    /// for padding, for the bijection check. `None` when nothing is re-laid.
+    pub fn display_cells(&self) -> Option<Vec<Vec<Option<(Row, Col)>>>> {
+        let disp = self.display.as_ref()?;
+        let cols = self.cols.index();
+        Some(
+            disp.iter()
+                .enumerate()
+                .map(|(d, k)| match k {
+                    proto::Disp::Stored(y) => (0..cols)
+                        .map(|v| {
+                            let c = self
+                                .row(Row::from_index(d))
+                                .and_then(|o| o.from.get(v).copied())
+                                .unwrap_or(Col::at_index(v));
+                            Some((*y, c))
+                        })
+                        .collect(),
+                    proto::Disp::Laid(src) => {
+                        let o = self.row(Row::from_index(d));
+                        (0..cols)
+                            .map(|v| {
+                                let c = o.and_then(|o| o.from.get(v).copied())?;
+                                src.get(v).copied().flatten().map(|y| (y, c))
+                            })
+                            .collect()
+                    }
+                    proto::Disp::Blank => vec![None; cols],
+                })
+                .collect(),
+        )
+    }
+}
