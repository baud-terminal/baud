    ledger: &mut Ledger<M>,[K[11;1H[?12l[?25h[23;70Hn[11;1H[?25l[23;70H[K[H) -> Option<GhostSweep> {
    let (from, to) = match (last, now) {[3;9H(Some(from), Some(to)) if from != to => (from, to),
        _ => return None,[C[K
    };[K
    let band = ghost_band(rect(from), rect(to), cell);
