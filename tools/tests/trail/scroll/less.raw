pub [7mfn[27m ghost_sweep<M: Moment>(
    ledger: &mut Ledger<M>,
    last: Option<(Row, Col)>,
    now: Option<(Row, Col)>,
    at: M,
    rect: impl Fn((Row, Col)) -> Rect,
    (cell, height): ((f32, f32), Points),
) -> Option<GhostSweep> {
    let (from, to) = match (last, now) {
        (Some(from), Some(to)) if from != to => (from, to),
        _ => return None,
    };
    let band = ghost_band(rect(from), rect(to), cell);
    Some(GhostSweep {
        from,
        to,
        strength: ledger.weigh(band, at, height),
    })
}

/// How far a ghost started at `start` has swept at `now`, both seconds on
/// the display link's clock: 1.0 and past once it has landed.
pub [7mfn[27m ghost_progress(start: f64, now: f64) -> f32 {
:[K[K/[K    ((now - start) / GHOST_S) as f32
}

/// **How far a trail rides** for `n` lines the whole screen retired, on a
/// screen of `rows` rows, pixels, y down: up by the lines, and never past the
/// floor one window above the top. Nothing for no lines: a driver sees a
/// read retire none on nearly every read, and a ride of nothing would
/// rebase the move in flight on every tick for no change.
pub [7mfn[27m ride_px(n: Rows, rows: Rows, cell_h: f32) -> Option<(f32, f32)> {
    (n.index() > 0).then(|| {
        (
            -(n.index() as f32 * cell_h),
            -(rows.index() as f32 * cell_h),
        )
    })
}

/// **How far a ghost has ridden the screen's scroll**, pixels, y down: at
/// most [`THRESHOLD`] rows, then it stops riding and finishes its sweep to
/// the cursor -- the quad's rule, where a move past the bound folds in
/// ([`Chase::ride`]).
#[derive(Clone, Copy, PartialEq, Debug)]
:[K[K/[Kpub enum GhostRide {
    Riding(f32),
    Folded,
}

