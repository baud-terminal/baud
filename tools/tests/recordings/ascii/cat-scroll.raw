use crate::*;

/// `[[source: uax29]]` Grapheme_Cluster_Break property values.
///
/// The unit a *user* calls a character. baud stores one [`Codepoint`] per cell,
/// which is a different unit: `U+1F469 U+200D U+1F4BB` is one cluster and one
/// glyph, and four codepoints' worth of columns.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum GraphemeClass {
    Other,
    Cr,
    Lf,
    Control,
    Extend,
    Zwj,
    RegionalIndicator,
    Prepend,
    SpacingMark,
    L,
    V,
    T,
    Lv,
    Lvt,
}

fn lookup(table: &[(u32, u32)], cp: u32) -> bool {
    let (mut lo, mut hi) = (0usize, table.len());
    while lo < hi {
        let mid = (lo + hi) / 2;
        let (a, b) = table[mid];
        if cp < a {
            hi = mid;
        } else if cp > b {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    false
}

impl GraphemeClass {
    pub fn of(c: Codepoint) -> GraphemeClass {
        let cp = c.value();
        // ASCII without a binary search. Measured: the search ran for every
        // byte of ordinary text and cost 12x -- 1102 Mcp/s down to 93 -- on a
        // corpus where the answer is always one of four constants.
        if cp < 0x80 {
            return match cp {
                0x0a => GraphemeClass::Lf,
                0x0d => GraphemeClass::Cr,
                0x00..=0x1f | 0x7f => GraphemeClass::Control,
                _ => GraphemeClass::Other,
            };
        }
        let t = &grapheme_data::BREAK_PROPERTY;
        let (mut lo, mut hi) = (0usize, t.len());
        while lo < hi {
            let mid = (lo + hi) / 2;
            let (a, b, k) = t[mid];
            if cp < a {
                hi = mid;
            } else if cp > b {
                lo = mid + 1;
            } else {
                return k;
            }
        }
        GraphemeClass::Other
    }
}

/// Whether a boundary falls between the codepoints fed so far and the next one.
///
/// A state machine rather than a two-argument predicate, because five of
/// `[[source: uax29]]`'s rules need more context than the immediately preceding
/// codepoint: GB11 looks back through `Extend*` to an `Extended_Pictographic`,
/// GB12/13 need the *parity* of a regional-indicator run, and GB9c needs to
/// know a linker appeared since the last consonant. A pairwise function cannot
/// express any of them, which is the usual reason a naive implementation
/// splits flags and country flags in the wrong places.
/// GB12/13 counts regional indicators **pairwise**, so what matters is the
/// parity of the run, not how many there are.
#[derive(Clone, Copy, PartialEq, Eq, Default)]
enum RiParity {
    #[default]
    Even,
    Odd,
}

/// GB11's lookback: `Extended_Pictographic Extend* ZWJ × Extended_Pictographic`.
///
/// Three states, not two flags. As `{pict_run, pict_zwj}` bools it was possible
/// to spell "in a run *and* zwj seen", which the rule has no meaning for.
#[derive(Clone, Copy, PartialEq, Eq, Default)]
enum PictLookback {
    #[default]
    None,
    /// Inside `Extended_Pictographic Extend*`.
    Pictographic,
    /// The `ZWJ` has arrived; the next pictographic joins.
    PictographicZwj,
}

/// GB9c's lookback:
/// `Consonant [Extend|Linker]* Linker [Extend|Linker]* × Consonant`.
///
/// Three states for the same reason: "linker seen" is only meaningful *inside*
/// a consonant run, and two bools could say otherwise.
#[derive(Clone, Copy, PartialEq, Eq, Default)]
enum IncbLookback {
    #[default]
    None,
    /// A consonant, with only `InCB=Extend`/`Linker` since.
    Consonant,
    /// ...and at least one of those was the linker.
    ConsonantLinker,
}

#[derive(Clone, Copy, Default)]
pub struct ClusterBreak {
    prev: Option<GraphemeClass>,
    ri: RiParity,
    pict: PictLookback,
    incb: IncbLookback,
}

impl ClusterBreak {
    pub fn new() -> ClusterBreak {
        ClusterBreak::default()
    }

    /// Is there a cluster boundary immediately **before** `c`?
    ///
    /// Rule numbers are `[[source: uax29]]`'s, and the order is theirs: the
    /// first matching rule wins, and GB999 ("anything else breaks") is last.
    pub fn is_break(&mut self, c: Codepoint) -> bool {
        let cur = GraphemeClass::of(c);
        let cp = c.value();
        let brk = self.decide(cur, cp);
        self.advance(cur, cp, brk);
        brk
    }

    fn decide(&self, cur: GraphemeClass, cp: u32) -> bool {
        use GraphemeClass::*;
        // GB1: sot ÷ Any -- there *is* a boundary before the first codepoint,
        // which is what the leading `÷` in every conformance case means.
        let Some(prev) = self.prev else {
            return true;
        };
        // GB3: CR × LF
        if prev == Cr && cur == Lf {
            return false;
        }
        // GB4: (Control | CR | LF) ÷
        if matches!(prev, Control | Cr | Lf) {
            return true;
        }
        // GB5: ÷ (Control | CR | LF)
        if matches!(cur, Control | Cr | Lf) {
            return true;
        }
        // GB6/7/8: Hangul syllable sequences.
        if prev == L && matches!(cur, L | V | Lv | Lvt) {
            return false;
        }
        if matches!(prev, Lv | V) && matches!(cur, V | T) {
            return false;
        }
        if matches!(prev, Lvt | T) && cur == T {
            return false;
        }
        // GB9: × (Extend | ZWJ). GB9a: × SpacingMark. GB9b: Prepend ×.
        if matches!(cur, Extend | Zwj) || cur == SpacingMark || prev == Prepend {
            return false;
        }
        // GB9c: an Indic conjunct stays whole.
        if self.incb == IncbLookback::ConsonantLinker && lookup(&grapheme_data::INCB_CONSONANT, cp)
        {
            return false;
        }
        // GB11: ExtPict Extend* ZWJ × ExtPict
        if self.pict == PictLookback::PictographicZwj
            && lookup(&grapheme_data::EXTENDED_PICTOGRAPHIC, cp)
        {
            return false;
        }
        // GB12/13: RI × RI, pairwise.
        if cur == RegionalIndicator && self.ri == RiParity::Odd {
            return false;
        }
        // GB999: Any ÷ Any
        true
    }

    fn advance(&mut self, cur: GraphemeClass, cp: u32, brk: bool) {
        use GraphemeClass::*;
        self.prev = Some(cur);

        // The four lookback tables start at U+00A9, U+0300, U+0915 and U+094D,
        // so nothing below U+00A9 can be in any of them. Without this guard
        // every codepoint paid four binary searches to learn it was not an
        // emoji, a virama or an Indic consonant. Measured: ASCII segmentation
        // went from 93 to 338 Mcp/s with this and the class fast path.
        if cp < 0xa9 {
            self.ri = RiParity::Even;
            self.pict = PictLookback::None;
            self.incb = IncbLookback::None;
            return;
        }

        // **Above the guard, every codepoint paid two binary searches to learn
        // it is neither an emoji nor an Indic consonant.** `LOOKBACK_BLOCKS`
        // is one bit per 32 codepoints, set when the block holds any entry of
        // the four lookback tables; 391 of 34,816 are set, so 98.9% of the
        // space answers here. btop draws with `U+2500..U+257F` and profiled at
        // 12-13% in `is_break`.
        //
        // 32 codepoints a bit and not 256, because `U+25xx` holds box drawing
        // *and* emoji -- `U+25AA`, `U+25B6`, `U+25FB..FE` -- so a wider block
        // cannot separate them.
        let blk = (cp >> 5) as usize;
        let listed = grapheme_data::LOOKBACK_BLOCKS
            .get(blk / 64)
            .is_some_and(|w| w & (1u64 << (blk % 64)) != 0);
        if !listed {
            // Exactly what the four searches below would have concluded: not
            // pictographic, not a consonant, not a linker, not an extend. The
            // `in_run` arms survive because they do not depend on a lookup.
            self.ri = if cur == RegionalIndicator && brk {
                RiParity::Odd
            } else {
                RiParity::Even
            };
            let in_run = self.pict == PictLookback::Pictographic;
            self.pict = if in_run && cur == Extend {
                PictLookback::Pictographic
            } else if in_run && cur == Zwj {
                PictLookback::PictographicZwj
            } else {
                PictLookback::None
            };
            self.incb = IncbLookback::None;
            return;
        }

        // A boundary resets the parity, so a third indicator starts a new pair
        // rather than extending the flag before it.
        // An indicator that *paired* (no boundary before it) closes the pair
        // and leaves the parity even, so a third starts a fresh one. Both arms
        // returning `Odd` is what broke `RI RI RI`: the third indicator joined
        // the flag before it instead of beginning the next.
        self.ri = if cur == RegionalIndicator && brk {
            RiParity::Odd
        } else {
            RiParity::Even
        };

        let in_run = self.pict == PictLookback::Pictographic;
        self.pict =
            if lookup(&grapheme_data::EXTENDED_PICTOGRAPHIC, cp) || (in_run && cur == Extend) {
                // `Extend` does not end the run: GB11 looks back *through* it.
                PictLookback::Pictographic
            } else if in_run && cur == Zwj {
                PictLookback::PictographicZwj
            } else {
                PictLookback::None
            };

        self.incb = if lookup(&grapheme_data::INCB_CONSONANT, cp) {
            IncbLookback::Consonant
        } else if self.incb == IncbLookback::None {
            IncbLookback::None
        } else if lookup(&grapheme_data::INCB_LINKER, cp) {
            IncbLookback::ConsonantLinker
        } else if lookup(&grapheme_data::INCB_EXTEND, cp) {
            self.incb
        } else {
            IncbLookback::None
        };
    }
}
use crate::*;

/// A grid indexed by [`Row`] and [`Col`], never by an integer.
///
/// This is what removes `as_index` from call sites: you cannot index it with a
/// `usize`, and you cannot index it with a `Row` where a `Col` belongs. The
/// conversion happens once, inside `Index`, instead of everywhere.
pub struct Grid<'buf, T> {
    cells: &'buf mut [T],
    stride: Cols,
    rows: Rows,
}

impl<'buf, T> Grid<'buf, T> {
    pub fn new(cells: &'buf mut [T], stride: Cols, rows: Rows) -> Grid<'buf, T> {
        Grid {
            cells,
            stride,
            rows,
        }
    }
    pub fn rows(&self) -> Rows {
        self.rows
    }
    pub fn stride(&self) -> Cols {
        self.stride
    }
}

impl<'buf, T> core::ops::Index<Row> for Grid<'buf, T> {
    type Output = [T];
    fn index(&self, r: Row) -> &[T] {
        let a = r.0 * self.stride.0;
        &self.cells[a..a + self.stride.0]
    }
}

impl<'buf, T> core::ops::IndexMut<Row> for Grid<'buf, T> {
    fn index_mut(&mut self, r: Row) -> &mut [T] {
        let a = r.0 * self.stride.0;
        &mut self.cells[a..a + self.stride.0]
    }
}

/// A single cell, addressed by both axes. `grid[(row, col)]`.
impl<'buf, T> core::ops::Index<(Row, Col)> for Grid<'buf, T> {
    type Output = T;
    fn index(&self, (r, c): (Row, Col)) -> &T {
        &self.cells[r.0 * self.stride.0 + c.0]
    }
}

impl<'buf, T> core::ops::IndexMut<(Row, Col)> for Grid<'buf, T> {
    fn index_mut(&mut self, (r, c): (Row, Col)) -> &mut T {
        &mut self.cells[r.0 * self.stride.0 + c.0]
    }
}

/// A ring of per-line records, indexed by [`LineIdx`] with the wrap built in.
pub struct LineRing<'buf, T> {
    slots: &'buf mut [T],
}

impl<'buf, T> LineRing<'buf, T> {
    pub fn new(slots: &'buf mut [T]) -> LineRing<'buf, T> {
        LineRing { slots }
    }
}

impl<'buf, T> core::ops::Index<LineIdx> for LineRing<'buf, T> {
    type Output = T;
    fn index(&self, l: LineIdx) -> &T {
        &self.slots[(l.0 as usize) % self.slots.len()]
    }
}

impl<'buf, T> core::ops::IndexMut<LineIdx> for LineRing<'buf, T> {
    fn index_mut(&mut self, l: LineIdx) -> &mut T {
        let n = self.slots.len();
        &mut self.slots[(l.0 as usize) % n]
    }
}

/// The arena, indexed by [`SlotIdx`] with the wrap built in.
pub struct SlotRing<'buf> {
    bytes: &'buf mut [u8],
}

impl<'buf> SlotRing<'buf> {
    pub fn new(bytes: &'buf mut [u8]) -> SlotRing<'buf> {
        SlotRing { bytes }
    }
}

impl<'buf> core::ops::Index<SlotIdx> for SlotRing<'buf> {
    type Output = [u8; SLOT_BYTES];
    fn index(&self, s: SlotIdx) -> &[u8; SLOT_BYTES] {
        let a = s.0 as usize * SLOT_BYTES;
        self.bytes[a..a + SLOT_BYTES].try_into().unwrap()
    }
}

impl<'buf> core::ops::IndexMut<SlotIdx> for SlotRing<'buf> {
    fn index_mut(&mut self, s: SlotIdx) -> &mut [u8; SLOT_BYTES] {
        let a = s.0 as usize * SLOT_BYTES;
        (&mut self.bytes[a..a + SLOT_BYTES]).try_into().unwrap()
    }
}

/// Read-only counterpart of [`View`].
/// Rows the grid is rotated by: screen row `y` lives at physical row
/// `(y + rot) % rows`.
///
/// **This is what makes a full-screen scroll O(1).** Scrolling used to advance
/// `head`, which indexes the run table, and leave the cells alone -- so
/// `Computed` and `Templated` never scrolled. Copying the grid instead was
/// correct and cost 45% of cell ingest, because a streaming payload scrolls
/// every screenful: write amplification around 20:1 against the rule that it
/// stays at or below 1. Rotating an index costs neither.
#[derive(Clone, Copy, PartialEq, Eq, Default, Debug)]
pub struct RowRot(pub(crate) usize);

impl RowRot {
    pub const NONE: RowRot = RowRot(0);
    pub fn advance(self, n: usize, rows: Rows) -> RowRot {
        RowRot((self.0 + n) % rows.index().max(1))
    }
    pub fn index(self) -> usize {
        self.0
    }
}

pub struct ViewRef<'a> {
    cells: &'a [PackedCell],
    stride: Cols,
    cols: Cols,
    rows: Rows,
    rot: RowRot,
}

impl<'a> ViewRef<'a> {
    fn phys(&self, r: Row) -> usize {
        let rows = self.rows.index();
        let y = r.index() + self.rot.index();
        if y >= rows { y - rows } else { y }
    }
    pub fn row_slice(&self, r: Row) -> &'a [PackedCell] {
        let a = self.phys(r) * self.stride.index();
        &self.cells[a..a + self.cols.index()]
    }
    pub fn get(&self, r: Row, c: Col) -> PackedCell {
        if r.index() < self.rows.index() && c.index() < self.cols.index() {
            self.cells[self.phys(r) * self.stride.index() + c.index()]
        } else {
            PackedCell::EMPTY
        }
    }
}

/// A viewport laid out over a caller-owned cell array, addressed by axis.
///
/// The 26 occurrences of `y * MAX_COLS + x` this replaces were 26 chances to
/// transpose the axes or forget the clamp. Here the arithmetic happens once.
pub struct View<'a> {
    cells: &'a mut [PackedCell],
    stride: Cols,
    cols: Cols,
    rows: Rows,
    rot: RowRot,
}

impl<'a> View<'a> {
    /// Read-only view. Same addressing, no mutation.
    pub fn new_ref(
        cells: &'a [PackedCell],
        stride: Cols,
        cols: Cols,
        rows: Rows,
        rot: RowRot,
    ) -> ViewRef<'a> {
        ViewRef {
            cells,
            stride,
            cols,
            rows,
            rot,
        }
    }
    pub fn new(
        cells: &'a mut [PackedCell],
        stride: Cols,
        cols: Cols,
        rows: Rows,
        rot: RowRot,
    ) -> View<'a> {
        View {
            cells,
            stride,
            cols,
            rows,
            rot,
        }
    }
    pub fn cols(&self) -> Cols {
        self.cols
    }
    pub fn rows(&self) -> Rows {
        self.rows
    }
    pub fn set_geometry(&mut self, cols: Cols, rows: Rows) {
        self.cols = cols;
        self.rows = rows;
    }

    /// Screen row to physical offset, through the rotation. Every addressing
    /// path goes here, which is what makes the rotation one line rather than
    /// twenty-six chances to forget it.
    #[inline(always)]
    pub(crate) fn phys(&self, r: Row) -> usize {
        // A conditional subtract, not `%`. Both operands are below `rows`, so
        // the sum is below `2 * rows` and one subtraction is enough. The
        // modulo cost ~16% of the cells path -- it sits on the addressing path
        // that `put_ascii_run` reaches once per run and `put` once per cell.
        let rows = self.rows.index();
        let y = r.index() + self.rot.index();
        if y >= rows { y - rows } else { y }
    }

    #[inline(always)]
    pub(crate) fn at(&self, r: Row, c: Col) -> usize {
        self.phys(r) * self.stride.index() + c.index()
    }

    #[inline(always)]
    pub fn put(&mut self, r: Row, c: Col, cell: PackedCell) {
        if r.index() < self.rows.index() && c.index() < self.cols.index() {
            let i = self.at(r, c);
            self.cells[i] = cell;
        }
    }
    #[inline(always)]
    pub fn get(&self, r: Row, c: Col) -> PackedCell {
        if r.index() < self.rows.index() && c.index() < self.cols.index() {
            self.cells[self.at(r, c)]
        } else {
            PackedCell::EMPTY
        }
    }
    /// Write a run of printable ASCII into one row, starting at `at`.
    ///
    /// Bulk rather than per-cell: the bounds check and the row base are
    /// computed once. Doing it per cell cost ~25% of ingest throughput, which
    /// was a refactoring mistake rather than anything to do with the types.
    ///
    /// The indexed loop stays. Clippy asks for `src.iter().enumerate()`, which is
    /// a codegen change on the measured ingest path — and the note above is the
    /// measurement that says this loop's shape is worth 25%. Changing it needs a
    /// benchmark, not a lint fix.
    #[allow(clippy::needless_range_loop)]
    pub fn put_ascii_run(
        &mut self,
        r: Row,
        at: Col,
        src: &[u8],
        style: StyleId,
        flags: CellFlags,
        set: Charset,
    ) {
        if r.index() >= self.rows.index() {
            return;
        }
        let base = self.at(r, Col::ZERO);
        let start = at.index();
        let n = src.len().min(self.cols.index().saturating_sub(start));
        // Two loops, and the duplication is the point.
        //
        // Threading `flags` as a *runtime* value into the per-cell store cost
        // 5% of the cells path -- 1049.5 MB/s against 1104.2 for the same build
        // with a constant, ranges not overlapping. With `CellFlags::NONE`
        // spelled as a literal the compiler folds the whole non-content half
        // into an immediate and the loop goes back to what it was: the same
        // build measured 1127.0 [1106.1-1135.9].
        //
        // DECSCA is rare -- essentially no application sets it -- so the branch
        // is hoisted out of the loop and the cost falls on the programs that
        // actually ask for protection. Same shape as the AutoWrap hoist in
        // `baud-core`, and for the same measured reason.
        // The charset is tested *first*. `flags == NONE` was, and a national
        // set sets no flag -- only the line-drawing set has one -- so UK and
        // German text took the ASCII fast path and was never translated. The
        // graphics set worked only because `refresh_flags` gives it a flag.
        if set != Charset::Ascii {
            let proto = PackedCell {
                content: Content::EMPTY,
                style,
                flags,
            };
            for (d, &b) in self.cells[base + start..base + start + n]
                .iter_mut()
                .zip(&src[..n])
            {
                *d = proto.with_charset(StreamByte::from_stream(b), set);
            }
        } else if flags == CellFlags::NONE {
            let proto = PackedCell {
                content: Content::EMPTY,
                style,
                flags: CellFlags::NONE,
            };
            Self::put_ascii_vectored(
                &mut self.cells[base + start..base + start + n],
                &src[..n],
                proto,
            );
        } else {
            let proto = PackedCell {
                content: Content::EMPTY,
                style,
                flags,
            };
            for (d, &b) in self.cells[base + start..base + start + n]
                .iter_mut()
                .zip(&src[..n])
            {
                *d = proto.with_ascii(StreamByte::from_stream(b));
            }
        }
    }

    /// Write one cell per source byte, eight at a time.
    ///
    /// **Why this is not `slice::fill` and not a plain loop.** `fill` writes one
    /// repeated value and lowers to a vector store; this writes a *different*
    /// content per cell, so it was a scalar loop -- `otool -tv` on the release
    /// binary showed `ldr`/`str`/`orr` and **no vector register at all**. On the
    /// streaming payload that loop writes 27% of the cells and takes 33% of the
    /// cells-path profile, where `fill` writes the other 73% in 17%: about 5.3x
    /// the cost per cell for the same eight bytes.
    ///
    /// Only the content differs between cells in a run -- style and flags are
    /// fixed -- so under `repr(C)` on a little-endian target a cell is
    /// `(style, flags) << 32 | content`, and eight of them are one `u64x8` OR and
    /// one 64-byte store.
    ///
    /// No `unsafe`: `baud-domain` forbids it, so the reinterpretation goes through
    /// `zerocopy`, which `PackedCell` already derives for the shm and disk paths.
    fn put_ascii_vectored(dst: &mut [PackedCell], src: &[u8], proto: PackedCell) {
        #[cfg(target_endian = "little")]
        {
            use core::simd::Simd;
            use core::simd::num::SimdUint;
            // `PackedCell` already derives these for the shm and disk paths;
            // here they are what makes the reinterpretation possible without
            // `unsafe`, which this crate forbids.
            use zerocopy::{FromBytes, IntoBytes};

            // The high half is style and flags; masking the low half off discards
            // `Content::EMPTY`, which is a reserved value rather than zero.
            let mut bytes = [0u8; 8];
            bytes.copy_from_slice(proto.as_bytes());
            let hi = u64::from_ne_bytes(bytes) & 0xffff_ffff_0000_0000;

            let mut d = dst.chunks_exact_mut(8);
            let mut s = src.chunks_exact(8);
            for (dc, sc) in d.by_ref().zip(s.by_ref()) {
                let content = Simd::<u8, 8>::from_slice(sc).cast::<u64>();
                let cells = (content | Simd::splat(hi)).to_array();
                let packed = <[PackedCell; 8]>::read_from_bytes(cells.as_bytes())
                    .expect("eight u64 is sixty-four bytes, which is eight cells");
                dc.copy_from_slice(&packed);
            }
            // A run averages ~32 bytes, so the tail is not rare and is not free.
            for (dc, &b) in d.into_remainder().iter_mut().zip(s.remainder()) {
                *dc = proto.with_ascii(StreamByte::from_stream(b));
            }
        }
        #[cfg(not(target_endian = "little"))]
        for (dc, &b) in dst.iter_mut().zip(src) {
            *dc = proto.with_ascii(StreamByte::from_stream(b));
        }
    }

    /// Fill a half-open column span of one row. Clamped to the visible width.
    pub fn fill(&mut self, r: Row, from: Col, to: Col, cell: PackedCell) {
        let (a, b) = (from.index(), to.index().min(self.cols.index()));
        if r.index() >= self.rows.index() || a >= b {
            return;
        }
        let base = self.at(r, Col::ZERO);
        // `slice::fill`, not an indexed loop: one bounds check instead of one
        // per cell, and it lowers to a vector store rather than a scalar one.
        self.cells[base + a..base + b].fill(cell);
    }
    pub fn fill_row(&mut self, r: Row, cell: PackedCell) {
        self.fill(r, Col::ZERO, Col::at_index(self.cols.index()), cell);
    }
    /// Shift a row's cells left by `n`, blanking the tail. `CSI P`.
    pub fn delete_chars(&mut self, r: Row, at: Col, n: Count, blank: PackedCell) {
        let cols = self.cols.index();
        let (cx, n) = (at.index(), (n.get_raw() as usize).min(cols - at.index()));
        let base = self.at(r, Col::ZERO);
        for x in cx..cols - n {
            self.cells[base + x] = self.cells[base + x + n];
        }
        for x in cols - n..cols {
            self.cells[base + x] = blank;
        }
    }
    /// Shift right, inserting blanks. `CSI @`.
    pub fn insert_blanks(&mut self, r: Row, at: Col, n: Count, blank: PackedCell) {
        let cols = self.cols.index();
        let (cx, n) = (at.index(), (n.get_raw() as usize).min(cols - at.index()));
        let base = self.at(r, Col::ZERO);
        let mut x = cols;
        while x > cx + n {
            x -= 1;
            self.cells[base + x] = self.cells[base + x - n];
        }
        for x in cx..cx + n {
            self.cells[base + x] = blank;
        }
    }
    /// Shift left within `[at, right)`, filling at the right edge. `CSI P` with
    /// a right margin, and the engine of DECDC.
    ///
    /// The bounded twin of [`Grid::delete_chars`], for the same reason
    /// [`Grid::delete_lines_in`] is the bounded twin of the row version: with
    /// DECSLRM set, a delete must not pull text in from beyond the right
    /// margin, because that text is outside the scrolling region and is not
    /// supposed to move.
    pub fn delete_cells(&mut self, r: Row, at: Col, n: Count, right: Col, blank: PackedCell) {
        let end = right.index().min(self.cols.index());
        let cx = at.index();
        if cx >= end {
            return;
        }
        let n = (n.get_raw() as usize).min(end - cx);
        let base = self.at(r, Col::ZERO);
        for x in cx..end - n {
            self.cells[base + x] = self.cells[base + x + n];
        }
        for x in end - n..end {
            self.cells[base + x] = blank;
        }
    }

    /// Shift right within `[at, right)`, inserting blanks. `CSI @` with a right
    /// margin, and the engine of DECIC.
    pub fn insert_cells(&mut self, r: Row, at: Col, n: Count, right: Col, blank: PackedCell) {
        let end = right.index().min(self.cols.index());
        let cx = at.index();
        if cx >= end {
            return;
        }
        let n = (n.get_raw() as usize).min(end - cx);
        let base = self.at(r, Col::ZERO);
        let mut x = end;
        while x > cx + n {
            x -= 1;
            self.cells[base + x] = self.cells[base + x - n];
        }
        for x in cx..cx + n {
            self.cells[base + x] = blank;
        }
    }

    /// Scroll rows down from `at`, blanking the opened region. `CSI L`.
    ///
    /// Bounded by the last row of the screen. `CSI L` inside a scrolling region
    /// must stop at the region's bottom instead -- see [`Grid::insert_lines_in`].
    pub fn insert_lines(&mut self, at: Row, n: Count, blank: PackedCell) {
        let last = Row::from_index(self.rows.index() - 1);
        self.insert_lines_in(at, n, last, blank);
    }

    /// Scroll rows down from `at`, stopping at `bottom` inclusive.
    ///
    /// Rows below `bottom` are outside the scrolling region and must not move:
    /// ECMA-48 defines IL as operating within the region when the cursor is
    /// inside it, and DECSTBM is what makes the region smaller than the screen
    /// `[[source: ecma48]]` § 8.3.67. Content scrolled past `bottom` is
    /// discarded rather than pushed off the screen.
    pub fn insert_lines_in(&mut self, at: Row, n: Count, bottom: Row, blank: PackedCell) {
        let (cy, bot) = (at.index(), bottom.index().min(self.rows.index() - 1));
        if cy > bot {
            return;
        }
        let n = (n.get_raw() as usize).min(bot + 1 - cy);
        let (s, cols) = (self.stride.index(), self.cols.index());
        let mut y = bot + 1;
        while y > cy + n {
            y -= 1;
            for x in 0..cols {
                self.cells[self.phys(Row::from_index(y)) * s + x] =
                    self.cells[self.phys(Row::from_index(y - n)) * s + x];
            }
        }
        for y in cy..cy + n {
            for x in 0..cols {
                self.cells[self.phys(Row::from_index(y)) * s + x] = blank;
            }
        }
    }

    /// Scroll rows up from `at`, stopping at `bottom` inclusive, blanking the
    /// rows exposed at the bottom. `CSI M` (DL), and the engine of SU and of a
    /// line feed on the last row of a scrolling region.
    pub fn delete_lines_in(&mut self, at: Row, n: Count, bottom: Row, blank: PackedCell) {
        let (cy, bot) = (at.index(), bottom.index().min(self.rows.index() - 1));
        if cy > bot {
            return;
        }
        let n = (n.get_raw() as usize).min(bot + 1 - cy);
        let (s, cols) = (self.stride.index(), self.cols.index());
        // `cy..(bot + 1 - n)`, not `cy..=(bot - n)`: with n saturated to the
        // region height, `bot - n` underflows when the whole region is deleted
        // (n == bot + 1, cy == 0). The half-open form is empty in that case
        // instead of panicking, which is what DL with a huge count must do.
        // `copy_within` per row, not a cell at a time. Rows are strided, so the
        // block is not contiguous and one memmove cannot do it -- but each row
        // is, and a scalar loop over 10,000 cells is what made the correct
        // full-screen scroll cost a third of cell ingest.
        for y in cy..bot + 1 - n {
            let (src, dst) = (
                self.phys(Row::from_index(y + n)) * s,
                self.phys(Row::from_index(y)) * s,
            );
            self.cells.copy_within(src..src + cols, dst);
        }
        for y in bot + 1 - n..=bot {
            let a = self.phys(Row::from_index(y)) * s;
            self.cells[a..a + cols].fill(blank);
        }
    }
    pub fn row_slice(&self, r: Row) -> &[PackedCell] {
        let a = self.at(r, Col::ZERO);
        &self.cells[a..a + self.cols.index()]
    }
}
//! What baud **sends**: keys, and the modifiers held with them.
//!
//! The receive side had one specification to enumerate against. This side has
//! three layers -- the base every terminal implements, `[[source: fixterms]]`'s
//! `CSI key ; mods u`, and `[[source: kitty-keyboard]]`'s progressive
//! enhancement over that -- and `docs/input-coverage.md` is the enumeration.
//! These are the types the layers agree on; the encoding they disagree about
//! comes later.

use crate::*;

/// Which modifiers were held.
///
/// A bitset rather than four `bool` fields, and not only because
/// `baud-domain` is gated at zero of those: the wire form *is* a bitmask.
/// `[[source: ctlseqs]]` line 2565 gives fifteen rows of `Code | Modifiers`
/// and every one of them is `1 + mask` with Shift 1, Alt 2, Control 4 and
/// Meta 8 -- so shift-F5 is `CSI 1 5 ; 2 ~`. Four booleans would have to be
/// folded back into that number at every call site, which is where the folding
/// gets done differently in two places.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq, Default, Debug, PartialOrd, Ord)]
pub struct Modifiers(u8);

impl Modifiers {
    pub const NONE: Modifiers = Modifiers(0);
    pub const SHIFT: Modifiers = Modifiers(1);
    pub const ALT: Modifiers = Modifiers(2);
    pub const CTRL: Modifiers = Modifiers(4);
    /// Meta is not Alt, however many keyboards conflate them.
    /// `[[source: ctlseqs]]` reaches codes 9-16 only when `alwaysUseMods` is
    /// set, so a terminal that never sends Meta is not thereby wrong.
    pub const META: Modifiers = Modifiers(8);

    /// Every modifier the wire form can carry, which bounds `wire`.
    pub const ALL: Modifiers = Modifiers(15);

    pub fn with(self, o: Modifiers) -> Modifiers {
        Modifiers(self.0 | o.0)
    }
    pub fn without(self, o: Modifiers) -> Modifiers {
        Modifiers(self.0 & !o.0)
    }
    pub fn has(self, o: Modifiers) -> bool {
        self.0 & o.0 == o.0
    }
    pub fn is_none(self) -> bool {
        self.0 == 0
    }

    /// The parameter xterm appends: `1 + mask`, so `NONE` is 1 and everything
    /// is 2 through 16.
    ///
    /// Emitting it for `NONE` is legal and xterm does not do it -- an
    /// unmodified F5 is `CSI 1 5 ~`, not `CSI 1 5 ; 1 ~` -- so an encoder asks
    /// [`Modifiers::is_none`] first. The value is still defined here rather
    /// than left to the caller, because "1 + mask" written at two call sites
    /// is where one of them becomes "mask".
    pub fn wire(self) -> u8 {
        1 + self.0
    }

    /// The inverse, for reading a sequence back.
    ///
    /// `None` for 0 and for anything past 16: those are not modifier
    /// parameters, and silently clamping them would invent a keypress the
    /// application never made.
    pub fn from_wire(p: u8) -> Option<Modifiers> {
        match p {
            1..=16 => Some(Modifiers(p - 1)),
            _ => None,
        }
    }
}

/// A function key, `F1` through `F20`.
///
/// `[[source: ctlseqs]]` gives twelve in one table and eight more for the
/// VT220, reached on a PC keyboard as Control/F1 upward. One type rather than
/// two because an application cannot tell which table a key came from, and the
/// encoder needs the number.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq, Debug, PartialOrd, Ord)]
pub struct FnKey(u8);

impl FnKey {
    /// `F1` is 1. `None` outside 1..=20, rather than clamping to F20 -- the
    /// wrong function key is worse than none, and this is the same refusal
    /// `DA` makes by under-claiming.
    pub fn new(n: u8) -> Option<FnKey> {
        match n {
            1..=20 => Some(FnKey(n)),
            _ => None,
        }
    }
    pub fn number(self) -> u8 {
        self.0
    }
    /// **`SS3` becomes `CSI` for F1-F4 when a modifier is sent.**
    ///
    /// `[[source: ctlseqs]]` line 2564 calls this out as a special case, and
    /// it is the kind that is easy to miss: unmodified F1 is `SS3 P`, but
    /// shift-F1 is `CSI 1 ; 2 P`. An encoder that appends the modifier without
    /// changing the introducer sends something no application parses.
    pub fn changes_introducer_when_modified(self) -> bool {
        matches!(self.0, 1..=4)
    }
}

/// A key on the numeric keypad.
///
/// **A separate type from [`KeyCode`], because the keypad is a separate
/// table.** `[[source: ctlseqs]]` line 2498 gives twenty-four rows whose two
/// columns are chosen by DECKPAM/DECKPNM, and the digits are not the digits
/// above the letters: keypad `2` sends `CSI B` in application mode and the
/// main-row `2` never does. Folding them into `KeyCode::Char` would lose
/// exactly the distinction the table exists to make, and an application in
/// application-keypad mode would see text where it expected a cursor key.
///
/// `PF1`-`PF4` are here and *also* reachable as `F1`-`F4`, which is not a
/// duplicate: on a VT keyboard they are the keypad's own top row, and on a PC
/// keyboard the function keys send the same bytes. The encoder gives one
/// answer; which physical key produced it is the platform layer's business.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum KeypadKey {
    Space,
    Tab,
    Enter,
    Pf1,
    Pf2,
    Pf3,
    Pf4,
    Multiply,
    Add,
    Comma,
    Minus,
    /// Labelled `.` and Delete -- `[[source: ctlseqs]]` line 2508 gives its
    /// application form as `CSI 3 ~`, the editing keypad's Delete, and not the
    /// VT220 table's `SS3 n`.
    Period,
    Divide,
    Digit0,
    Digit1,
    Digit2,
    Digit3,
    Digit4,
    Digit5,
    Digit6,
    Digit7,
    Digit8,
    Digit9,
    Equal,
}

/// Which introducer a key sequence carries.
///
/// A two-state enum and **not** a `bool`, for the reason [`MarginMode`] gives:
/// the choice is made three different ways -- DECCKM for the cursor keys, the
/// table itself for the keypad, and "always `CSI`" once a modifier is present
/// -- and a `bool` at those call sites says nothing about which rule applied.
/// Routing the keypad through the cursor keys' rule is a bug that has already
/// happened here once.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum Introducer {
    Csi,
    Ss3,
}

impl KeypadKey {
    /// The numeric column of `[[source: ctlseqs]]` line 2498: the literal
    /// character on the key.
    ///
    /// `None` for `Enter` and `PF1`-`PF4`, whose numeric forms are not their
    /// labels -- `CR` and `SS3 P`-`SS3 S`. The caller must handle those, and
    /// `None` is how this type says so rather than inventing a byte.
    pub fn numeric(self) -> Option<StreamByte> {
        let b = match self {
            KeypadKey::Space => b' ',
            KeypadKey::Tab => 0x09,
            KeypadKey::Multiply => b'*',
            KeypadKey::Add => b'+',
            KeypadKey::Comma => b',',
            KeypadKey::Minus => b'-',
            KeypadKey::Period => b'.',
            KeypadKey::Divide => b'/',
            KeypadKey::Digit0 => b'0',
            KeypadKey::Digit1 => b'1',
            KeypadKey::Digit2 => b'2',
            KeypadKey::Digit3 => b'3',
            KeypadKey::Digit4 => b'4',
            KeypadKey::Digit5 => b'5',
            KeypadKey::Digit6 => b'6',
            KeypadKey::Digit7 => b'7',
            KeypadKey::Digit8 => b'8',
            KeypadKey::Digit9 => b'9',
            KeypadKey::Equal => b'=',
            KeypadKey::Enter
            | KeypadKey::Pf1
            | KeypadKey::Pf2
            | KeypadKey::Pf3
            | KeypadKey::Pf4 => return None,
        };
        Some(StreamByte::from_stream(b))
    }

    /// The `SS3 <byte>` rows of line 2498's application column.
    ///
    /// **`StreamByte`, not [`FinalByte`].** `Space` is `SS3 SP` -- 0x20, below
    /// the `0x40..=0x7e` range `FinalByte` is the proof of. The byte after
    /// `SS3` is not a CSI final byte and typing it as one would either reject
    /// this row or quietly widen an invariant the parser relies on.
    ///
    /// `None` for every row that is *not* that shape, which is the half of
    /// this table worth naming: `2` is `CSI B`, `0` is `CSI 2 ~`, `1` is
    /// `SS3 F`. Eight rows would be wrong under a uniform rule.
    pub fn pc_application_byte(self) -> Option<StreamByte> {
        let b = match self {
            KeypadKey::Space => b' ',
            KeypadKey::Tab => b'I',
            KeypadKey::Enter => b'M',
            KeypadKey::Multiply => b'j',
            KeypadKey::Add => b'k',
            KeypadKey::Comma => b'l',
            KeypadKey::Minus => b'm',
            KeypadKey::Divide => b'o',
            KeypadKey::Equal => b'X',
            _ => return None,
        };
        Some(StreamByte::from_stream(b))
    }

    /// The application column of `[[source: ctlseqs]]` line 2713, the VT52
    /// keypad, whose introducer is `ESC ?`.
    ///
    /// These finals are the *VT220* table's, not 2498's: `2` is `r` here and
    /// `CSI B` there, because a VT52 keypad has no cursor duties to borrow.
    pub fn vt52_byte(self) -> Option<StreamByte> {
        let b = match self {
            KeypadKey::Space => b' ',
            KeypadKey::Tab => b'I',
            KeypadKey::Enter => b'M',
            KeypadKey::Multiply => b'j',
            KeypadKey::Add => b'k',
            KeypadKey::Comma => b'l',
            KeypadKey::Minus => b'm',
            KeypadKey::Period => b'n',
            KeypadKey::Divide => b'o',
            KeypadKey::Digit0 => b'p',
            KeypadKey::Digit1 => b'q',
            KeypadKey::Digit2 => b'r',
            KeypadKey::Digit3 => b's',
            KeypadKey::Digit4 => b't',
            KeypadKey::Digit5 => b'u',
            KeypadKey::Digit6 => b'v',
            KeypadKey::Digit7 => b'w',
            KeypadKey::Digit8 => b'x',
            KeypadKey::Digit9 => b'y',
            KeypadKey::Equal => b'X',
            KeypadKey::Pf1 | KeypadKey::Pf2 | KeypadKey::Pf3 | KeypadKey::Pf4 => return None,
        };
        Some(StreamByte::from_stream(b))
    }

    /// The rows of line 2498 that are cursor keys in disguise, as
    /// `(introducer, final)`.
    ///
    /// **The introducer is fixed per row and is not DECCKM's.** The arrows and
    /// Begin are `CSI`; End and Home are `SS3`. Four rows one way and two the
    /// other -- not a pattern, which is why each names its own and why routing
    /// these through the cursor keys' rule sent `CSI F` for a key the table
    /// spells `SS3 F`.
    pub fn cursor_shaped(self) -> Option<(Introducer, FinalByte)> {
        let (i, b) = match self {
            KeypadKey::Digit2 => (Introducer::Csi, b'B'),
            KeypadKey::Digit4 => (Introducer::Csi, b'D'),
            KeypadKey::Digit6 => (Introducer::Csi, b'C'),
            KeypadKey::Digit8 => (Introducer::Csi, b'A'),
            // `CSI E` is CNL as an output operation and Begin as an input one.
            // Different directions, so not a conflict.
            KeypadKey::Digit5 => (Introducer::Csi, b'E'),
            KeypadKey::Digit1 => (Introducer::Ss3, b'F'),
            KeypadKey::Digit7 => (Introducer::Ss3, b'H'),
            _ => return None,
        };
        Some((i, FinalByte(b)))
    }

    /// The editing-keypad rows of line 2498, which carry `CSI <param> ~`.
    pub fn tilde_param(self) -> Option<Param> {
        Some(Param(match self {
            KeypadKey::Digit0 => 2,
            KeypadKey::Period => 3,
            KeypadKey::Digit9 => 5,
            KeypadKey::Digit3 => 6,
            _ => return None,
        }))
    }

    /// `PF1`-`PF4` as function keys, which is what they send.
    pub fn pf(self) -> Option<FnKey> {
        FnKey::new(match self {
            KeypadKey::Pf1 => 1,
            KeypadKey::Pf2 => 2,
            KeypadKey::Pf3 => 3,
            KeypadKey::Pf4 => 4,
            _ => return None,
        })
    }
}

impl FnKey {
    /// The `CSI <param> ~` parameter this key carries, from
    /// `[[source: ctlseqs]]` lines 2529 and 2685.
    ///
    /// **The gaps are the point.** F5-F12 are 15, 17, 18, 19, 20, 21, 23, 24 --
    /// 16 and 22 are skipped -- and F13-F20 are 25, 26, 28, 29, 31, 32, 33, 34,
    /// skipping 27 and 30. A table written from memory as "15 upward" is wrong
    /// at F6 and wrong again at F11, and would send a neighbouring key rather
    /// than a missing one.
    ///
    /// `None` for F1-F4, which are not `~` keys at all: they are `SS3 P`
    /// through `SS3 S`, and [`FnKey::changes_introducer_when_modified`] is the
    /// other half of that rule.
    pub fn tilde_param(self) -> Option<Param> {
        let p: u16 = match self.0 {
            5 => 15,
            6 => 17,
            7 => 18,
            8 => 19,
            9 => 20,
            10 => 21,
            11 => 23,
            12 => 24,
            13 => 25,
            14 => 26,
            15 => 28,
            16 => 29,
            17 => 31,
            18 => 32,
            19 => 33,
            20 => 34,
            _ => return None,
        };
        Some(Param(p))
    }

    /// `SS3 P`-`SS3 S`: the final byte F1-F4 send.
    ///
    /// In range for [`FinalByte`], unlike the keypad's `SP`.
    pub fn ss3_final(self) -> Option<FinalByte> {
        self.changes_introducer_when_modified()
            .then(|| FinalByte(b'P' + self.0 - 1))
    }
}

/// Whether a key's bytes carry the `ESC` prefix that Alt or Meta adds.
///
/// A two-state enum and not a `bool`, for the reason [`MarginMode`] gives and
/// the signature audit enforces: the call site already passes a byte slice and
/// a `bool` beside it says nothing about which of the two prefix modes decided
/// it. `[[source: ctlseqs]]` line 2337 has separate columns for Alt and Meta,
/// and both fold into this one answer.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum Prefix {
    None,
    Escape,
}

/// A key, named by what it means rather than where it sits on a keyboard.
///
/// Physical position is the platform layer's problem; baud has no event
/// source. What arrives here is already resolved to a key.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum KeyCode {
    /// A key that produces text. The codepoint is what the layout resolved,
    /// not a scancode.
    Char(Codepoint),
    Up,
    Down,
    Right,
    Left,
    Home,
    End,
    Insert,
    Delete,
    PageUp,
    PageDown,
    Function(FnKey),
    /// A key on the numeric keypad, which has its own table and its own mode.
    Keypad(KeypadKey),
    Enter,
    Tab,
    Backspace,
    Escape,
}

impl KeyCode {
    /// The `CSI <param> ~` parameter for the editing keypad, from
    /// `[[source: ctlseqs]]` line 2672.
    ///
    /// Insert 2, Delete 3, PageUp 5, PageDown 6. Unlike the cursor keys these
    /// do **not** change with DECCKM -- ctlseqs gives the same sequence in both
    /// columns -- which is why they are a separate rule from `Home`/`End`.
    pub fn tilde_param(self) -> Option<Param> {
        Some(Param(match self {
            KeyCode::Insert => 2,
            KeyCode::Delete => 3,
            KeyCode::PageUp => 5,
            KeyCode::PageDown => 6,
            KeyCode::Function(f) => return f.tilde_param(),
            _ => return None,
        }))
    }

    /// The final byte for a key of the `<introducer> <final>` shape.
    ///
    /// Home and End are here because `[[source: ctlseqs]]` line 2485 puts them
    /// in the arrows' table and calls them cursor keys, so DECCKM governs them
    /// too. `Begin` has no `KeyCode` -- it exists only as keypad `5`.
    pub fn cursor_final(self) -> Option<FinalByte> {
        Some(FinalByte(match self {
            KeyCode::Up => b'A',
            KeyCode::Down => b'B',
            KeyCode::Right => b'C',
            KeyCode::Left => b'D',
            KeyCode::End => b'F',
            KeyCode::Home => b'H',
            _ => return None,
        }))
    }
}

/// Whether a key went down, came up, or repeated.
///
/// An enum and not a pair of `bool`s. Only `[[source: kitty-keyboard]]` reports
/// anything but `Press`, and only when an application has asked for event
/// types -- so a terminal that reports presses alone is complete, and this
/// records which kind it *is* rather than two flags that can both be set.
#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
pub enum KeyEventKind {
    #[default]
    Press,
    Repeat,
    Release,
}

/// One key event, before any layer has encoded it.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct KeyEvent {
    pub code: KeyCode,
    pub mods: Modifiers,
    pub kind: KeyEventKind,
}

impl KeyEvent {
    /// A plain press, which is every event on the base layer.
    pub fn press(code: KeyCode, mods: Modifiers) -> KeyEvent {
        KeyEvent {
            code,
            mods,
            kind: KeyEventKind::Press,
        }
    }
}
use crate::*;
use core::marker::PhantomData;

/// Index of a *display* row, valid only for the [`Layout`] that produced it.
///
/// Row 500 at 80 columns is a different place in the text than row 500 at 200.
/// Anchoring scroll position by a bare row number is the resize bug users
/// actually notice, so the brand makes carrying one across a resize a compile
/// error.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub struct RowIdx<'layout> {
    v: RowCount,
    _b: Brand<'layout>,
}

/// Geometry currently in force. Obtainable only inside [`with_layout`], so
/// every [`RowIdx`] is tied to the geometry that computed it.
pub struct Layout<'layout> {
    cols: Cols,
    rows: Rows,
    _b: Brand<'layout>,
}

impl<'layout> Layout<'layout> {
    pub fn cols(&self) -> Cols {
        self.cols
    }
    pub fn rows(&self) -> Rows {
        self.rows
    }

    /// The only constructor for a branded [`RowIdx`].
    pub fn row(&self, v: RowCount) -> RowIdx<'layout> {
        RowIdx { v, _b: self._b }
    }
    pub fn row_value(&self, r: RowIdx<'layout>) -> RowCount {
        r.v
    }

    /// Display rows a line occupies at this width.
    ///
    /// Derived, never stored authoritatively — a pure function of
    /// `(DisplayWidth, cols)`, so the row index can always be recomputed and
    /// asserted against rather than drifting from the text.
    pub fn rows_for(&self, w: DisplayWidth) -> RowCount {
        let c = self.cols.raw() as u32;
        RowCount(w.cells().max(1).div_ceil(c))
    }
}

/// Enter a geometry scope. A resize means calling this again, which mints a
/// fresh brand and invalidates every outstanding [`RowIdx`] at compile time.
///
/// ```compile_fail
/// # use baud_domain::*;
/// let stale = with_layout(Cols::from_wire(80), Rows::from_wire(24), |l| l.row(RowCount(5)));
/// with_layout(Cols::from_wire(200), Rows::from_wire(50), |l| l.row_value(stale)); // ERROR
/// ```
pub fn with_layout<R>(cols: Cols, rows: Rows, f: impl for<'id> FnOnce(Layout<'id>) -> R) -> R {
    f(Layout {
        cols,
        rows,
        _b: Brand(PhantomData),
    })
}

/// Scroll position expressed so it survives resize: a stable line plus an
/// offset *within* that line's wrapped rows.
#[derive(Clone, Copy)]
pub struct Anchor {
    pub line: LineIdx,
    /// Which wrapped row within that logical line. A [`RowCount`], not a
    /// [`RowIdx`]: it is an offset inside one line, not a grid position, and it
    /// stays valid across a resize while a `RowIdx` does not.
    pub row_within: RowCount,
}
//! Domain model as a type system.
//!
//! Every rule here is enforced by the compiler rather than by a comment. The
//! doc comments say *which measurement* made each rule necessary, but the rule
//! itself is structural — the wrong program does not build.
//!
//! Four techniques, in order of how much they buy:
//!
//! 1. **Generative brands** for anything whose validity depends on a mutable
//!    context. A `RowIdx` is meaningless once `cols` changes; a branded
//!    lifetime makes reusing one a type error rather than a silent wrong answer.
//! 2. **Typestate** for one-way lifecycles. `push_run` simply does not exist on
//!    a completed line.
//! 3. **Opaque newtypes with no arithmetic.** You cannot add a `LineIdx` to a
//!    `RowIdx` because neither exposes its integer.
//! 4. **Constructor narrowing.** `DisplayWidth` can only be built from a
//!    `WidthTable`, and no font type exists in this crate to pass instead.

#![no_std]
// `put_ascii_run` writes 27% of the cells on the streaming payload and costs
// 5.3x per cell what `slice::fill` does for the other 73%, because it was a
// scalar loop -- `otool -tv` showed no vector register in it at all. This
// feature is what lets it store eight cells at a time.
#![feature(portable_simd)]
#![forbid(unsafe_code)]

mod brand;
mod cell;
mod dec_graphics;
mod decode;
mod font;
mod grapheme;
mod grapheme_data;
mod grid;
mod input;
mod layout;
mod line;
mod nrcs_data;
mod pos;
mod quantity;
mod scan;
mod source;
mod store;
mod style;
pub mod unchecked;
mod vt;
mod width;
mod width_data;

pub use brand::*;
pub use cell::*;
pub use dec_graphics::*;
pub use decode::*;
pub use font::*;
pub use grapheme::*;
pub use grid::*;
pub use input::*;
pub use layout::*;
pub use line::*;
pub use nrcs_data::*;
pub use pos::*;
pub use quantity::*;
pub use scan::*;
pub use source::*;
pub use store::*;
pub use style::*;
pub use vt::*;
pub use width::*;
use crate::*;
use core::marker::PhantomData;

mod sealed {
    pub trait State {}
}

/// Still being appended to.
pub enum Building {}

/// Immutable: runs final, width cached.
pub enum Complete {}

/// Bytes copied to the cold ring. The one mandatory copy in the design —
/// memcpy at 5948 MB/s against 280 MB/s ingest, ~5% of a core.
pub enum Drained {}

impl sealed::State for Building {}

impl sealed::State for Complete {}

impl sealed::State for Drained {}

/// A line of text as the *application* produced it — delimited by `\n`, not by
/// the screen edge. This is the unit that survives resize, and keeping it is
/// why reflow is re-derivation rather than reconstruction from a wrapped flag.
pub struct Line<S: sealed::State> {
    first_run: RunIdx,
    run_count: RunCount,
    width: DisplayWidth,
    _s: PhantomData<S>,
}

impl Line<Building> {
    pub fn new(first_run: RunIdx) -> Self {
        Line {
            first_run,
            run_count: RunCount::ZERO,
            width: DisplayWidth::ZERO,
            _s: PhantomData,
        }
    }
    /// Runs live in a shared pool, so there is no fixed cap. A previous design
    /// used `[Run; 8]` and silently promoted any line exceeding it.
    pub fn push_run(&mut self) {
        self.run_count = self.run_count.inc();
    }

    /// The only transition out of `Building`. Consumes `self`, so the mutable
    /// handle is gone.
    pub fn complete(self, width: DisplayWidth) -> Line<Complete> {
        Line {
            first_run: self.first_run,
            run_count: self.run_count,
            width,
            _s: PhantomData,
        }
    }
}

impl Line<Complete> {
    /// Only exists once the line is final, so a width can never be read
    /// mid-append.
    pub fn width(&self) -> DisplayWidth {
        self.width
    }
    pub fn runs(&self) -> RunRange {
        RunRange {
            start: self.first_run,
            count: self.run_count,
        }
    }
    pub fn drained(self) -> Line<Drained> {
        Line {
            first_run: self.first_run,
            run_count: self.run_count,
            width: self.width,
            _s: PhantomData,
        }
    }
}

impl Line<Drained> {
    pub fn width(&self) -> DisplayWidth {
        self.width
    }
}
//! National Replacement Character Sets, generated from the source pinned in
//! `docs/research/sources/MANIFEST.toml`.
//!
//! **Do not edit by hand.** Regenerate with `scripts/gen-nrcs-tables.py`;
//! `nrcs_tables_match_the_pinned_source` fails if this file and the pinned
//! source disagree.
//!
//! Each set replaces a handful of ASCII positions -- "the term *replacement*
//! says that the character set is formed by replacing some of the characters
//! with more useful ones for a given language". Everything not listed is ASCII.

