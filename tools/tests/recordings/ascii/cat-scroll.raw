use crate::*;

impl<'a> Term<'a> {
    /// `ESC ( ) * + <C>` — designate a character set into a G-slot.
    ///
    /// Designating does not change what is displayed until the slot is invoked
    /// into GL by SO/SI, which is why this only records.
    pub(crate) fn designate(&mut self, slot: GSlot, c: StreamByte) {
        self.g[slot.index()] = Charset::from_final(c);
        self.refresh_flags();
    }

    /// `ESC ( % 6` — designate a set whose final takes two bytes.
    pub(crate) fn designate_multi(&mut self, slot: GSlot, inter: StreamByte, c: StreamByte) {
        let set = Charset::from_multi(inter, c);
        if set == Charset::Other {
            // A two-byte final the specification does not list. Counted rather
            // than recorded, so it cannot look designated.
            self.unsupported.inc();
        }
        self.g[slot.index()] = set;
        self.refresh_flags();
    }

    /// The set designated into one G-slot, invoked or not.
    ///
    /// `Term::charset` reports GL only, so a designation into G1, G2 or G3 was
    /// invisible from outside -- `ESC ) 0` recorded the line-drawing set and
    /// nothing could observe that it had. A renderer needs all four, because
    /// SO/SI can invoke any of them without another designation.
    pub fn charset_in(&self, slot: GSlot) -> Charset {
        self.g[slot.index()]
    }

    /// How incoming bytes are decoded. `ESC % @` / `ESC % G` select it.
    pub fn input_encoding(&self) -> InputEncoding {
        self.encoding
    }

    /// Whether replies use 7-bit or 8-bit C1 introducers. S7C1T / S8C1T.
    pub fn c1_transmit(&self) -> C1Transmit {
        self.c1
    }

    /// The character set currently invoked into GL.
    pub fn charset(&self) -> Charset {
        self.g[self.gl.index()]
    }
}
use crate::*;

impl<'a> Term<'a> {
    /// IND: down one line, scrolling the region if already at its bottom.
    ///
    /// **The column is not touched.** This used to reset `cx`, which made `LF`
    /// and `ESC D` behave as `NEL`. `[[source: ctlseqs]]` defines IND as index
    /// only, and LNM (mode 20, reset by default) is what decides whether LF
    /// also returns to column 1 -- so the old behaviour was LNM permanently on.
    #[inline(always)]
    pub(crate) fn index(&mut self) {
        if self.cy == self.scroll_bot {
            self.scroll_region_up(Count::ONE);
        } else if let Some(r) = self.cy.next(self.rows) {
            self.cy = r;
        }
        // The destination line starts empty of spans.
        //
        // Load-bearing for chunk invariance, not tidiness: without it runs
        // accumulate on a line across index operations, so whether MAXRUN
        // overflows -- and therefore whether the line gets promoted -- depends
        // on how the input happened to be split into reads. Dropping this line
        // broke ingest_is_chunk_invariant.
        //
        // KNOWN GAP: this also means IND onto an *existing* unpromoted line
        // discards its spans, where the spec moves the cursor without touching
        // content. Recorded in docs/vt-coverage.md rather than fixed here,
        // because fixing it means bounding run growth some other way and that
        // needs its own measurement.
        let i = self.line();
        self.s.nrun[i.index()] = RunCount::ZERO;
    }

    /// CR + IND: what autowrap does at the right margin, and what NEL is.
    #[inline(always)]
    /// NEL, and the wrap at the right margin.
    ///
    /// Returns to the **left margin**, not to column 0. With DECSLRM set, text
    /// wrapping to column 0 would leave the scrolling region entirely, which is
    /// the whole thing side margins exist to prevent.
    pub(crate) fn wrap(&mut self) {
        self.cx = self.left_margin;
        self.index();
    }

    /// RI. Up one line, scrolling the region down if already at its top.
    ///
    /// Was keyed on row 0 rather than the region top, so `ESC M` inside a
    /// scrolling region scrolled the whole screen.
    #[inline(always)]
    pub(crate) fn reverse_index(&mut self) {
        if self.cy == self.scroll_top {
            self.scroll_region_down(Count::ONE);
        } else if self.cy.index() > 0 {
            self.cy = self.cy.up(Count::ONE);
        }
    }

    /// LF. Adds the carriage return only when LNM is set.
    #[inline(always)]
    pub(crate) fn line_feed(&mut self) {
        self.index();
        if self.modes.is_set(ModeBit::LineFeedNewLine) {
            self.cx = Col::ZERO;
        }
    }

    /// Origin for row addressing, and the row a CUP parameter is relative to.
    ///
    /// `[[source: vt510-decom]]`: "When DECOM is set, the home cursor position
    /// is at the upper-left corner of the screen, within the margins. The
    /// starting point for line numbers depends on the current top margin
    /// setting. The cursor cannot move outside of the margins."
    pub(crate) fn origin_row(&self) -> Row {
        if self.modes.is_set(ModeBit::Origin) {
            self.scroll_top
        } else {
            Row::ZERO
        }
    }

    /// Clamp a row to the margins when DECOM confines the cursor to them.
    pub(crate) fn confine(&self, r: Row) -> Row {
        if !self.modes.is_set(ModeBit::Origin) {
            return r;
        }
        Row::from_index(
            r.index()
                .clamp(self.scroll_top.index(), self.scroll_bot.index()),
        )
    }
}

impl<'a> Term<'a> {
    /// DECRC. Restores the cursor and rendition DECSC saved, **clamped to the
    /// grid that exists now**.
    ///
    /// The save may predate a resize, and `resize` homes the cursor but cannot
    /// touch a position already stored. Restoring row 49 into a one-row grid
    /// left `cy` outside it, and `cy` is not only a report: writes and erases
    /// index with it, and `View::phys` is a single conditional subtract that
    /// assumes it is in range. `Term::cursor` already clamps the *column* for
    /// exactly this reason -- "a 200-column page has no column 201" -- and the
    /// row had the same hole with none of the clamping.
    ///
    /// `cx` clamps to `cols` rather than `cols - 1` so the deferred-wrap
    /// sentinel survives a restore on an unchanged grid: with autowrap on, `cx`
    /// legitimately sits one past the last column until the next write
    /// consumes it, and flattening that here would turn a saved wrap-pending
    /// state into an ordinary one.
    ///
    /// One implementation because DECRC arrives two ways -- `ESC 8` and
    /// `CSI u`'s sibling in the escape table -- and two copies of a clamp is
    /// how one of them comes to lack it.
    pub(crate) fn restore_cursor(&mut self) {
        self.place_saved(self.saved);
    }

    /// Apply a saved cursor and rendition, clamped to the current grid.
    ///
    /// Shared with `?1049 l`, which `[[source: ctlseqs]]` defines as restoring
    /// "cursor as in DECRC" -- so it is the same operation and must not be a
    /// second implementation. It was one, and the second lacked the clamp.
    pub(crate) fn place_saved(&mut self, saved: Option<(Row, Col, StyleId, StyleWord, CellFlags)>) {
        let Some((r, c, st, sw, fl)) = saved else {
            return;
        };
        self.cy = Row::from_index(r.index().min(self.rows.index() - 1));
        self.cx = Col::at_index(c.index().min(self.cols.index()));
        self.style = st;
        self.style_raw = sw;
        self.flags = fl;
    }
}
use crate::*;

impl<'a> Term<'a> {
    /// Act on a completed DCS payload.
    pub(crate) fn dispatch_dcs(&mut self) {
        let n = self.osc_len.index();
        let handled = self.dcs_final.map(|f| Dcs::parse(self.csi_inter, f));
        if handled == Some(Dcs::RequestStatus) {
            let target = StatusTarget::parse(&self.s.osc[..n]);
            self.report_status(target);
        }
        self.osc_reset();
        self.dcs_final = None;
    }

    /// Answer a DECRQSS.
    ///
    /// `[[source: ctlseqs]]`: "xterm responds with `DCS 1 $ r Pt ST` for valid
    /// requests, replacing the Pt with the corresponding CSI string, or
    /// `DCS 0 $ r ST` for invalid requests."
    ///
    /// **1 is valid and 0 is invalid, and the DEC manuals say the opposite.**
    /// `[[source: ctlseqs]]` records the errata directly: "testing a DEC VT420
    /// in 1996 showed that the documented code for a valid or invalid response
    /// to DECRQSS was reversed", and that vttest and DEC STD 070 agree with the
    /// tested behaviour rather than with the VT420 and VT525 manuals. baud
    /// follows xterm, which is what applications are written against. Getting
    /// this backwards would tell every application that every setting it asked
    /// about is unsupported.
    ///
    /// The reply body is the *tail of the CSI that would set it*, so an
    /// application can echo it straight back.
    pub(crate) fn report_status(&mut self, t: StatusTarget) {
        // One place where the DECRQSS shape is written, for the same reason
        // replies go through `Report`: the introducer, the validity digit and
        // the terminator must not be spelled at each call site. The body is
        // variable-length, which is why this is a helper rather than a
        // `Report` variant over the fixed-size encoder.
        if t == StatusTarget::Unknown {
            let (dcs, st) = (self.c1.dcs(), self.c1.st());
            self.emit(dcs);
            self.emit(b"0$r");
            self.emit(st);
            return;
        }
        let dcs = self.c1.dcs();
        self.emit(dcs);
        self.emit(b"1$r");
        match t {
            StatusTarget::ScrollRegion => {
                self.emit_num(self.scroll_top.one_based());
                self.emit(b";");
                self.emit_num(self.scroll_bot.one_based());
                self.emit(b"r");
            }
            StatusTarget::SideMargins => {
                self.emit_num(self.left_margin.one_based());
                self.emit(b";");
                self.emit_num(self.right_margin.one_based());
                self.emit(b"s");
            }
            StatusTarget::CursorStyle => {
                self.emit_dec(self.cursor_style.wire());
                self.emit(b" q");
            }
            StatusTarget::Protection => {
                self.emit_dec(u8::from(self.protect.is_protected()));
                self.emit(b"\"q");
            }
            StatusTarget::Sgr => {
                let raw = self.style_raw;
                self.emit_sgr(raw);
                self.emit(b"m");
            }
            StatusTarget::Unknown => {}
        }
        let st = self.c1.st();
        self.emit(st);
    }
}
use crate::*;

impl<'a> Term<'a> {
    /// A fresh screen is spaces, not NULs. Terminals compare equal on blank
    /// cells and a NUL renders as a hole.
    pub(crate) fn clear_screen(&mut self) {
        for y in 0..self.rows.index() {
            self.fill_row_counted(Row::from_index(y), PackedCell::EMPTY);
        }
    }

    pub(crate) fn erase_line(&mut self, e: EraseExtent) {
        let y = self.cy.index();
        // Erase-to-end of an unpromoted line in Runs mode IS the truncation of
        // its span list: there is nothing after nrun to erase, and the viewport
        // is a projection of the spans. Promoting and filling afterwards
        // materialises a row only to blank it.
        //
        // On the TUI payload this is ~134 cell writes per 77 input bytes -- a
        // CSI K per line against a 200-column grid -- which is write
        // amplification of roughly 20:1 against rule #1's <= 1.
        if self.mode == OpMode::Runs && !self.s.promoted[y] && e == EraseExtent::ToEnd {
            let i = self.line();
            self.s.nrun[i.index()] = RunCount::ZERO;
            return;
        }
        self.promote_if_runs();
        let s = e.line_span(self.cx, self.cols);
        let b = PackedCell::empty_with(self.style);
        self.fill_counted(Row::from_index(y), s.from, s.to, b);
    }

    /// ED. **The cursor's own row is erased only partially.**
    ///
    /// `[[source: ecma48]]` 8.3.39: for `Ps = 0`, "the active presentation
    /// position and the character positions up to the end of the page are put
    /// into the erased state"; for `Ps = 1`, "the character positions from the
    /// beginning of the page up to and including the active presentation
    /// position". The split is at the *cursor*, not at the row boundary.
    ///
    /// This erased whole rows, so `CSI 0 J` with the cursor mid-line destroyed
    /// the text to its left — text the application had every reason to believe
    /// was safe. It was found by a VT52 test (`ESC J` is the same operation)
    /// after reading the spec, not by any of the existing ED tests, which only
    /// ever erased from column 0.
    pub(crate) fn erase_display(&mut self, e: EraseExtent) {
        self.promote_if_runs();
        let b = PackedCell::empty_with(self.style);
        let full = e.full_rows(self.cy, self.rows);
        for y in full.from.index()..full.to.index() {
            let r = Row::from_index(y);
            self.discard_row(r);
            self.fill_row_counted(r, b);
        }
        if let Some(s) = e.cursor_span(self.cx, self.cols) {
            let r = self.cy;
            self.discard_row(r);
            self.fill_counted(r, s.from, s.to, b);
        }
    }

    pub(crate) fn erase_chars(&mut self, n: Count) {
        self.promote_if_runs();
        let b = PackedCell::empty_with(self.style);
        let (r, from) = (self.cy, self.cx);
        let to = Col::at_index(self.cx.index() + n.at_least_one());
        self.fill_counted(r, from, to, b);
    }

    /// DCH. Bounded by the right margin when DECSLRM has set one.
    ///
    /// Without a margin this is the whole row, which is why the unbounded
    /// `delete_chars` is no longer called: `right_margin` is the last column by
    /// default, so one path covers both and there is no second version to keep
    /// in step.
    pub(crate) fn delete_chars(&mut self, n: Count) {
        self.promote_if_runs();
        let (r, at, b) = (self.cy, self.cx, PackedCell::empty_with(self.style));
        let to = self.right_margin.after();
        self.delete_cells_counted(r, at, n, to, b);
    }

    /// ICH. Bounded by the right margin, for the same reason as DCH: text
    /// beyond it is outside the scrolling region and must not be pushed.
    pub(crate) fn insert_blanks(&mut self, n: Count) {
        self.promote_if_runs();
        let (r, at, b) = (self.cy, self.cx, PackedCell::empty_with(self.style));
        let to = self.right_margin.after();
        self.insert_cells_counted(r, at, n, to, b);
    }

    /// Is the cell at `(r, c)` protected from a selective erase?
    ///
    /// Read from the cell, not from the style table. An earlier version looked
    /// the rendition up in `tmpl_key`, which is a direct-mapped cache with one
    /// slot per bucket: once 64 further styles had been interned, the slot held
    /// somebody else and the answer was whatever that style happened to say.
    /// Cell flags fit in what was `PackedCell::_pad`, so this costs nothing.
    pub(crate) fn is_protected(&mut self, r: Row, c: Col) -> bool {
        self.view().get(r, c).is_protected()
    }

    /// DECSEL, `CSI ? Ps K`.
    ///
    /// `[[source: vt510-decsel]]`: "erases only those characters defined as
    /// erasable by the DECSCA control function", and it "works inside or
    /// outside the scrolling margins".
    pub(crate) fn selective_erase_line(&mut self, e: EraseExtent) {
        self.promote_if_runs();
        self.selective_wipe(self.cy, e.line_span(self.cx, self.cols));
    }

    /// DECSED, `CSI ? Ps J`. Same rule, over the display.
    ///
    /// Splits at the cursor for the same reason [`Term::erase_display`] does,
    /// and had the same bug: it erased the cursor's whole row, including the
    /// text to the left of it.
    pub(crate) fn selective_erase_display(&mut self, e: EraseExtent) {
        self.promote_if_runs();
        let full = e.full_rows(self.cy, self.rows);
        let whole = EraseExtent::All.line_span(self.cx, self.cols);
        for y in full.from.index()..full.to.index() {
            self.selective_wipe(Row::from_index(y), whole);
        }
        if let Some(s) = e.cursor_span(self.cx, self.cols) {
            self.selective_wipe(self.cy, s);
        }
    }

    /// Erase the unprotected cells of one row across a half-open column span.
    ///
    /// Typed rather than three `usize`s: a row index and two column indices are
    /// three different quantities, and passing them in the wrong order compiles
    /// perfectly. The audit refused the `usize` version, correctly.
    fn selective_wipe(&mut self, r: Row, s: ColSpan) {
        let blank = PackedCell::empty_with(self.style);
        self.discard_row(r);
        for x in s.from.index()..s.to.index() {
            let c = Col::at_index(x);
            if !self.is_protected(r, c) {
                self.put_counted(r, c, blank);
            }
        }
    }

    /// Mark a row materialised and drop the spans behind it.
    ///
    /// Every bulk erase does these two together, and they must stay together:
    /// `promoted` without clearing `nrun` leaves a stale run list that a later
    /// promote would replay over the blanks it just wrote.
    fn discard_row(&mut self, r: Row) {
        self.s.promoted[r.index()] = true;
        self.s.nrun[self.head.plus(r, SB).index()] = RunCount::ZERO;
    }

    /// DECALN, `ESC # 8`.
    ///
    /// `[[source: vt510-decaln]]`: "fills the complete screen area with a test
    /// pattern used for adjusting screen alignment... DECALN sets the margins
    /// to the extremes of the page, and moves the cursor to the home
    /// position." The pattern is uppercase E.
    pub(crate) fn screen_alignment(&mut self) {
        self.scroll_top = Row::ZERO;
        self.scroll_bot = Row::from_index(self.rows.index() - 1);
        self.reset_side_margins();
        // The pattern is characters, and characters written while DECSCA is
        // on are protected -- no special case here, so `ESC # 8` followed by a
        // DECSEL behaves like any other text would.
        let cell = PackedCell::from_ascii(StreamByte::from_stream(b'E'), self.style, self.flags);
        for y in 0..self.rows.index() {
            let r = Row::from_index(y);
            self.s.promoted[y] = true;
            self.s.nrun[self.head.plus(r, SB).index()] = RunCount::ZERO;
            self.fill_row_counted(r, cell);
        }
        self.cx = Col::ZERO;
        self.cy = Row::ZERO;
    }
}
use crate::*;

/// `ESC`. VT52's introducer is the bare escape, which is not a C1 control and
/// so does not come from `self.c1` -- `S8C1T` cannot move it, because a VT52
/// has no 8-bit forms to move it to.
const ESC: u8 = 0x1b;

impl<'a> Term<'a> {
    /// Encode a key press into the reply buffer.
    ///
    /// Returns whether anything was written. The reply buffer is the channel
    /// because that is where terminal-to-application bytes already go:
    /// `mouse_report` -- also an input event -- uses it, and a key and a mouse
    /// report travel the same pty in the same order.
    ///
    /// **The base layer only.** `docs/input-coverage.md` names three, and this
    /// is the one every terminal implements: an application that has not asked
    /// for an enhancement must receive what it would get from any other
    /// terminal, or it breaks. The same reasoning that makes `DA` under-claim.
    /// `[[source: fixterms]]`'s `CSI u` form and `[[source: kitty-keyboard]]`'s
    /// progressive enhancement are negotiated, and neither is implemented yet.
    pub fn key(&mut self, e: KeyEvent) -> bool {
        // Only presses exist on this layer. `[[source: kitty-keyboard]]` is
        // what reports releases and repeats, and an application that has not
        // enabled it must not start seeing them.
        if e.kind != KeyEventKind::Press {
            return false;
        }
        // **VT52 is a different keyboard, not a different introducer.**
        // `[[source: ctlseqs]]` line 2698: "A VT52 does not have function
        // keys, but it does have a numeric keypad and cursor keys." So this
        // is a separate table rather than a prefix substitution, and the keys
        // a VT52 does not have send nothing -- inventing a form for Insert
        // there would be answering with a shape no application asked for.
        if self.terminal_mode() == TerminalMode::Vt52 {
            return self.vt52_key(e.code, e.mods);
        }
        match e.code {
            // The arrows plus Home and End: `[[source: ctlseqs]]` line 2485
            // puts the latter in the arrows' table and calls them cursor keys,
            // so DECCKM governs all six. The finals live on `KeyCode` with the
            // table they came from.
            KeyCode::Up
            | KeyCode::Down
            | KeyCode::Right
            | KeyCode::Left
            | KeyCode::Home
            | KeyCode::End => match e.code.cursor_final() {
                Some(f) => self.cursor_key(f, e.mods),
                None => return false,
            },
            // The editing keypad. Unlike the cursor keys these do not change
            // with DECCKM -- `[[source: ctlseqs]]` line 2672 gives the same
            // sequence in both columns -- and their parameters live on
            // `KeyCode::tilde_param` with that table.
            //
            // Home and End are sent PC-style above, from line 2485. Line 2672
            // also gives VT220 forms, `CSI 1 ~` and `CSI 4 ~`, and those are an
            // *alternative* reached through `sunKeyboard` rather than an
            // addition: sending both would be sending two different keys.
            KeyCode::Insert | KeyCode::Delete | KeyCode::PageUp | KeyCode::PageDown => {
                match e.code.tilde_param() {
                    Some(p) => self.tilde_key(p, e.mods),
                    None => return false,
                }
            }
            KeyCode::Function(f) => self.function_key(f, e.mods),
            KeyCode::Keypad(k) => return self.keypad_key(k, e.mods),
            KeyCode::Char(cp) => return self.text_key(cp, e.mods),
            // `[[source: ctlseqs]]` line 253: BS is Ctrl-H. Which byte the
            // *Backspace key* sends is a different question -- DECBKM (`?67`)
            // chooses, and baud does not implement it, so this is xterm's
            // default with `backarrowKey` false. `docs/input-coverage.md`
            // records the mode as absent rather than the key as wrong.
            KeyCode::Backspace => self.emit(&[0x7f]),
            KeyCode::Escape => self.emit(&[0x1b]),
            KeyCode::Tab => match e.mods.has(Modifiers::SHIFT) {
                // CBT. Shift-Tab is the one text key that is a sequence, and
                // it is `CSI Z` rather than a modified HT.
                true => {
                    let csi = self.c1.csi();
                    self.emit(csi);
                    self.emit(b"Z");
                }
                false => self.emit(&[0x09]),
            },
            KeyCode::Enter => {
                // LNM. `[[source: ctlseqs]]` makes the mode govern what LF
                // *does* on output; on input it is what Return sends, and the
                // two are the same question asked from either end.
                self.emit(&[0x0d]);
                if self.modes.is_set(ModeBit::LineFeedNewLine) {
                    self.emit(&[0x0a]);
                }
            }
        }
        true
    }

    /// The VT52 keyboard: `[[source: ctlseqs]]` lines 2703 and 2713.
    ///
    /// Two tables and both are short. The cursor keys are `ESC A`-`ESC D` and
    /// **do not change with mode** -- the specification says so in the same
    /// sentence that introduces them, and DECCKM is an ANSI mode that a VT52
    /// cannot be in. The keypad's application column is `ESC ? <final>`, which
    /// is the one place in this encoder where the introducer is three bytes.
    ///
    /// `PF1`-`PF4` are `ESC P`-`ESC S` in both columns, the same four finals
    /// the ANSI side spells `SS3 P`-`SS3 S`. That is the shape of the whole
    /// difference: same finals, VT52's own introducers.
    ///
    /// **Modifiers are dropped rather than encoded.** ctlseqs gives no
    /// modified form for any VT52 key, and there is nowhere to put one -- the
    /// forms carry no parameters. Control still reaches the application
    /// through [`Term::text_key`], because folding a character into its
    /// control code is what the keyboard does rather than what the protocol
    /// encodes.
    fn vt52_key(&mut self, code: KeyCode, mods: Modifiers) -> bool {
        match code {
            // The same four finals the ANSI side sends, under VT52's own
            // introducer. `cursor_final` carries them with their table.
            KeyCode::Up | KeyCode::Down | KeyCode::Right | KeyCode::Left => {
                match code.cursor_final() {
                    Some(f) => self.vt52_esc(f),
                    None => return false,
                }
            }
            KeyCode::Keypad(k) => return self.vt52_keypad(k),
            // The text keys are the keyboard, not the emulation.
            KeyCode::Char(cp) => return self.text_key(cp, mods),
            KeyCode::Backspace => self.emit(&[0x7f]),
            KeyCode::Escape => self.emit(&[0x1b]),
            // No CBT on a VT52: `CSI Z` is an ANSI sequence, and Shift-Tab
            // has no VT52 form, so Tab is HT whatever is held.
            KeyCode::Tab => self.emit(&[0x09]),
            KeyCode::Enter => {
                self.emit(&[0x0d]);
                if self.modes.is_set(ModeBit::LineFeedNewLine) {
                    self.emit(&[0x0a]);
                }
            }
            // Home, End, the editing keypad and the function keys. A VT52 has
            // none of them and ctlseqs gives no form, so nothing is sent.
            _ => return false,
        }
        true
    }

    /// `ESC <final>`, the VT52 cursor keys.
    fn vt52_esc(&mut self, final_byte: FinalByte) {
        self.emit(&[ESC]);
        self.emit_byte(final_byte.byte());
    }

    /// The VT52 keypad, `[[source: ctlseqs]]` line 2713.
    fn vt52_keypad(&mut self, k: KeypadKey) -> bool {
        // `ESC P`-`ESC S` in both columns, so the mode is not consulted.
        // `ESC P`-`ESC S` in both columns, so the mode is not consulted.
        // Same four finals as the ANSI side's `SS3 P`-`SS3 S`.
        if let Some(f) = k.pf().and_then(FnKey::ss3_final) {
            self.vt52_esc(f);
            return true;
        }
        if self.keypad() == KeypadMode::Numeric {
            return match k {
                KeypadKey::Enter => {
                    self.emit(&[0x0d]);
                    if self.modes.is_set(ModeBit::LineFeedNewLine) {
                        self.emit(&[0x0a]);
                    }
                    true
                }
                _ => match k.numeric() {
                    Some(b) => {
                        self.emit_byte(b);
                        true
                    }
                    None => false,
                },
            };
        }
        // `ESC ? <final>`. The finals are the VT220 table's, not the PC one's:
        // `2` is `ESC ? r`, where the ANSI PC keypad sends `CSI B`. A VT52
        // keypad has no cursor duties to borrow.
        match k.vt52_byte() {
            Some(b) => {
                self.emit(&[ESC, b'?']);
                self.emit_byte(b);
                true
            }
            None => false,
        }
    }

    /// The keypad, `[[source: ctlseqs]]` line 2498.
    ///
    /// **The PC-style table, not the VT220 one.** ctlseqs gives both -- line
    /// 2498 for a Sun/PC keypad and line 2628 for the VT102/VT220 keypad
    /// reached through `sunKeyboard` -- and they disagree on most of the
    /// twenty-four rows. The exact count is derived from the two tables by
    /// `the_vt220_keypad_is_a_different_table_and_is_not_what_baud_sends`
    /// rather than written here: a number restated in a comment is one that
    /// goes quietly wrong if a later edition of ctlseqs reconciles them. baud sends the first, which is the same choice
    /// already made for Home and End, and for the same reason: sending both
    /// would be sending two different keys, and xterm's default is the one
    /// applications are built against.
    ///
    /// The two columns are chosen by DECKPAM/DECKPNM. The numeric column is
    /// the literal character in every row but `Enter` and the `PF` keys, and
    /// the application column is **not uniformly `SS3`** -- `2` is `CSI B`,
    /// `0` is `CSI 2 ~`, `1` is `SS3 F`. A table that assumed one introducer
    /// would be wrong in eight rows and wrong in a way each application would
    /// interpret as a different keystroke rather than as an error.
    fn keypad_key(&mut self, k: KeypadKey, mods: Modifiers) -> bool {
        // `PF1`-`PF4` are `SS3 P`-`SS3 S` in **both** columns: the only rows
        // the mode does not change. They are the same four sequences F1-F4
        // send, so they take the same path and the `SS3` -> `CSI 1 ; mod`
        // switch under a modifier is written once.
        if let Some(f) = k.pf() {
            self.function_key(f, mods);
            return true;
        }
        if self.keypad() == KeypadMode::Numeric {
            // Enter is the one row whose numeric form is not its label: `CR`,
            // and LNM governs it exactly as it governs the main Return.
            if k == KeypadKey::Enter {
                self.emit_return();
                return true;
            }
            return match k.numeric() {
                Some(b) => {
                    self.emit_byte(b);
                    true
                }
                None => false,
            };
        }
        // The rows that are cursor keys in disguise, whose introducer is fixed
        // by the table rather than by DECCKM.
        if let Some((intro, f)) = k.cursor_shaped() {
            self.cursor_shaped(intro, f, mods);
            return true;
        }
        // The editing-keypad rows: same parameters as the standalone keys.
        if let Some(p) = k.tilde_param() {
            self.tilde_key(p, mods);
            return true;
        }
        // Everything else is `SS3 <byte>`.
        //
        // **No modifier form, and none is invented.** ctlseqs gives the
        // `CSI 1 ; mod` shape for the cursor and function keys and gives
        // nothing for these, so a modified `SS3 j` would be a sequence baud
        // made up. Sending the unmodified form is what a terminal does;
        // sending an invented one is answering with the wrong shape.
        match k.pc_application_byte() {
            Some(b) => {
                self.emit_introducer(Introducer::Ss3);
                self.emit_byte(b);
                true
            }
            None => false,
        }
    }

    /// `CR`, and `LF` too under LNM.
    ///
    /// `[[source: ctlseqs]]` makes the mode govern what LF *does* on output;
    /// on input it is what Return sends, and the two are the same question
    /// asked from either end. Shared by Return and the keypad's Enter, which
    /// are different keys with the same answer.
    fn emit_return(&mut self) {
        self.emit(&[0x0d]);
        if self.modes.is_set(ModeBit::LineFeedNewLine) {
            self.emit(&[0x0a]);
        }
    }

    /// A key that produces text.
    ///
    /// Two modifiers change the bytes rather than adding a parameter, and this
    /// layer has no way to say "Control was held" other than by sending a
    /// different character -- which is exactly the ambiguity
    /// `[[source: fixterms]]` exists to remove, and why `CSI u` is the next
    /// layer rather than a nicety.
    fn text_key(&mut self, cp: Codepoint, mods: Modifiers) -> bool {
        // Control folds the character into `0x00..0x1f`: `@` through `_` and
        // the lowercase letters differ from their control code by bit 6 alone.
        // Anything else has no control form and Control is simply dropped,
        // which is what a terminal does and what an application cannot detect.
        let base = match mods.has(Modifiers::CTRL) {
            true => match cp.value() {
                v @ (0x40..=0x5f | 0x61..=0x7a) => u8::try_from(v & 0x1f).ok(),
                0x20 => Some(0x00),
                0x3f => Some(0x7f),
                _ => None,
            },
            false => None,
        };

        // `[[source: ctlseqs]]` line 2325 gives two ways for either modifier to
        // apply -- prefix `ESC`, or add 128 -- and line 2337's table has a
        // separate column per modifier: `?1039` for Alt, `?1036` for Meta.
        // They are asked independently here because four of that table's
        // sixteen rows disagree between them.
        //
        // The table's other branch -- `shift`, meaning add 128 -- is `?1034`
        // eightBitInput, and it applies only under ISO 8859-1. Under UTF-8 a
        // byte above 127 is a continuation byte rather than a character, so
        // shifting there would send something no application can decode.
        let modded = mods.has(Modifiers::ALT) || mods.has(Modifiers::META);
        let esc = match (mods.has(Modifiers::ALT) && self.alt_sends_escape())
            || (mods.has(Modifiers::META) && self.meta_sends_escape())
        {
            true => Prefix::Escape,
            false => Prefix::None,
        };
        // **The prefix is emitted last, not here.** Emitting it before the
        // character is known to be encodable left a bare `ESC` in the reply
        // when the encoding could not represent the key -- `Alt` plus a
        // codepoint above `U+00FF` under ISO 8859-1 returned `false` having
        // already written a byte. An application reads that `ESC` as the start
        // of a sequence that never arrives. Found by
        // `the_return_value_agrees_with_the_bytes`, which is the property that
        // a `false` writes nothing.
        // The prefix wins where both modes are set, which is what the table's
        // last four rows say: with both resources ON every modified row is
        // `ESC x`, and none of them is the shifted form.
        let shift = modded
            && esc == Prefix::None
            && self.eight_bit_input()
            && self.input_encoding() == InputEncoding::Latin1;

        // A control code is always one byte and always below 128, so the shift
        // is unconditional here. `Meta-Ctrl-A` becomes `0x81`, which under
        // ISO 8859-1 is a C1 control -- and baud accepts 8-bit C1 controls in
        // exactly that encoding, so the two halves agree.
        if let Some(b) = base {
            self.emit_prefixed(esc, &[b | if shift { 0x80 } else { 0 }]);
            return true;
        }

        let v = cp.value();
        // **Under ISO 8859-1 the keyboard sends ISO 8859-1.** `ESC % @`
        // switches how baud *decodes*, and an encoder that kept emitting UTF-8
        // would break the round trip that makes the mode useful: the
        // application set the encoding, and would read `é` back as two
        // characters. Symmetric with `?1020`, which reports the live encoding
        // rather than a compile-time one.
        if self.input_encoding() == InputEncoding::Latin1 {
            // One byte per character by definition. Above `U+00FF` there is no
            // byte, and no key on a Latin-1 keyboard produces one -- so this
            // sends nothing rather than sending UTF-8 the application would
            // misread. Same rule as answering a query with the wrong shape.
            let Ok(b) = u8::try_from(v) else {
                return false;
            };
            // `[[source: ctlseqs]]` line 2331: "shift the key from codes 0-127
            // to 128-255". A character already above 127 has no shifted form.
            self.emit_prefixed(esc, &[b | if shift && b < 0x80 { 0x80 } else { 0 }]);
            return true;
        }

        let Some(c) = char::from_u32(v) else {
            return false;
        };
        let mut buf = [0u8; 4];
        let bytes = c.encode_utf8(&mut buf).as_bytes();
        // `emit` borrows self mutably; the buffer is local, so copy the length
        // out first rather than holding the borrow.
        let n = bytes.len();
        let mut owned = [0u8; 4];
        owned[..n].copy_from_slice(bytes);
        self.emit_prefixed(esc, &owned[..n]);
        true
    }

    /// Emit `bytes`, with a single `ESC` in front if a prefix modifier applied.
    ///
    /// One call site per outcome, so the prefix cannot be written for a key
    /// that then turns out to be unencodable. Once, not once per modifier:
    /// `ESC ESC x` is Escape followed by Alt-x, a different keystroke.
    fn emit_prefixed(&mut self, esc: Prefix, bytes: &[u8]) {
        if esc == Prefix::Escape {
            self.emit(&[0x1b]);
        }
        self.emit(bytes);
    }

    /// `SS3 P` for F1-F4, `CSI n ~` for the rest.
    fn function_key(&mut self, f: FnKey, mods: Modifiers) {
        // F1-F4 share the cursor keys' shape: a single final byte after `SS3`,
        // and `CSI 1 ; mod` when modified. **`SS3` unconditionally when
        // unmodified -- DECCKM does not reach here.** Routing these through
        // `cursor_key` was wrong and the specification's own table caught it:
        // that function picks its introducer from `cursor_keys_application`,
        // so F1 came out as `CSI P` in normal mode where line 2529 says
        // `SS3 P` flatly. A cursor key is the only thing DECCKM governs.
        if let Some(final_byte) = f.ss3_final() {
            self.cursor_shaped(Introducer::Ss3, final_byte, mods);
            return;
        }
        // The gaps in the `~` parameters -- 16 and 22 skipped, then 27 and 30
        // -- live on `FnKey::tilde_param`, with the tables they came from.
        if let Some(p) = f.tilde_param() {
            self.tilde_key(p, mods);
        }
    }

    /// `CSI n ~`, or `CSI n ; mod ~` when modified.
    ///
    /// The editing keys and F5 upward share this shape, and unlike the cursor
    /// keys they do not change with DECCKM -- `[[source: ctlseqs]]` line 2672
    /// gives the same sequence in both columns.
    fn tilde_key(&mut self, param: Param, mods: Modifiers) {
        self.emit_introducer(Introducer::Csi);
        self.emit_param(param);
        if !mods.is_none() {
            self.emit(b";");
            self.emit_dec(mods.wire());
        }
        self.emit(b"~");
    }

    /// `CSI A` / `SS3 A`, or `CSI 1 ; mod A` when modified.
    ///
    /// Three rules from `[[source: ctlseqs]]`, and the third is the one that is
    /// easy to miss:
    ///
    /// * DECCKM picks the introducer -- `CSI` in normal mode, `SS3` in
    ///   application mode (line 2473).
    /// * A modifier is appended as `1 ; mod` before the final byte (line 2565),
    ///   `1` being the first parameter's default.
    /// * **A modified key uses `CSI` even in application mode.** The
    ///   specification states it for F1-F4 at line 2564 and the same holds
    ///   here: `SS3` takes no parameters, so there is nowhere to put the
    ///   modifier. An encoder that kept `SS3` would emit something no
    ///   application parses.
    fn cursor_key(&mut self, final_byte: FinalByte, mods: Modifiers) {
        let intro = match self.cursor_keys_application() {
            true => Introducer::Ss3,
            false => Introducer::Csi,
        };
        self.cursor_shaped(intro, final_byte, mods);
    }

    /// The same shape with the introducer supplied rather than read.
    ///
    /// **The keypad needs this and must not call [`Term::cursor_key`].** Its
    /// application column is chosen by DECKPAM, and keypad `1` is `SS3 F`
    /// there while keypad `2` is `CSI B` -- fixed per row, whatever DECCKM
    /// says. Reading DECCKM here sent `CSI F` for a key the table spells
    /// `SS3 F`, which is the same mistake F1-F4 made before the
    /// specification's own table caught it.
    ///
    /// The introducer is an [`Introducer`] and not a `bool` for exactly that
    /// reason: the two call sites pick it by different rules, and a `bool`
    /// records neither.
    fn cursor_shaped(&mut self, intro: Introducer, final_byte: FinalByte, mods: Modifiers) {
        if mods.is_none() {
            self.emit_introducer(intro);
            self.emit_byte(final_byte.byte());
            return;
        }
        // A modified key uses `CSI` even in application mode: `SS3` takes no
        // parameters, so there is nowhere to put the modifier, and an encoder
        // that kept it would emit something no application parses.
        self.emit_introducer(Introducer::Csi);
        self.emit(b"1;");
        self.emit_dec(mods.wire());
        self.emit_byte(final_byte.byte());
    }

    fn emit_introducer(&mut self, i: Introducer) {
        let b = match i {
            Introducer::Csi => self.c1.csi(),
            Introducer::Ss3 => self.c1.ss3(),
        };
        self.emit(b);
    }

    fn emit_byte(&mut self, b: StreamByte) {
        self.emit(&[b.raw_byte()]);
    }
}
//! `baud` — terminal ingest core, expressed in [`baud_domain`] types.
//!
//! Nothing here is a `usize`-as-a-column or a `u16`-as-a-length. The cursor
//! advances only by a [`Width`], and a `Width` can only come from decoding —
//! which is why the bug this file used to have is now not expressible:
//! `cx += 1` per UTF-8 continuation byte advanced a 3-byte CJK character three
//! columns instead of two, corrupting every position after the first non-ASCII
//! character on a line. Both operands were `usize`, so it compiled.
//!
//! Measured: the domain types cost nothing here. Four runs through a real PTY
//! gave +5.0%, -0.4%, -3.4%, -0.9% against raw primitives, ranges overlapping
//! throughout.
#![no_std]
#![forbid(unsafe_op_in_unsafe_fn)]
// Portable SIMD, so the scans below vectorise on every target rather than only
// x86-64. Nightly-only, which this project already requires.
#![feature(portable_simd)]

#[cfg(feature = "alloc")]
extern crate alloc;

pub use baud_domain::{
    AmbiguousWidth, AnsiMode, ArenaTail, Attrs, ByteLen, BytePos, C1Transmit, CellFlags, Chan,
    Charset, ClipboardOp, ClusterBreak, Codepoint, Col, ColSpan, ColorWord, Cols, Content, Count,
    Csi, CursorStyle, Dcs, DecSet, DeviceAttribute, Encoding, EraseExtent, Esc, Filled, FinalByte,
    FnKey, GSlot, HighlightRegion, HighlightTracking, InputEncoding, Introducer, KeyCode, KeyEvent,
    KeyEventKind, KeypadKey, KeypadMode, Lane, LaneMask, Level, LineSlot, LinkId, MarginMode,
    MarkSlot, Marker, ModeBit, ModeChange, ModeState, Modes, Modifiers, MouseButton, MouseEncoding,
    MouseEvent, MouseKind, MouseMods, MouseTracking, Nrcs, OneBased, Osc, PackedCell, Param,
    ParamIdx, Params, Pending, Prefix, PrivateMode, Protection, Report, ReportBytes, RingPos, Room,
    Row, RowBlock, RowRot, Rows, Run, RunCount, Slot, Stat, StatusTarget, StreamByte, StringTerm,
    StyleId, StyleWord, SubParams, TerminalMode, Utf8Acc, Utf8Min, View, Vt52, Vt52Coord, Width,
    WidthTable, WinSize, XColor,
};

mod charset;
mod cursor;
mod dcs;
mod erase;
mod key;
mod margins;
mod modes;
mod mouse;
mod osc;
mod parse;
mod reply;
mod reset;
mod scan;
mod scroll;
mod storage;
mod style;
mod tabs;
mod term;
mod text;
mod vt52;

pub(crate) use parse::*;
pub(crate) use scan::*;
pub use storage::*;
pub use term::*;
use crate::*;

impl<'a> Term<'a> {
    pub(crate) fn reset_side_margins(&mut self) {
        self.left_margin = Col::ZERO;
        self.right_margin = Col::at_index(self.cols.index() - 1);
    }

    /// DECSLRM, `CSI Pl ; Pr s`.
    ///
    /// `[[source: vt510-decslrm]]`: "The value of the left margin (Pl) must be
    /// less than the right margin (Pr) ... The minimum size of the scrolling
    /// region is two columns ... DECSLRM moves the cursor to column 1, line 1
    /// of the page."
    pub(crate) fn set_side_margins(&mut self, left: OneBased, right: OneBased) {
        let last = self.cols.index() - 1;
        let l = left.to_col(self.cols).index();
        let r = right.to_col(self.cols).index();
        // Reject rather than clamp into something the application did not ask
        // for: an invalid DECSLRM leaves the margins alone, which is what the
        // "must be less than" wording requires.
        if l >= r || r > last {
            return;
        }
        self.left_margin = Col::at_index(l);
        self.right_margin = Col::at_index(r);
        self.cx = Col::ZERO;
        self.cy = Row::ZERO;
    }

    /// DECIC, `CSI Pn ' }`.
    ///
    /// `[[source: vt510-decic]]`: "As columns are inserted, the columns between
    /// the cursor and the right margin move to the right ... DECIC has no
    /// effect outside the scrolling margins."
    pub(crate) fn insert_columns(&mut self, n: Count) {
        if !self.within_margins() {
            return;
        }
        self.shift_columns(n, true);
    }

    /// DECDC, `CSI Pn ' ~`. The inverse, filling at the right margin.
    pub(crate) fn delete_columns(&mut self, n: Count) {
        if !self.within_margins() {
            return;
        }
        self.shift_columns(n, false);
    }

    /// Is the cursor inside the scrolling region, in both axes?
    ///
    /// DECIC and DECDC are defined only there, and so is the column shifting
    /// that scrolling does when side margins are set.
    pub(crate) fn within_margins(&self) -> bool {
        let (x, y) = (self.cx.index(), self.cy.index());
        x >= self.left_margin.index()
            && x <= self.right_margin.index()
            && y >= self.scroll_top.index()
            && y <= self.scroll_bot.index()
    }

    /// Move every row's columns between the cursor and the right margin.
    ///
    /// Rows outside the *vertical* region are untouched: DECIC's "scrolling
    /// region" is the rectangle both margin pairs define, not the full height.
    pub(crate) fn shift_columns(&mut self, n: Count, insert: bool) {
        let blank = PackedCell::empty_with(self.style);
        let (from, to) = (self.cx, self.right_margin.after());
        let (top, bot) = (self.scroll_top.index(), self.scroll_bot.index());
        for y in top..=bot {
            let r = Row::from_index(y);
            self.s.promoted[y] = true;
            self.s.nrun[self.head.plus(r, SB).index()] = RunCount::ZERO;
            if insert {
                self.insert_cells_counted(r, from, n, to, blank);
            } else {
                self.delete_cells_counted(r, from, n, to, blank);
            }
        }
    }
}
use crate::*;

/// Whether `level` is the tracking currently selected.
///
/// The three modes are exclusive on the wire, so DECRQM answers "set" only for
/// the one actually in force -- reporting all three as set would tell an
/// application it is getting motion events it is not.
pub(crate) fn tracking_state(cur: MouseTracking, level: MouseTracking) -> ModeState {
    if cur == level {
        ModeState::Set
    } else {
        ModeState::Reset
    }
}

/// [`ModeState`] for one bit, so `mode_state` reads as a table rather than as
/// eight copies of the same `if`.
pub(crate) fn bit_state(m: Modes, b: ModeBit) -> ModeState {
    if m.is_set(b) {
        ModeState::Set
    } else {
        ModeState::Reset
    }
}

impl<'a> Term<'a> {
    /// DECSET / DECRST.
    ///
    /// Only modes baud acts on are stored, for the same reason as the ANSI
    /// ones: a bit that is set and never read is the "accepted, did nothing"
    /// failure `docs/vt-coverage.md` calls `parsed`. Mouse reporting, bracketed
    /// paste and the alternate screen are recognised by the parser and
    /// deliberately not recorded here -- they are input-side or need a second
    /// screen buffer, and pretending otherwise would be worse than ignoring.
    pub(crate) fn set_private_mode(&mut self, m: PrivateMode, on: bool) {
        match m {
            PrivateMode::CursorVisible => self.modes.apply(ModeBit::CursorVisible, on),
            PrivateMode::Origin => {
                self.modes.apply(ModeBit::Origin, on);
                // Both DECSET and DECRST home the cursor, and where home *is*
                // depends on the mode just applied.
                self.cx = Col::ZERO;
                self.cy = if on { self.scroll_top } else { Row::ZERO };
            }
            PrivateMode::AutoWrap => self.modes.apply(ModeBit::AutoWrap, on),
            // `[[source: vt510-decslrm]]`: DECSLRM "only works when vertical
            // split screen mode (DECLRMM) is set". Turning DECLRMM off puts the
            // margins back to the page borders -- leaving them set while the
            // mode that gives them meaning is off would confine writes with
            // nothing to explain why.
            PrivateMode::LeftRightMargin => {
                self.modes.apply(ModeBit::SideMargins, on);
                if !on {
                    self.reset_side_margins();
                }
            }
            // `[[source: ctlseqs]]` for `?1049 h`: "Save cursor as in DECSC ...
            // After saving the cursor, switch to the Alternate Screen Buffer,
            // clearing it first." And for `?1049 l`: "Use Normal Screen Buffer
            // and restore cursor as in DECRC."
            //
            // Idempotent in both directions. A second `?1049 h` must not
            // re-save the cursor over the one it saved on the way in, or an
            // application that sets the mode twice loses the position it will
            // be restored to.
            PrivateMode::AltScreen => {
                if on && self.screen == Screen::Normal {
                    self.alt_saved =
                        Some((self.cy, self.cx, self.style, self.style_raw, self.flags));
                    self.screen = Screen::Alternate;
                    self.clear_screen();
                    self.cx = Col::ZERO;
                    self.cy = Row::ZERO;
                } else if !on && self.screen == Screen::Alternate {
                    self.screen = Screen::Normal;
                    // Through the same clamped path as DECRC, because the
                    // quotation above says this *is* DECRC. The save may
                    // predate a resize, and an unclamped restore puts `cy`
                    // outside the grid -- which writes and erases index with.
                    let saved = self.alt_saved.take();
                    self.place_saved(saved);
                }
            }
            // The three tracking modes are a *level*, not three flags: xterm
            // treats each DECSET as selecting one, and 1003 is a superset of
            // 1002 which is a superset of 1000. Resetting any of them turns
            // tracking off, which is what applications expect from `?1000 l`.
            PrivateMode::MouseNormal => self.set_tracking(MouseTracking::Normal, on),
            PrivateMode::MouseButtonEvent => self.set_tracking(MouseTracking::ButtonEvent, on),
            PrivateMode::MouseAnyEvent => self.set_tracking(MouseTracking::AnyEvent, on),
            PrivateMode::MouseSgr => {
                // Resetting `?1006` returns to X10, which is the protocol's
                // default rather than "off" -- there is no off.
                self.mouse_encoding = if on {
                    MouseEncoding::Sgr
                } else {
                    MouseEncoding::X10
                }
            }
            // Input-side and rendering modes: recorded, and exposed by the
            // accessors below. The core has no keyboard and no renderer, so
            // exposing them *is* acting on them -- an embedder has no other
            // channel. Same argument as bracketed paste.
            // DECANM. Reset enters VT52; set returns to ANSI. Note the
            // inverted sense -- `on` here means "ANSI mode on".
            PrivateMode::AnsiMode => self.set_terminal_mode(if on {
                TerminalMode::Ansi
            } else {
                TerminalMode::Vt52
            }),
            PrivateMode::CursorKeys => self.modes.apply(ModeBit::CursorKeys, on),
            PrivateMode::SmoothScroll => self.modes.apply(ModeBit::SmoothScroll, on),
            PrivateMode::ReverseVideo => self.modes.apply(ModeBit::ReverseVideo, on),
            PrivateMode::AutoRepeat => self.modes.apply(ModeBit::AutoRepeat, on),
            PrivateMode::MetaSendsEscape => self.modes.apply(ModeBit::MetaSendsEscape, on),
            PrivateMode::AltSendsEscape => self.modes.apply(ModeBit::AltSendsEscape, on),
            PrivateMode::EightBitInput => self.modes.apply(ModeBit::EightBitInput, on),
            // `?45`: backspace at the left margin wraps to the end of the line
            // above instead of stopping. Acted on in `Term::back`.
            PrivateMode::ReverseWrap => self.modes.apply(ModeBit::ReverseWrap, on),
            // `?12` is the blink axis of DECSCUSR, reached by a different
            // route. Setting it must not change the *shape*, so it maps onto
            // the current style rather than replacing it.
            PrivateMode::CursorBlink => self.cursor_style = self.cursor_style.with_blink(on),
            // DECCOLM. `[[source: vt510-decscpp]]` behaviour that is baud's to
            // perform -- clear the screen, reset the margins, home the cursor --
            // happens here. The *resize* does not: geometry is caller-owned
            // through `Term::resize`, so the request is recorded and
            // `Term::column_mode()` reports it. Resizing behind the caller's
            // back would desynchronise it from the application.
            PrivateMode::Column132 => {
                self.modes.apply(ModeBit::Column132, on);
                self.scroll_top = Row::ZERO;
                self.scroll_bot = Row::from_index(self.rows.index() - 1);
                self.reset_side_margins();
                self.cx = Col::ZERO;
                self.cy = Row::ZERO;
                self.clear_screen();
            }
            // `?47` is the pre-1049 alternate screen: it switches buffers and
            // does **not** save or restore the cursor. `?1049` exists because
            // applications kept getting that wrong, so the two are deliberately
            // not aliases.
            PrivateMode::AltScreenLegacy => {
                self.screen = if on {
                    Screen::Alternate
                } else {
                    Screen::Normal
                };
            }
            // `?1001`. Recorded with an accessor, which is what every
            // input-side mode gets: it is the only channel a core with no
            // keyboard and no renderer has. The hang ctlseqs warns of is an
            // event loop ignoring events until a reply arrives, and baud has
            // no event loop -- whether to wait is the embedder's decision.
            PrivateMode::HighlightTracking => {
                self.highlight = if on {
                    HighlightTracking::On
                } else {
                    HighlightTracking::Off
                }
            }
            PrivateMode::BracketedPaste => self.modes.apply(ModeBit::BracketedPaste, on),
            PrivateMode::SynchronizedOutput => self.modes.apply(ModeBit::SynchronizedOutput, on),
            // A mode joins `Modes` only when something can act on it -- but an
            // unknown one is still a sequence accepted and dropped, so it is
            // counted rather than ignored.
            _ => self.unsupported.inc(),
        }
    }

    /// The combining marks attached to a cell, if any.
    ///
    /// A renderer needs these to draw `é` as one glyph rather than as `e`: the
    /// cell holds the base and this holds what combines with it. Empty for the
    /// overwhelming majority of cells, which is why the marks live in a side
    /// table rather than in `PackedCell`'s eight measured bytes.
    pub fn marks(&self, r: Row, c: Col) -> impl Iterator<Item = Codepoint> + '_ {
        let slot = &self.s.marks[MarkSlot::index_of(r, c, NMARK)];
        slot.marks().take(if slot.is_for(r, c) {
            MarkSlot::CAPACITY
        } else {
            0
        })
    }

    /// East Asian Ambiguous width policy.
    ///
    /// Owned by the embedder, not by the application: `[[source: uax11]]` § 5
    /// makes ambiguous width a property of the *reader's* context, and no
    /// escape sequence carries it. xterm exposes the same choice as the
    /// `cjkWidth` resource, defaulting false, which is `Narrow` here.
    ///
    /// Changing it changes how already-written cells would be measured, so set
    /// it before feeding, the way a terminal reads its locale at startup.
    pub fn set_ambiguous_width(&mut self, a: AmbiguousWidth) {
        self.width.ambiguous = a;
    }

    /// What [`Term::set_ambiguous_width`] last selected.
    pub fn ambiguous_width(&self) -> AmbiguousWidth {
        self.width.ambiguous
    }

    /// Whether the cursor should be drawn. DECTCEM; a renderer needs it.
    pub fn cursor_visible(&self) -> bool {
        self.modes.is_set(ModeBit::CursorVisible)
    }

    /// The cursor's shape and blink. DECSCUSR.
    pub fn cursor_style(&self) -> CursorStyle {
        self.cursor_style
    }

    /// DECSET ?2004. When set, the embedder must bracket pasted text with
    /// `ESC [ 200 ~` and `ESC [ 201 ~` so the application can tell a paste from
    /// typing -- without it, a pasted newline runs as a command.
    pub fn bracketed_paste(&self) -> bool {
        self.modes.is_set(ModeBit::BracketedPaste)
    }

    /// Apply every parameter of a DECSET/DECRST.
    ///
    /// `#[inline(never)]`, for the reason `Term::open_gap` carries: `dispatch`
    /// is inlined into the CSI fast path, and this body copies a 64-byte
    /// parameter array. Inlining it there enlarges the hot dispatch for the
    /// benefit of a branch that SGR-heavy streams never take.
    ///
    /// The copy is needed because `set_private_mode` takes `&mut self` while
    /// the parameters live in `self`.
    #[inline(never)]
    pub(crate) fn apply_private_modes(&mut self, change: ModeChange) {
        let (ps, n) = (self.params, self.nparams());
        for p in ps.iter().take(n) {
            self.set_private_mode(PrivateMode::from_wire(*p), change.is_set());
        }
    }

    /// As [`Term::apply_private_modes`], for the unprefixed namespace.
    #[inline(never)]
    pub(crate) fn apply_ansi_modes(&mut self, change: ModeChange) {
        let (ps, n) = (self.params, self.nparams());
        for p in ps.iter().take(n) {
            self.set_ansi_mode(AnsiMode::from_wire(*p), change.is_set());
        }
    }

    /// DECCKM ?1. When set the arrow keys send `SS3 A` rather than `CSI A`.
    pub fn cursor_keys_application(&self) -> bool {
        self.modes.is_set(ModeBit::CursorKeys)
    }

    /// DECSCNM ?5. When set the whole screen renders with fg and bg swapped.
    pub fn reverse_video(&self) -> bool {
        self.modes.is_set(ModeBit::ReverseVideo)
    }

    /// DECSCLM ?4. A hint that scrolling should be smooth rather than jump.
    pub fn smooth_scroll(&self) -> bool {
        self.modes.is_set(ModeBit::SmoothScroll)
    }

    /// DECARM ?8. Whether the keyboard should auto-repeat.
    pub fn auto_repeat(&self) -> bool {
        self.modes.is_set(ModeBit::AutoRepeat)
    }

    /// `?1036`. Whether the Meta modifier prefixes `ESC`. Read by
    /// [`Term::key`], and set on a fresh terminal.
    pub fn meta_sends_escape(&self) -> bool {
        self.modes.is_set(ModeBit::MetaSendsEscape)
    }

    /// `?1039`. Whether the Alt modifier prefixes `ESC`. Read by
    /// [`Term::key`], and set on a fresh terminal.
    ///
    /// Separate from [`Term::meta_sends_escape`] because `[[source: ctlseqs]]`
    /// line 2337 gives the two resources separate columns.
    pub fn alt_sends_escape(&self) -> bool {
        self.modes.is_set(ModeBit::AltSendsEscape)
    }

    /// `?1034`. Whether Alt/Meta add 128 rather than prefixing `ESC`.
    ///
    /// This is what terminfo's `smm` and `rmm` send, which is why it is
    /// implemented rather than refused: every `xterm*` entry carries them, so
    /// leaving `?1034` unrecognised left two capabilities of the corpus
    /// dropped, and `tests/conformance` counted them.
    ///
    /// **Reading it is not the same as acting on it.** [`Term::key`] applies
    /// the shift only under [`InputEncoding::Latin1`]: a byte above 127 is a
    /// character there and a continuation byte under UTF-8, so applying it in
    /// UTF-8 would send something no application can decode. The mode is
    /// recorded and reported truthfully in both, and the encoding decides.
    pub fn eight_bit_input(&self) -> bool {
        self.modes.is_set(ModeBit::EightBitInput)
    }

    /// DECCOLM ?3. Whether the application asked for 132 columns.
    ///
    /// baud does **not** resize itself: geometry is caller-owned through
    /// [`Term::resize`], and resizing behind the caller would desynchronise it
    /// from the application. The clear, margin reset and cursor home that
    /// DECCOLM mandates *do* happen.
    pub fn column_mode(&self) -> bool {
        self.modes.is_set(ModeBit::Column132)
    }

    /// DECSET ?2026. While set, a renderer should keep showing the last
    /// complete frame instead of drawing a half-applied update.
    pub fn synchronized_output(&self) -> bool {
        self.modes.is_set(ModeBit::SynchronizedOutput)
    }

    /// What DECRQM should answer about `mode` in `marker`'s namespace.
    ///
    /// Every mode baud does not implement answers `NotRecognized`, which is the
    /// honest answer and the useful one: an application asks DECRQM precisely
    /// to find out whether a mode exists. Saying "reset" about a mode that does
    /// not exist would tell it the mode is available, and it would then set the
    /// mode and believe it took effect.
    pub(crate) fn mode_state(&self, marker: Marker, mode: Param) -> ModeState {
        if marker != Marker::Private {
            return match AnsiMode::from_wire(Some(mode)) {
                AnsiMode::LineFeedNewLine => bit_state(self.modes, ModeBit::LineFeedNewLine),
                AnsiMode::InsertReplace => bit_state(self.modes, ModeBit::InsertReplace),
                _ => ModeState::NotRecognized,
            };
        }
        match PrivateMode::from_wire(Some(mode)) {
            // `?1020` mirrors the **live** encoding, which is what xterm does:
            // `do_dec_rqm` answers `MdBool` from `screen->utf8_mode`. It
            // answered `PermanentlySet` while `ESC % @` was refused, and that
            // was true then; implementing the switch made it false, so it moved
            // in the same commit. A mode report that outlives the fact it
            // reported is the failure this file exists to prevent.
            //
            // **A named divergence from xterm, and deliberate.** xterm answers
            // this with 1/2 (set/reset) even though its own documentation marks
            // the resource read-only. baud answers 3 (permanently set), because
            // 1 would invite an application to send `CSI ? 1020 l`, get no
            // error, and believe UTF-8 decoding had been turned off -- the
            // exact failure `docs/vt-coverage.md` refuses for DECRQM. DECRPM
            // has value 3 for precisely this case.
            PrivateMode::HighlightTracking => match self.highlight {
                HighlightTracking::On => ModeState::Set,
                HighlightTracking::Off => ModeState::Reset,
            },
            PrivateMode::Utf8Resource => match self.encoding {
                InputEncoding::Utf8 => ModeState::Set,
                InputEncoding::Latin1 => ModeState::Reset,
            },
            // `?2027` answers 3 for the same reason `?1020` does: baud
            // clusters per `[[source: uax29]]` and has no mode that stops it,
            // so `1` would invite an application to try turning it off.
            // It answered `0` while clustering was unimplemented, which was the
            // honest answer *then* -- saying `2` would have claimed the mode
            // existed and was merely off.
            PrivateMode::GraphemeClustering => ModeState::PermanentlySet,
            PrivateMode::Origin => bit_state(self.modes, ModeBit::Origin),
            PrivateMode::AutoWrap => bit_state(self.modes, ModeBit::AutoWrap),
            PrivateMode::LeftRightMargin => bit_state(self.modes, ModeBit::SideMargins),
            PrivateMode::AnsiMode => match self.terminal_mode {
                TerminalMode::Ansi => ModeState::Set,
                TerminalMode::Vt52 => ModeState::Reset,
            },
            PrivateMode::CursorKeys => bit_state(self.modes, ModeBit::CursorKeys),
            PrivateMode::SmoothScroll => bit_state(self.modes, ModeBit::SmoothScroll),
            PrivateMode::ReverseVideo => bit_state(self.modes, ModeBit::ReverseVideo),
            PrivateMode::AutoRepeat => bit_state(self.modes, ModeBit::AutoRepeat),
            PrivateMode::MetaSendsEscape => bit_state(self.modes, ModeBit::MetaSendsEscape),
            PrivateMode::AltSendsEscape => bit_state(self.modes, ModeBit::AltSendsEscape),
            PrivateMode::EightBitInput => bit_state(self.modes, ModeBit::EightBitInput),
            PrivateMode::ReverseWrap => bit_state(self.modes, ModeBit::ReverseWrap),
            PrivateMode::Column132 => bit_state(self.modes, ModeBit::Column132),
            PrivateMode::CursorBlink => {
                if self.cursor_style.blinks() {
                    ModeState::Set
                } else {
                    ModeState::Reset
                }
            }
            PrivateMode::AltScreenLegacy => match self.screen {
                Screen::Alternate => ModeState::Set,
                Screen::Normal => ModeState::Reset,
            },
            PrivateMode::CursorVisible => bit_state(self.modes, ModeBit::CursorVisible),
            PrivateMode::BracketedPaste => bit_state(self.modes, ModeBit::BracketedPaste),
            PrivateMode::SynchronizedOutput => bit_state(self.modes, ModeBit::SynchronizedOutput),
            // Not a `Modes` bit -- the alt screen is a whole buffer, not a
            // flag -- but it is implemented, so DECRQM must not deny it.
            PrivateMode::MouseNormal => tracking_state(self.mouse, MouseTracking::Normal),
            PrivateMode::MouseButtonEvent => tracking_state(self.mouse, MouseTracking::ButtonEvent),
            PrivateMode::MouseAnyEvent => tracking_state(self.mouse, MouseTracking::AnyEvent),
            PrivateMode::MouseSgr => match self.mouse_encoding {
                MouseEncoding::Sgr => ModeState::Set,
                MouseEncoding::X10 => ModeState::Reset,
            },
            PrivateMode::AltScreen => {
                if self.screen == Screen::Alternate {
                    ModeState::Set
                } else {
                    ModeState::Reset
                }
            }
            _ => ModeState::NotRecognized,
        }
    }

    /// SM / RM for the unprefixed namespace.
    ///
    /// Only modes baud acts on are stored. An unrecognised mode is ignored
    /// rather than recorded, so a bit can never be set and never read.
    pub(crate) fn set_ansi_mode(&mut self, m: AnsiMode, on: bool) {
        match m {
            AnsiMode::LineFeedNewLine => self.modes.apply(ModeBit::LineFeedNewLine, on),
            AnsiMode::InsertReplace => self.modes.apply(ModeBit::InsertReplace, on),
            // A mode joins `Modes` only when something can act on it -- but an
            // unknown one is still a sequence accepted and dropped, so it is
            // counted rather than ignored. The private namespace already did
            // this; the ANSI one did not.
            AnsiMode::Other(_) => self.unsupported_param.inc(),
        }
    }

    /// DECKPAM/DECKPNM: what the numeric keypad should send.
    pub fn keypad(&self) -> KeypadMode {
        self.keypad
    }
}
use crate::*;

impl<'a> Term<'a> {
    pub(crate) fn set_tracking(&mut self, level: MouseTracking, on: bool) {
        self.mouse = if on { level } else { MouseTracking::Off };
    }

    /// Whether `?1001` highlight tracking is on.
    ///
    /// An embedder with a selection model can implement it; baud records the
    /// request and the region and does nothing else. `[[source: ctlseqs]]`'s
    /// warning that it "requires a cooperating program, else xterm will hang"
    /// describes an event loop blocking on a reply, and baud has none -- so
    /// whether to wait is a decision baud does not make.
    pub fn highlight_tracking(&self) -> HighlightTracking {
        self.highlight
    }

    /// The region from the last `CSI Ps ; Ps ; Ps ; Ps ; Ps T`.
    pub fn highlight_region(&self) -> HighlightRegion {
        self.highlight_region
    }

    /// What tracking the application asked for. `?1000/1002/1003`.
    pub fn mouse_tracking(&self) -> MouseTracking {
        self.mouse
    }

    /// Queue a mouse report, if the application asked for this kind of event.
    ///
    /// Returns whether anything was queued, so an embedder can tell "the
    /// application does not want this" from "it was sent".
    ///
    /// Two gates, and both are refusals rather than omissions:
    ///
    /// * The tracking level decides which *kinds* are reported. Motion is
    ///   dropped under `?1000`, and motion with no button held is dropped under
    ///   anything below `?1003` -- sending it anyway would flood an application
    ///   that asked only for clicks.
    /// * The *position* has to be encodable. X10 -- the default, and what
    ///   `?1000` gives without `?1006` -- caps each ordinate at 223 against a
    ///   2048-column grid, so a report from column 400 has no encoding: the
    ///   byte it would produce names a different cell rather than a truncated
    ///   one, which is the wrong-shaped answer `docs/vt-coverage.md` rules out.
    ///   Those are dropped and counted in `mouse_unencodable`. Everything that
    ///   fits is sent.
    ///
    ///   This used to report *nothing at all* without `?1006`, on that same
    ///   reasoning. It is a reason not to encode out of range, not a reason to
    ///   refuse the encoding: an application speaking the original protocol on
    ///   an 80x24 screen was getting silence where every byte was encodable.
    pub fn mouse_report(&mut self, e: MouseEvent) -> bool {
        let wanted = match (self.mouse, e.kind) {
            (MouseTracking::Off, _) => false,
            (MouseTracking::Normal, MouseKind::Motion) => false,
            (MouseTracking::ButtonEvent, MouseKind::Motion) => e.button != MouseButton::None,
            _ => true,
        };
        if !wanted {
            return false;
        }
        // The encoding decides whether this *position* can be named. X10 caps
        // each ordinate at 223, so a report from column 400 has no encoding --
        // and the byte it would produce points at a different cell rather than
        // a truncated one. Refused and counted; the positions that fit are
        // sent, which is every one on a terminal anyone actually runs.
        if let Some(max) = self.mouse_encoding.max_ordinate() {
            let (r, c) = (e.row.one_based().get(), e.col.one_based().get());
            if r > max || c > max {
                self.mouse_unencodable.inc();
                return false;
            }
            self.report(Report::MouseX10(e));
            return true;
        }
        self.report(Report::MouseSgr(e));
        true
    }
}
use crate::*;

/// Trim a trailing NUL from an OSC string.
///
/// Some emitters terminate the payload with a NUL before the real terminator.
/// Keeping it would put a stray byte in every title.
pub(crate) fn clip(s: &[u8]) -> &[u8] {
    match s.last() {
        Some(0) => &s[..s.len() - 1],
        _ => s,
    }
}

impl<'a> Term<'a> {
    /// Append one byte to the OSC payload, truncating rather than growing.
    #[inline(always)]
    pub(crate) fn osc_push(&mut self, b: StreamByte) {
        let n = self.osc_len.index();
        if n < OSC_MAX {
            self.s.osc[n] = b.raw_byte();
            self.osc_len = ByteLen::from_index(n + 1);
        } else {
            self.osc_truncations.inc();
        }
    }

    pub(crate) fn osc_reset(&mut self) {
        self.osc_len = ByteLen::ZERO;
    }

    /// Copy a bounded string into one of the two title slots.
    pub(crate) fn set_string(dst: &mut [u8; OSC_MAX], src: &[u8]) -> ByteLen {
        let n = src.len().min(OSC_MAX);
        dst[..n].copy_from_slice(&src[..n]);
        ByteLen::from_index(n)
    }

    /// Act on a completed OSC payload.
    pub(crate) fn dispatch_osc(&mut self) {
        let n = self.osc_len.index();
        // Split the borrow: `Osc::parse` borrows the payload while the setters
        // want `&mut self.s`. Resolve to an owned decision first.
        let parsed = Osc::parse(&self.s.osc[..n]);
        match parsed {
            Osc::SetTitle(t) => {
                let t = clip(t);
                self.title_len = Self::set_string(&mut self.s.title, t);
            }
            Osc::SetIcon(t) => {
                let t = clip(t);
                self.icon_len = Self::set_string(&mut self.s.icon, t);
            }
            Osc::SetIconAndTitle(t) => {
                let t = clip(t);
                self.title_len = Self::set_string(&mut self.s.title, t);
                self.icon_len = Self::set_string(&mut self.s.icon, t);
            }
            Osc::SetColor { index, spec } => match spec {
                XColor::Rgb(r, g, b) => self.s.palette[index.index()] = ColorWord::rgb(r, g, b),
                XColor::Query => self.report_color(index),
                // A colour *name*. Not resolved, because resolving it needs
                // X11's rgb.txt and baud has no citable copy -- approximating
                // it would be guessing at a protocol. Left alone rather than
                // set to something plausible-but-wrong.
                XColor::Unresolved(_) => {}
            },
            Osc::ResetColor(Some(c)) => self.s.palette[c.index()] = ColorWord::DEFAULT,
            Osc::ResetColor(None) => self.s.palette = [ColorWord::DEFAULT; 256],
            // `OSC 52` write is accepted by the protocol but baud has no
            // clipboard to write to, and a *read* is refused on purpose --
            // see `ClipboardOp::Read`. Neither gets a reply: answering a
            // clipboard query with anything, including an empty string, tells
            // the application the feature works.
            Osc::Hyperlink { id, uri } => {
                // The payload borrows `self.s`, so resolve the slot and the
                // length before touching the table.
                let n = uri.len().min(LINK_MAX);
                if n == 0 {
                    self.link = LinkId::NONE;
                } else {
                    let id = LinkId::bucket(id, uri, NLINK);
                    let mut tmp = [0u8; LINK_MAX];
                    tmp[..n].copy_from_slice(&uri[..n]);
                    self.s.links[id.index()] = tmp;
                    self.s.link_len[id.index()] = ByteLen::from_index(n);
                    self.link = id;
                }
                self.refresh_flags();
            }
            // Refused, and *counted*. See `Term::clipboard_reads_refused`:
            // silence is the right answer to the application, and being unable
            // to tell that one asked is not.
            Osc::Clipboard(ClipboardOp::Read) => self.clipboard_reads_refused.inc(),
            Osc::Clipboard(_) => self.clipboard_writes_dropped.inc(),
            Osc::Unsupported => self.unsupported.inc(),
        }
        self.osc_reset();
    }

    /// How `OSC 8` opens and closes a link.
    ///
    /// An empty URI closes: the [explicit hyperlink spec][osc8] ends a run with
    /// `OSC 8 ; ; ST`, and treating that as "a link to nowhere" would make
    /// every cell after it clickable.
    ///
    /// The table is bounded and **evicts on collision**, exactly like the style
    /// table. A URI is attacker-supplied content used as a key, which
    /// `CLAUDE.md` names as the content-addressing failure mode; a page cycling
    /// through thousands of links must cost the same as one with four. An
    /// evicted link renders as an ordinary cell, the same tolerable degradation
    /// an evicted style has.
    ///
    /// The dispatch is inline in `dispatch_osc` because the URI borrows the
    /// payload buffer that lives in `self.s`.
    ///
    /// [osc8]: https://gist.github.com/egmontkob/eb114294efbcd5adb1944c9f3cb5feda
    /// The URI a cell links to, if any.
    pub fn link_uri(&self, l: LinkId) -> Option<&[u8]> {
        if l.is_none() {
            return None;
        }
        let n = self.s.link_len[l.index()].index();
        (n > 0).then(|| &self.s.links[l.index()][..n])
    }

    /// Reply to `OSC 4 ; c ; ?` in the same shape as the setter.
    ///
    /// `[[source: ctlseqs]]`: "xterm replies with a control sequence of the
    /// same form which can be used to set the corresponding color", and it
    /// "uses the same terminator used in a query".
    pub(crate) fn report_color(&mut self, index: Chan) {
        let c = self.s.palette[index.index()];
        let Some((r, g, b)) = c.as_rgb() else {
            // Not overridden. baud has no built-in palette table to report --
            // the renderer owns that -- so it says nothing rather than
            // inventing a colour the renderer does not use.
            return;
        };
        let term = self.osc_term;
        self.emit(b"\x1b]4;");
        self.emit_dec(index.get());
        self.emit(b";rgb:");
        self.emit_hex(r);
        self.emit(b"/");
        self.emit_hex(g);
        self.emit(b"/");
        self.emit_hex(b);
        match term {
            StringTerm::St => self.emit(b"\x1b\\"),
            StringTerm::Bel => self.emit(b"\x07"),
        }
    }

    /// The window title, as the application set it. Bounded by `OSC_MAX`.
    pub fn title(&self) -> &[u8] {
        &self.s.title[..self.title_len.index()]
    }

    /// The icon name. `OSC 1`, and `OSC 0` sets both.
    pub fn icon_name(&self) -> &[u8] {
        &self.s.icon[..self.icon_len.index()]
    }

    /// A palette override from `OSC 4`, if the application set one.
    ///
    /// `None` means "use your built-in colour": the core deliberately holds no
    /// default palette, because the mapping from index to pixels belongs to the
    /// renderer and a second copy here would be one to keep in step.
    pub fn palette(&self, index: Chan) -> Option<(u8, u8, u8)> {
        self.s.palette[index.index()].as_rgb()
    }
}
use crate::*;

impl<'a> Term<'a> {
    /// Fast-path hits: CSI or `ESC Fe` sequences consumed in bulk.
    ///
    /// These counters have been fed since the fast paths were written and never
    /// read anywhere, which is how "is the fast path even firing on this
    /// target?" became a question that could not be answered from the outside.
    /// Bytes the terminal owes the host, e.g. the answer to a DA or DSR.
    ///
    /// Write these back to wherever the input came from, then call
    /// [`Term::clear_reply`]. Empty when there is nothing to say.
    pub fn reply(&self) -> &[u8] {
        &self.s.reply[..self.reply_len.index()]
    }

    /// Drop the pending reply after sending it.
    pub fn clear_reply(&mut self) {
        self.reply_len = ByteLen::ZERO;
    }

    /// Append to the pending reply, or count the loss.
    pub(crate) fn emit(&mut self, bytes: &[u8]) {
        let at = self.reply_len.index();
        if at + bytes.len() > REPLY {
            self.reply_overflows.inc();
            return;
        }
        self.s.reply[at..at + bytes.len()].copy_from_slice(bytes);
        self.reply_len = ByteLen::from_index(at + bytes.len());
    }

    /// Queue a report.
    ///
    /// The only way to put bytes in the reply buffer that a caller will read as
    /// an answer. `emit` still exists for the raw append, but every *reply*
    /// goes through a named [`Report`] -- the shape is chosen by the variant,
    /// so a DSR cannot be answered with a DA's bytes.
    pub(crate) fn report(&mut self, r: Report) {
        let bytes = r.encode(self.c1);
        self.emit(bytes.as_bytes());
    }

    /// The current rendition as an SGR parameter string, always starting at 0.
    ///
    /// Leading `0` is not padding: DECRQSS answers with something the
    /// application can send back verbatim, and a string that only *adds*
    /// attributes would not reproduce the state on a terminal that had others
    /// set.
    pub(crate) fn emit_sgr(&mut self, w: StyleWord) {
        self.emit(b"0");
        for (bit, code) in Attrs::WIRE {
            if w.attrs().has(bit) {
                self.emit(b";");
                self.emit_dec(code);
            }
        }
        // `SGR 10` is the primary font and is the default, so it is emitted
        // only when it is not -- DECRQSS answers with something the
        // application can send back verbatim, and a redundant `10` is noise
        // that a comparison against the default would fail on.
        if !w.font().is_primary() {
            self.emit(b";");
            self.emit_dec(w.font().sgr());
        }
        // `SGR 58`, omitted when it is the default for the same reason `10` is:
        // the answer has to be something the application can send back.
        if !w.underline().is_default() {
            self.emit(b";");
            self.emit_colour(w.underline(), 58);
        }
        let (fg, bg) = (w.fg(), w.bg());
        if !fg.is_default() {
            self.emit(b";");
            self.emit_colour(fg, 38);
        }
        if !bg.is_default() {
            self.emit(b";");
            self.emit_colour(bg, 48);
        }
    }

    pub(crate) fn emit_colour(&mut self, c: ColorWord, base: u8) {
        if let Some((r, g, b)) = c.as_rgb() {
            self.emit_dec(base);
            self.emit(b";2;");
            self.emit_dec(r);
            self.emit(b";");
            self.emit_dec(g);
            self.emit(b";");
            self.emit_dec(b);
        } else if let Some(i) = c.as_index() {
            self.emit_dec(base);
            self.emit(b";5;");
            self.emit_dec(i);
        }
    }

    /// A 1-based coordinate as decimal, for a DECRQSS body.
    ///
    /// Wider than [`Term::emit_dec`] because a margin can be past column 255.
    pub(crate) fn emit_num(&mut self, v: OneBased) {
        const D: &[u8; 10] = b"0123456789";
        let mut buf = [0u8; 5];
        let mut i = buf.len();
        let mut n = v.get();
        loop {
            i -= 1;
            buf[i] = D[usize::from(n % 10)];
            n /= 10;
            if n == 0 {
                break;
            }
        }
        let tail = buf;
        self.emit(&tail[i..]);
    }

    /// A CSI parameter in decimal.
    ///
    /// Separate from [`Term::emit_dec`] because a `Param` is a `u16` and that
    /// takes a `u8`: `CSI 15 ~` fits either, `CSI 65535 ~` does not, and the
    /// parser saturates at 65535 precisely so a reply can carry it back.
    pub(crate) fn emit_param(&mut self, p: Param) {
        const D: &[u8; 10] = b"0123456789";
        let mut buf = [0u8; 5];
        let mut i = buf.len();
        let mut n = p.value();
        loop {
            i -= 1;
            buf[i] = D[usize::from(n % 10)];
            n /= 10;
            if n == 0 {
                break;
            }
        }
        let tail = buf;
        self.emit(&tail[i..]);
    }

    pub(crate) fn emit_dec(&mut self, v: u8) {
        const D: &[u8; 10] = b"0123456789";
        let mut buf = [0u8; 3];
        let mut i = buf.len();
        let mut n = v;
        loop {
            i -= 1;
            buf[i] = D[usize::from(n % 10)];
            n /= 10;
            if n == 0 {
                break;
            }
        }
        let tail = buf;
        self.emit(&tail[i..]);
    }

    pub(crate) fn emit_hex(&mut self, v: u8) {
        const H: &[u8; 16] = b"0123456789abcdef";
        let hi = H[usize::from(v >> 4)];
        let lo = H[usize::from(v & 0xf)];
        self.emit(&[hi, lo]);
    }
}
use crate::*;

impl<'a> Term<'a> {
    /// DECSTR. Modes, region, cursor and attributes to their defaults --
    /// **not** the screen contents. That is what makes it soft, and it is why
    /// an application uses it to recover a terminal without losing scrollback.
    pub(crate) fn soft_reset(&mut self) {
        self.cx = Col::ZERO;
        self.cy = Row::ZERO;
        self.style = StyleId::DEFAULT;
        self.style_raw = StyleWord::DEFAULT;
        self.flags = CellFlags::NONE;
        self.protect = CellFlags::NONE;
        self.keypad = KeypadMode::Numeric;
        self.set_terminal_mode(TerminalMode::Ansi);
        self.g = [Charset::Ascii; 4];
        self.gl = GSlot::G0;
        self.cursor_style = CursorStyle::BlinkingBlock;
        // **Not** `screen`, `alt_saved`, `mouse` or `mouse_encoding`.
        //
        // Those four used to be reset here, which meant a `CSI ! p` sent by a
        // full-screen application dropped it onto the primary screen mid-draw
        // and discarded the primary's saved contents with `alt_saved = None`.
        //
        // The alternate screen and mouse tracking are xterm extensions, so a
        // DEC manual's list of what DECSTR resets cannot mention them and
        // xterm is the authority. In `ReallyReset` its soft path does nothing
        // mouse-related at all, and `FromAlternate` sits in the `if (full)`
        // block -- alongside `ClearScreen`, which DECSTR must not do either.
        // RIS still resets all four; see `Term::reset`.
        //
        // The DEC-defined items above stay, including `saved`: DEC STD 070
        // has DECSTR set the saved cursor to home, and xterm resets it only
        // under RIS. Where the two disagree about a *DEC* function the DEC
        // manual wins; where the item is an xterm extension, xterm does.
        self.saved = None;
        self.scroll_top = Row::ZERO;
        self.scroll_bot = Row::from_index(self.rows.index() - 1);
        self.reset_side_margins();
        self.modes = Modes::default();
    }

    /// RIS. Everything back to power-on state, including the scrolling region
    /// and the modes -- a region left over across a reset is how an application
    /// ends up drawing into a window it did not ask for.
    pub(crate) fn reset(&mut self) {
        self.cx = Col::ZERO;
        self.cy = Row::ZERO;
        self.style = StyleId::DEFAULT;
        self.style_raw = StyleWord::DEFAULT;
        self.flags = CellFlags::NONE;
        self.protect = CellFlags::NONE;
        self.keypad = KeypadMode::Numeric;
        self.set_terminal_mode(TerminalMode::Ansi);
        self.mouse = MouseTracking::Off;
        self.mouse_encoding = MouseEncoding::X10;
        self.g = [Charset::Ascii; 4];
        self.gl = GSlot::G0;
        self.cursor_style = CursorStyle::BlinkingBlock;
        self.screen = Screen::Normal;
        self.alt_saved = None;
        self.saved = None;
        self.scroll_top = Row::ZERO;
        self.scroll_bot = Row::from_index(self.rows.index() - 1);
        self.reset_side_margins();
        self.modes = Modes::default();
        self.reset_tabs();
        // Same reason as `resize`: the grid is about to be cleared, so a
        // rotation has nothing left to describe. RIS cannot panic the way a
        // shrink can -- it does not change `rows`, so `rot` stays in range --
        // but leaving it set means a cleared grid still claims to be rotated.
        self.rot = RowRot::NONE;
        self.clear_screen();
    }
}
use crate::*;

impl<'a> Term<'a> {
    /// Scroll the scrolling region up by `n`, blanking what comes in at the
    /// bottom. The engine of LF-at-region-bottom, SU, and DL.
    ///
    /// The full-screen case advances the ring instead of moving cells: O(1)
    /// against O(rows x cols), and it is what makes streaming ingest fast. A
    /// region smaller than the screen cannot use it -- rows outside the region
    /// must not move -- so it pays for the copy.
    /// Count what a line-block move costs, for the four sites that do one.
    ///
    /// **`insert_lines_in` and `delete_lines_in` live in `baud-domain`, where
    /// the counters do not reach.** All four call sites -- region scroll up and
    /// down, `IL` and `DL` -- moved and blanked cells that nothing counted, so
    /// amplification was understated for every application that scrolls a
    /// region or inserts a line. That is most TUIs: vim reported **zero**
    /// scrolls and 74% of its cells as `fill`, because it scrolls with `IL`
    /// and `DL` rather than by running off the bottom of a region.
    ///
    /// `k` rows are blanked and the rest of the block is moved, and a move is a
    /// write: `copy_within` per row writes every cell it touches.
    fn count_line_block(&mut self, top: Row, bot: Row, n: Count) {
        if top.index() > bot.index() {
            return;
        }
        let height = bot.index() + 1 - top.index();
        // `at_least_one().min(..)` rather than a cast, which is the idiom the
        // scrolling paths already use and what keeps this off the audit.
        let k = n.at_least_one().min(height);
        let cols = self.cols.index();
        let (moved, blanked) = ((height - k) * cols, k * cols);
        self.cells_written.add(moved + blanked);
        self.cells_fill.add(moved + blanked);
        self.cells_blanked.add(blanked);
        self.cells_scroll.add(blanked);
        self.scrolls.add(k);
    }

    pub(crate) fn scroll_region_up(&mut self, n: Count) {
        let (top, bot) = (self.scroll_top.index(), self.scroll_bot.index());
        if top > bot {
            return;
        }
        let k = n.at_least_one().min(bot + 1 - top);
        let blank = PackedCell::empty_with(self.style);
        let last = self.rows.index() - 1;
        // The O(1) ring advance *is* the scrollback: it retires the top line by
        // moving the window, which is only meaningful when there is somewhere
        // for the line to go. The alternate screen has no scrollback, so it
        // takes the shifting path -- taking the ring path there would scroll
        // the primary screen's history from under it.
        //
        // **And only in `Runs` mode, which is the correction.** `head` indexes
        // the *run* table; `vp` is indexed by screen row. Advancing the ring
        // moves which line each row draws from, and in `Runs` that is the whole
        // answer because the content is the runs. In `Computed` and
        // `Templated` the content is `vp`, nothing re-derives it, and the
        // advance moved no cells: the screen kept its old text and only the
        // bottom row went blank. That is the most common scroll there is --
        // every line of output past the last row -- and no test looked at what
        // it left on the screen, because every other test in `scrolling.rs`
        // sets a region and takes the copying path.
        if top == 0 && bot == last && self.screen == Screen::Normal {
            for _ in 0..k {
                self.head = self.head.advance(SB);
                // Rotate first, then blank what is now the bottom row: the
                // rotation is what moves the cells, and it costs one addition.
                self.rot = self.rot.advance(1, self.rows);
                let y = Row::from_index(last);
                self.s.nrun[self.head.plus(y, SB).index()] = RunCount::ZERO;
                self.fill_row_counted(y, blank);
                self.cells_scroll.add(self.cols.index());
                self.scrolls.inc();
            }
            // `promoted` is indexed by screen row and the screen just moved, so
            // every flag now describes the wrong line. Clearing re-derives from
            // the runs, which `head` has already pointed at the right ones.
            self.s.promoted[..self.rows.index()].fill(false);
            return;
        }
        let (rt, rb) = (self.scroll_top, self.scroll_bot);
        self.count_line_block(rt, rb, n);
        self.view().delete_lines_in(rt, n, rb, blank);
        for y in top..=bot {
            self.s.promoted[y] = true;
            self.s.nrun[self.head.plus(Row::from_index(y), SB).index()] = RunCount::ZERO;
        }
    }

    /// Scroll the scrolling region down by `n`. The engine of RI-at-region-top,
    /// SD, and IL.
    pub(crate) fn scroll_region_down(&mut self, n: Count) {
        let (top, bot) = (self.scroll_top.index(), self.scroll_bot.index());
        if top > bot {
            return;
        }
        let blank = PackedCell::empty_with(self.style);
        let (rt, rb) = (self.scroll_top, self.scroll_bot);
        self.count_line_block(rt, rb, n);
        self.view().insert_lines_in(rt, n, rb, blank);
        for y in top..=bot {
            self.s.promoted[y] = true;
            self.s.nrun[self.head.plus(Row::from_index(y), SB).index()] = RunCount::ZERO;
        }
    }

    /// DECSTBM. Sets the region and homes the cursor, per `[[source: ctlseqs]]`.
    ///
    /// A region of fewer than two lines is rejected and leaves the previous one
    /// in place: a one-line region cannot scroll, and applications send
    /// `CSI r` with no parameters to mean "the whole screen".
    pub(crate) fn set_scroll_region(&mut self, top: OneBased, bottom: Option<OneBased>) {
        let last = Row::from_index(self.rows.index() - 1);
        let t = top.to_row(self.rows);
        let b = bottom.map_or(last, |v| v.to_row(self.rows));
        if t.index() >= b.index() {
            return;
        }
        self.scroll_top = t;
        self.scroll_bot = b;
        self.cx = Col::ZERO;
        self.cy = t;
    }

    pub(crate) fn delete_lines(&mut self, n: Count) {
        if self.cy.index() < self.scroll_top.index() || self.cy.index() > self.scroll_bot.index() {
            return;
        }
        let blank = PackedCell::empty_with(self.style);
        let (cy, bot) = (self.cy.index(), self.scroll_bot.index());
        let (at, rb) = (self.cy, self.scroll_bot);
        self.count_line_block(at, rb, n);
        self.view().delete_lines_in(at, n, rb, blank);
        for y in cy..=bot {
            self.s.promoted[y] = true;
            self.s.nrun[self.head.plus(Row::from_index(y), SB).index()] = RunCount::ZERO;
        }
    }

    /// IL. Bounded by the scrolling region, and a no-op with the cursor
    /// outside it -- `[[source: ctlseqs]]` defines IL as operating within the
    /// region. It used to shift to the bottom of the *screen*, which moved rows
    /// that DECSTBM had placed outside the region.
    pub(crate) fn insert_lines(&mut self, n: Count) {
        if self.cy.index() < self.scroll_top.index() || self.cy.index() > self.scroll_bot.index() {
            return;
        }
        let (cy, bot) = (self.cy.index(), self.scroll_bot.index());
        let k = n.at_least_one().min(bot + 1 - cy);
        let (at, rb, b) = (self.cy, self.scroll_bot, PackedCell::empty_with(self.style));
        self.count_line_block(at, rb, n);
        self.view().insert_lines_in(at, n, rb, b);
        for y in cy..cy + k {
            self.s.promoted[y] = true;
            self.s.nrun[self.head.plus(Row::from_index(y), SB).index()] = RunCount::ZERO;
        }
    }
}
use crate::*;

#[repr(C)]
#[cfg_attr(
    feature = "alloc",
    derive(zerocopy::FromZeros, zerocopy::KnownLayout, zerocopy::Immutable)
)]
pub struct Storage {
    pub arena: [u8; ARENA],
    pub runs: [Run; SB * MAXRUN],
    pub nrun: [RunCount; SB],
    pub vp: [PackedCell; GRID],
    pub promoted: [bool; MAX_ROWS],
    pub tmpl_key: [StyleWord; NSTYLE],
    pub tmpl_valid: [bool; NSTYLE],
    /// Bytes the terminal owes the host.
    ///
    /// A terminal is not write-only: DA, DSR and DECRQM are questions, and an
    /// application that asks one and gets nothing back **hangs** rather than
    /// degrading. The core cannot own a PTY -- it is `no_std` with no I/O -- so
    /// this mirrors the input side: the core fills a buffer, the caller drains
    /// it with [`Term::reply`] and writes it wherever the input came from.
    /// Combining marks, keyed on the cell they attach to. See [`NMARK`].
    pub marks: [MarkSlot; NMARK],
    pub reply: [u8; REPLY],
    /// Tab stops, one flag per column.
    ///
    /// A real table rather than the every-8 arithmetic HT used to do: HTS, TBC,
    /// CHT and CBT are meaningless without one, and `HT` after `CSI 3 g` must
    /// run to the right margin rather than to the next multiple of eight.
    pub tabs: [bool; MAX_COLS],
    /// The OSC payload being accumulated, and the two strings it can become.
    pub osc: [u8; OSC_MAX],
    pub title: [u8; OSC_MAX],
    pub icon: [u8; OSC_MAX],
    /// Palette overrides from `OSC 4`. `ColorWord::DEFAULT` means "not
    /// overridden" -- a zeroed `Storage` therefore starts on the built-in
    /// palette, with no separate `is_set` array to keep in step.
    pub palette: [ColorWord; 256],
    /// Hyperlink URIs, indexed by [`LinkId`]. Slot 0 is "no link", so a zeroed
    /// `Storage` starts with nothing linked and no separate valid array.
    pub links: [[u8; LINK_MAX]; NLINK],
    pub link_len: [ByteLen; NLINK],
    /// The alternate screen buffer, `CSI ? 1049 h`.
    ///
    /// A second full-size grid, which looks expensive and is not: it is 10 MiB
    /// of *virtual* address space, and MEASUREMENTS.md records that untouched
    /// pages of this arena cost ~0.3 MB resident. A terminal that never runs a
    /// full-screen program never faults most of it in.
    ///
    /// Placed last, on principle rather than on a measurement.
    ///
    /// Putting it straight after `vp` pushes every small hot structure --
    /// `promoted`, `tmpl`, `tabs`, `reply` -- 10 MiB further from the grid,
    /// and an erase touches the grid, `promoted` and `nrun` together. Keeping
    /// them adjacent is what "working set <= cache" asks for.
    ///
    /// **The benchmark did not resolve it.** Both placements were measured
    /// same-session: streaming showed no difference either way, and the TUI
    /// cells figures moved by more than the placement could explain while
    /// ghostty moved 2% in the same runs. Ranges overlap or the control drifted,
    /// so there is no result -- this ordering is the reasoned default, not a
    /// measured win, and it should not be quoted as one.
    ///
    /// It has **no scrollback**, which is what makes it cheaper than the
    /// primary screen rather than merely as expensive: no ring, no run table,
    /// no promotion. `[[source: ctlseqs]]` is explicit that switching clears
    /// it, so nothing here needs to survive a switch.
    pub alt: [PackedCell; GRID],
}

impl Storage {
    /// Allocate zeroed on the heap without a stack temporary.
    ///
    /// `Box::new(Storage::zeroed())` builds ~24 MB on the stack before moving
    /// it; LLVM elides that copy sometimes and not others, and a test thread
    /// overflowed on it. This is the only construction path callers should use
    /// — and it means no test or harness hand-rolls `vec![0u8; size_of::<..>()]`
    /// with a raw pointer cast.
    #[cfg(feature = "alloc")]
    pub fn boxed() -> alloc::boxed::Box<Storage> {
        use zerocopy::FromZeros;
        Storage::new_box_zeroed().expect("allocation failed")
    }

    pub const fn zeroed() -> Self {
        const R: Run = Run {
            pos: BytePos::ZERO,
            len: ByteLen::ZERO,
            style: StyleId::DEFAULT,
            encoding: 0,
            charset: 0,
            flags: 0,
            _pad: [0; 1],
        };
        const C: PackedCell = PackedCell::EMPTY;
        Storage {
            arena: [0; ARENA],
            runs: [R; SB * MAXRUN],
            nrun: [RunCount::ZERO; SB],
            vp: [C; GRID],
            alt: [C; GRID],
            promoted: [false; MAX_ROWS],
            tmpl_key: [StyleWord::DEFAULT; NSTYLE],
            tmpl_valid: [false; NSTYLE],
            // Zeroed here and populated by Term::reset_tabs, so `Storage` stays
            // a plain zeroable block for `new_box_zeroed`.
            tabs: [false; MAX_COLS],
            marks: [MarkSlot::EMPTY; NMARK],
            osc: [0; OSC_MAX],
            title: [0; OSC_MAX],
            icon: [0; OSC_MAX],
            palette: [ColorWord::DEFAULT; 256],
            links: [[0; LINK_MAX]; NLINK],
            link_len: [ByteLen::ZERO; NLINK],
            reply: [0; REPLY],
        }
    }
}
use crate::*;

impl<'a> Term<'a> {
    #[inline(always)]
    /// The rendition a cell's [`StyleId`] stands for.
    ///
    /// A renderer needs this: the cell carries an index into a 64-entry
    /// direct-mapped table, and the colours, attributes and font live in the
    /// table rather than in the cell. Reads the slot back rather than trusting
    /// the id, because the table evicts on collision -- the same check DECSCA
    /// protection needed and did not have.
    pub fn style_of(&self, cell: PackedCell) -> StyleWord {
        let i = cell.style.index();
        if self.s.tmpl_valid[i] {
            self.s.tmpl_key[i]
        } else {
            StyleWord::DEFAULT
        }
    }

    pub(crate) fn intern_style(&mut self, raw: StyleWord) -> StyleId {
        let k = StyleId::bucket(raw, NSTYLE);
        if self.s.tmpl_valid[k] && self.s.tmpl_key[k] == raw {
            self.tmpl_hits.inc();
        } else {
            self.s.tmpl_valid[k] = true;
            self.s.tmpl_key[k] = raw;
            self.tmpl_builds.inc();
        }
        StyleId::from_index(k)
    }

    pub(crate) fn apply_sgr(&mut self) {
        let n = self.nparams();
        // A `ParamIdx`, not a `usize` counter: it indexes the parameter array
        // *and* realigns the sub-parameter mask, and those two must step
        // together. Two bare integers here is how the colon form would come to
        // be read correctly for the first attribute and wrongly for the rest.
        let mut i = ParamIdx::FIRST;
        while i.raw_index() < n {
            match baud_domain::SgrAttr::parse(Params::with_subs(
                &self.params[i.raw_index()..n],
                self.psub.drop_first(i),
            )) {
                Some((attr, used)) => {
                    self.style_raw = attr.fold(self.style_raw);
                    i = i.advance(used.at_least_one_count());
                }
                None => break,
            }
        }
        self.style = self.intern_style(self.style_raw);
    }

    /// Recombine DECSCA protection with the active character set.
    ///
    /// Called whenever either input changes, so the write path can read
    /// `self.flags` as one value. Doing this per cell instead would put a
    /// second load and an OR inside the loop that `put_ascii_run` exists to
    /// keep tight.
    pub(crate) fn refresh_flags(&mut self) {
        let base = match self.g[self.gl.index()] {
            Charset::DecGraphics => self.protect.with(CellFlags::GRAPHICS),
            _ => self.protect,
        };
        self.flags = base.with_link(self.link);
    }
}
use crate::*;

impl<'a> Term<'a> {
    /// Default stops every eight columns, which is what a terminal powers on
    /// with and what RIS restores.
    pub(crate) fn reset_tabs(&mut self) {
        for (i, stop) in self.s.tabs.iter_mut().enumerate() {
            *stop = i % 8 == 0 && i != 0;
        }
    }

    /// HT, and the engine of CHT. Advances to the next stop, or to the last
    /// column when there is none left -- never past the margin.
    pub(crate) fn tab_forward(&mut self, n: Count) {
        let last = self.cols.index() - 1;
        // There cannot be more stops than columns, so a larger count is the
        // same as `cols`. Without this, `CSI 65535 I` spins 65535 times once
        // the cursor is already at the margin -- bounded, but work a stream
        // should not be able to ask for.
        for _ in 0..n.at_least_one().min(self.cols.index()) {
            let mut x = self.cx.index();
            loop {
                if x >= last {
                    x = last;
                    break;
                }
                x += 1;
                if self.s.tabs[x] {
                    break;
                }
            }
            self.cx = Col::at_index(x);
        }
    }

    /// CBT. Backward to the previous stop, or to column 0.
    pub(crate) fn tab_back(&mut self, n: Count) {
        for _ in 0..n.at_least_one().min(self.cols.index()) {
            let mut x = self.cx.index();
            loop {
                if x == 0 {
                    break;
                }
                x -= 1;
                if self.s.tabs[x] {
                    break;
                }
            }
            self.cx = Col::at_index(x);
        }
    }
}
use crate::*;

/// Largest geometry the fixed viewport can hold.
///
/// Sized against real limits, not guessed: 8K (7680x4320) at a 4x8 px font is
/// 1920x540, which is the smallest font anyone can read on the largest display
/// sold. `TIOCSWINSZ` caps `ws_col`/`ws_row` at 65535, so this is a policy
/// choice, not a protocol one.
///
/// Costs nothing until touched. `Storage` is 13.9 MB *virtual*; measured RSS
/// after allocating it, initialising a 50x200 grid and feeding data was
/// **+0.3 MB total** — untouched pages are never faulted in. Throughput is
/// unchanged from the old 400x120 (203.5 vs 205.9 MB/s, ranges overlapping).
///
/// The previous values truncated 1440p at a small font *silently*, which is why
/// [`Term::resize`] now returns [`Resized`].
pub const MAX_COLS: usize = 2048;

pub const MAX_ROWS: usize = 640;

pub const SB: usize = 10_000;

pub const ARENA: usize = 1 << 20;

pub const MAXRUN: usize = 8;

/// Cells in one screen buffer.
///
/// Named because two buffers must be the same size -- switching screens is a
/// pointer swap and nothing rechecks the geometry -- and because `vp` and `alt`
/// having literally the same expression is the invariant, not a coincidence.
pub const GRID: usize = MAX_ROWS * MAX_COLS;

/// Which screen buffer is active.
///
/// `[[source: ctlseqs]]` calls them the Normal and Alternate Screen Buffers. A
/// `bool` at these call sites would read as `if self.alt`, which says nothing
/// about what the other branch is.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum Screen {
    Normal,
    Alternate,
}

/// Bytes of pending reply the core will hold for the caller.
///
/// Queries are rare and their answers are short -- the longest baud produces is
/// a CPR at 12 bytes -- but a stream can send many in one read, so this is sized
/// for a burst rather than for one. Overflow is counted, never silent.
pub const REPLY: usize = 256;

pub const NSTYLE: usize = 64;

/// Longest OSC payload the core keeps.
///
/// Every byte of an OSC is attacker-controlled -- a window title is whatever
/// the far end of an ssh session sent -- and a `no_std` core cannot grow a
/// buffer to meet it. Overlong payloads are **truncated, not rejected**: a
/// 4 KiB title should become a short title, not a dropped sequence, because
/// dropping it leaves the previous title showing and the user with no signal.
/// Sized well past any real title.
pub const OSC_MAX: usize = 512;

/// Distinct hyperlinks a screen can hold at once, and the longest URI kept.
///
/// **Bounded by construction, like the style table and for the same reason.**
/// `CLAUDE.md` records a growable style table as "the content-addressing
/// failure mode again": a structure keyed on attacker-supplied content that
/// grows without limit walks out of cache and then out of memory. A URI is
/// exactly that kind of key. `NLINK` slots evict on collision, so a page that
/// cycles through thousands of links costs the same as one with four.
///
/// 128 x 256 B is 32 KiB, which fits beside the style table rather than
/// competing with the grid.
pub const NLINK: usize = 128;

/// Combining marks attached to cells, and the most any one cell may carry.
///
/// **A cell has no room for these.** `PackedCell` is eight bytes and that
/// number is measured; `CellFlags` is fully allocated, two bits of flags and
/// fourteen of `LinkId`. So the marks live beside the grid rather than in it,
/// in a direct-mapped table keyed on the cell's position.
///
/// Bounded and evicting on collision, for the reason `NLINK` and `NSTYLE` are:
/// the key is attacker-supplied — a page can emit as many combining marks as it
/// likes — and a growable table under that pressure is the content-addressing
/// failure mode `CLAUDE.md` already refuses. A cell whose slot was taken loses
/// its marks; it does not lose its base character, and nothing grows without
/// bound.
///
pub const NMARK: usize = 512;

pub const LINK_MAX: usize = 256;

pub const READ_CHUNK: usize = baud_domain::SLOT_BYTES;

#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum OpMode {
    Computed,
    Templated,
    Runs,
}

/// Outcome of a [`Term::resize`].
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
#[must_use]
pub enum Resized {
    Ok,
    /// The window is larger than the fixed viewport. The grid was clamped to
    /// the geometry given; the caller should surface this rather than render a
    /// terminal that disagrees with the application about its own size.
    Truncated {
        cols: Cols,
        rows: Rows,
    },
}

pub struct Term<'a> {
    pub(crate) s: &'a mut Storage,
    pub(crate) tail: ArenaTail,
    pub(crate) head: RingPos,
    pub(crate) cx: Col,
    pub(crate) cy: Row,
    pub(crate) cols: Cols,
    pub(crate) rows: Rows,
    pub(crate) st: State,
    pub(crate) params: [Option<Param>; ParamIdx::CAPACITY],
    /// How many parameter positions the current sequence has produced.
    ///
    /// **Not** how many are readable: it saturates one past
    /// [`ParamIdx::CAPACITY`], so "sixteen arrived" and "more than sixteen
    /// arrived" stay distinguishable. Read it through [`Term::nparams`], never
    /// directly -- `&self.params[..n]` with the raw value panics.
    pub(crate) nparam: ParamIdx,
    /// Bit `i` set when parameter `i` followed a colon rather than a semicolon.
    /// See `Params::is_sub` -- the colon form of direct colour carries an extra
    /// colour-space identifier, so the separator changes the meaning.
    pub(crate) psub: SubParams,
    /// Bytes of `s.osc` filled so far, and the lengths of the two strings.
    pub(crate) osc_len: ByteLen,
    /// OSC payloads that overflowed `OSC_MAX`.
    ///
    /// A counter rather than a flag, matching `reply_overflows`: truncation is
    /// the correct behaviour but it should never be *invisible*, and a count
    /// survives the next OSC where a flag would be cleared by it.
    pub osc_truncations: Stat,
    pub(crate) title_len: ByteLen,
    pub(crate) icon_len: ByteLen,
    /// Which terminator the current OSC arrived with. `[[source: ctlseqs]]`:
    /// when returning information xterm "uses the same terminator used in a
    /// query", so a reply must remember how the question ended.
    pub(crate) osc_term: StringTerm,
    /// The final byte of the DCS currently being collected.
    pub(crate) dcs_final: Option<FinalByte>,
    pub(crate) private: Marker,
    pub(crate) style: StyleId,
    pub(crate) style_raw: StyleWord,
    /// DECSCUSR. Not a rendition -- it describes the cursor, not the text.
    pub(crate) cursor_style: CursorStyle,
    /// Which buffer writes and reads go to.
    pub(crate) screen: Screen,
    /// The cursor DECSC-style state saved when switching *to* the alt screen.
    ///
    /// Separate from `saved`, which belongs to DECSC/DECRC: an application that
    /// saves the cursor, switches screens and restores must get its own saved
    /// cursor back, not the one the switch stashed.
    pub(crate) alt_saved: Option<(Row, Col, StyleId, StyleWord, CellFlags)>,
    /// DECKPAM/DECKPNM. Input-side, so the core records it and an embedder
    /// reads it -- the keypad sends different sequences in each mode, and
    /// without it an embedder has no way to know which.
    pub(crate) keypad: KeypadMode,
    /// ANSI or VT52. DECANM, `CSI ? 2 l` enters VT52.
    pub(crate) terminal_mode: TerminalMode,
    /// Which mouse events the application asked to hear about, `?1000/2/3`.
    pub(crate) mouse: MouseTracking,
    /// The negotiated encoding. Without one baud reports nothing -- see
    /// [`Report::MouseSgr`].
    pub(crate) mouse_encoding: MouseEncoding,
    /// `?1001`, and the region the application last gave with XTHIMOUSE.
    pub(crate) highlight: HighlightTracking,
    pub(crate) highlight_region: HighlightRegion,
    /// Mouse events dropped because no encoding was negotiated.
    ///
    /// Counted rather than silent: an application that enables tracking and
    /// gets nothing back should be diagnosable from the outside.
    pub mouse_unencodable: Stat,
    /// `OSC 52` clipboard reads, which baud refuses on purpose.
    ///
    /// **The silence is right and the invisibility was not.** Answering a
    /// clipboard query with anything, empty string included, tells a remote
    /// program the feature works and it will keep asking -- so no reply is the
    /// correct answer to the *application*. Being unable to tell afterwards
    /// that one was asked is a different thing, and it is the failure
    /// `docs/vt-coverage.md` refuses everywhere else. An embedder that wants to
    /// implement the clipboard needs to know the requests are arriving.
    pub clipboard_reads_refused: Stat,
    /// `OSC 52` clipboard writes, which baud drops: it has no clipboard, and
    /// the payload is not kept. Counted for the same reason.
    pub clipboard_writes_dropped: Stat,
    /// Sequences the parser recognised and did **not** act on.
    ///
    /// This is the `parsed` failure made countable. `docs/vt-coverage.md` calls
    /// a sequence that is accepted, does nothing, and gives the application no
    /// way to find out "worse than one that is not implemented" -- but until
    /// now nothing could observe it happening. `tests/conformance/` asserts
    /// this stays zero while replaying every output capability of the terminfo
    /// entries baud claims.
    pub unsupported: Stat,
    /// Operations baud **recognises** but with a parameter it does not
    /// implement: `CSI 1 h` is a real SM, and mode 1 is not one baud has.
    ///
    /// Separate from [`Term::unsupported`] because the two are different
    /// questions and conflating them broke both. "I do not know this sequence"
    /// is what the terminfo conformance suite asks; "I know it but not this
    /// parameter" is what an inventory against the specification asks. Folding
    /// the second into the first made rxvt's reset string --
    /// `CSI 1;3;4;5;6 l`, four modes baud does not implement -- look like a
    /// conformance failure, when what it really shows is baud declining four
    /// modes it never claimed.
    pub unsupported_param: Stat,
    /// Combining marks that could not be stored: no base character, or the
    /// cell already held [`MARKS_PER_CELL`].
    pub marks_dropped: Stat,
    /// Marks displaced from a slot another cell was using. Bounded tables
    /// evict; counting it is how the bound stays visible.
    pub marks_evicted: Stat,
    /// Whether replies use 7-bit or 8-bit C1 introducers. Set by S7C1T/S8C1T.
    pub(crate) c1: C1Transmit,
    /// Locale policy for East Asian Ambiguous width. Not a mode an application
    /// can set: `[[source: uax11]]` § 5 makes it a property of the *reader's*
    /// context, so it belongs to the embedder.
    pub(crate) width: WidthTable,
    /// Where cluster boundaries fall. Carried across `put_cp` calls because
    /// five of `[[source: uax29]]`'s rules need more than the previous
    /// codepoint -- see [`ClusterBreak`].
    pub(crate) cluster: ClusterBreak,
    /// How incoming bytes become characters. `ESC % G` / `ESC % @` switch it.
    pub(crate) encoding: InputEncoding,
    /// The four designatable character-set slots, and which one is invoked
    /// into GL.
    ///
    /// `[[source: ctlseqs]]`: `ESC ( C` designates G0, `ESC ) C` G1, `ESC * C`
    /// G2, `ESC + C` G3; SO invokes G1 into GL and SI invokes G0.
    pub(crate) g: [Charset; 4],
    pub(crate) gl: GSlot,
    /// The hyperlink `OSC 8` opened, if one is open.
    pub(crate) link: LinkId,
    /// DECSCA protection alone, before the charset is folded in.
    ///
    /// Kept apart from `flags` so that changing either input recomputes the
    /// combination in one place -- `flags` is read on the hot path and must
    /// stay a single load.
    pub(crate) protect: CellFlags,
    /// DECSCA, and anything else that is per-cell state rather than rendition.
    ///
    /// Stamped onto every character written, so protection survives style
    /// eviction -- `tmpl_key` is a direct-mapped cache with one slot per
    /// bucket, and reading protection back out of it would answer with
    /// whichever style displaced the original.
    pub(crate) flags: CellFlags,
    pub(crate) saved: Option<(Row, Col, StyleId, StyleWord, CellFlags)>,
    /// DECSTBM. Inclusive, and full-screen until `CSI r` says otherwise.
    pub(crate) scroll_top: Row,
    pub(crate) scroll_bot: Row,
    /// DECSLRM. Inclusive, and full-width until `CSI Pl ; Pr s` says otherwise
    /// -- and only then if DECLRMM is set.
    pub(crate) left_margin: Col,
    pub(crate) right_margin: Col,
    /// A bitset rather than a struct of bools -- see [`Modes`].
    pub(crate) modes: Modes,
    pub(crate) mode: OpMode,
    /// Bytes handed to `feed`, and cells and runs written because of them.
    ///
    /// Rule #1 is write amplification <= 1 byte written per byte ingested, and
    /// it is the first thing `README.md` says every result here is predicted
    /// by. It had no measurement: the old instrumentation printed
    /// `inf x amplification` from counters nothing fed and was removed rather
    /// than repaired, so the number the architecture is justified by has been
    /// unverifiable since.
    ///
    /// Counted in bulk -- one `add` per run, not per cell -- because the
    /// per-cell loop is the one a runtime flag cost 5% of.
    pub bytes_in: Stat,
    /// How many slots were handed out, i.e. how many `read(2)` calls the
    /// embedder made. With `bytes_in` it gives the mean read size, which is
    /// the tty's batching and not baud's doing.
    pub reads: Stat,
    /// Which of the three paths in `feed_with` those bytes took.
    ///
    /// The loop has exactly three exits: a bulk printable run, a complete
    /// escape sequence recognised in one go, and everything else one byte at a
    /// time through `control`. Cost attribution needs to know the split,
    /// because "the parser is slow" and "one path is slow and gets most of the
    /// bytes" want opposite fixes.
    ///
    /// Counted per *iteration*, not per byte -- one `add(run)` rather than
    /// `run` increments -- so the bulk path pays one add for a whole run.
    pub bytes_bulk: Stat,
    /// Bytes consumed by `fast_csi` / `fast_esc`, a sequence at a time.
    pub bytes_seq: Stat,
    /// Bytes that reached `control` individually. The expensive path.
    pub bytes_slow: Stat,
    /// Bytes that reach the **UTF-8 decoder** -- a multi-byte lead or one of
    /// its continuations.
    ///
    /// Not the same as `bytes_slow`. A byte can take the byte-at-a-time path
    /// for many reasons and most of them are control sequences; this counts
    /// only the ones a vectorised UTF-8 validator could ever speed up, which
    /// is what sizes `docs/research/notes/a-simd-parsing.md`'s proposal.
    /// ASCII is excluded on purpose: it is one compare and never enters the
    /// accumulator.
    pub bytes_utf8: Stat,
    /// Bytes consumed by `fast_utf8` -- a whole multi-byte character decoded
    /// without a state-machine dispatch per byte.
    ///
    /// A fourth exit from `feed_with`, and it needs its own counter rather
    /// than joining `bytes_bulk`: that one means "an ASCII run through
    /// `put_run`", which is a different code path with a different cost, and
    /// the recorded 19/66/15 splits would stop being comparable if the
    /// meaning moved under them.
    pub bytes_text: Stat,
    /// Cells written by `put_ascii_run` -- the bulk text path.
    ///
    /// **Attribution, not a total.** `cells_written` says how many cells were
    /// stored and the amplification figures divide it by bytes in; it does not
    /// say *which* path stored them, and the three have completely different
    /// costs per cell. A profile of the cells path puts `put_ascii_run` at 33%
    /// and `scroll_region_up` at 17%, so knowing the cell counts behind those
    /// two is what turns a time share into a cost per cell.
    pub cells_bulk: Stat,
    /// Cells written one at a time by `put_cp`: anything that is not a run of
    /// printable ASCII, so wide characters, combining marks and `REP`.
    pub cells_single: Stat,
    /// Cells written by scrolling, erasing and blanking -- `fill` and
    /// `fill_row`. Overlaps `cells_blanked` by construction; kept separate so
    /// the three attribution counters sum to `cells_written`.
    pub cells_fill: Stat,
    /// The scrolling *subset* of `cells_fill`: rows blanked because a scroll
    /// brought a new one in.
    ///
    /// A subset and not a fourth bucket, so the attribution still sums to
    /// `cells_written`. Erase and clear are `cells_fill - cells_scroll`, and
    /// separating them matters because they are different problems: a scroll
    /// blank is driven by how often the payload scrolls, an erase by what the
    /// application asks for.
    pub cells_scroll: Stat,
    /// How many times a scroll happened. `cells_scroll / scrolls` is the width
    /// actually blanked per scroll, which is the number the blanking
    /// experiments in `CLAUDE.md` were all about.
    pub scrolls: Stat,
    /// Completed CSI dispatches.
    ///
    /// The profile puts `dispatch` at 17% of the cells path on
    /// `payload::streaming`, where `path_split` says escape sequences are 2%
    /// of the bytes -- so a dispatched sequence costs roughly eight times a
    /// text byte, and the payload's SGR density (one every 37 bytes) is
    /// *lower* than real capture's. This is what turns that ratio into a cost
    /// per dispatch.
    pub dispatches: Stat,
    /// SGR dispatches, the subset that only changes the rendition.
    ///
    /// Separated because the profile says the *arms* of `dispatch` cost 20% of
    /// btop's cells path and `Csi::parse_with` only 6%, so which arm runs is
    /// the question. btop draws in truecolour, so the guess is SGR -- and a
    /// guess about which arm is hot is exactly what a counter settles.
    pub sgr_dispatches: Stat,
    /// Cells written to the grid. Multiply by `size_of::<PackedCell>()`.
    pub cells_written: Stat,
    /// Of those, the ones written to *blank* rather than to carry text.
    ///
    /// Separated because the two answer different questions. Materialising a
    /// character is a floor -- one ASCII byte becomes an eight-byte
    /// `PackedCell`, so a cell mode cannot be under 8x and rule #1 was never
    /// about that. Blanking is not a floor: it is what scrolling costs, and on
    /// a streaming payload it turns out to be *all* of the cell traffic.
    pub cells_blanked: Stat,
    /// Runs stored in the span table. Multiply by `size_of::<Run>()`.
    ///
    /// Only `OpMode::Runs` writes these; the materialising modes write cells
    /// instead, so the two counters are alternatives rather than a sum.
    pub runs_written: Stat,
    pub promotions: Stat,
    pub tmpl_builds: Stat,
    pub tmpl_hits: Stat,
    pub maxrun_overflows: Stat,
    pub replacements: Stat,
    // why the fast CSI path declined, so the fallback rate is measurable
    pub fast_hits: Stat,
    pub bells: Stat,
    /// How much of `Storage::reply` is pending.
    pub(crate) reply_len: ByteLen,
    /// Replies dropped because the buffer was full. Counted so a caller that
    /// never drains can find out, instead of losing answers silently.
    pub reply_overflows: Stat,
    /// The intermediate byte of the `ESC` sequence being parsed.
    pub(crate) esc_inter: Option<StreamByte>,
    /// The **second** intermediate of an escape sequence.
    ///
    /// `[[source: williams]]`'s `escape_intermediate` collects intermediates,
    /// plural; baud kept only the last, so `ESC ( % 6` overwrote the `(` and
    /// the G-slot was lost before the final byte arrived. Every multi-byte
    /// charset final -- Portuguese, Greek, DEC Cyrillic and the rest -- was
    /// unreachable for that reason rather than by decision.
    pub(crate) esc_inter2: Option<StreamByte>,
    /// How far the primary grid is rotated. See [`RowRot`].
    pub(crate) rot: RowRot,
    /// The last graphic character written, for REP.
    ///
    /// `[[source: ctlseqs]]`: "Repeat the preceding graphic character Ps
    /// times". `None` when nothing has been printed yet, in which case REP has
    /// nothing to repeat and must do nothing rather than repeat a stale cell.
    pub(crate) last_cp: Option<(Codepoint, Width)>,
    /// The intermediate byte of the CSI being parsed, if any. `CSI ! p` is
    /// DECSTR and `CSI p` is not the same operation.
    pub(crate) csi_inter: Option<StreamByte>,
    pub fb_not_csi: Stat,
    pub fb_boundary: Stat,
    pub fb_odd_param: Stat,
}

impl<'a> Term<'a> {
    /// How many parameters are readable, clamped to the array's capacity.
    ///
    /// `nparam` counts positions *seen* and stands one past capacity when a
    /// sequence sent more than [`ParamIdx::CAPACITY`] of them, so slicing
    /// `params` with the raw count panics. Every consumer goes through here.
    pub(crate) fn nparams(&self) -> usize {
        self.nparam.count_at_least_one().min(ParamIdx::CAPACITY)
    }

    pub fn new(s: &'a mut Storage, mode: OpMode) -> Self {
        let (cols, rows) = WinSize {
            ws_row: 50,
            ws_col: 200,
        }
        .geometry();
        let mut t = Term {
            s,
            tail: ArenaTail::ZERO,
            head: RingPos::ZERO,
            cx: Col::ZERO,
            cy: Row::ZERO,
            cols: cols.clamp(MAX_COLS),
            rows: rows.clamp(MAX_ROWS),
            st: State::Ground,
            params: [None; ParamIdx::CAPACITY],
            nparam: ParamIdx::FIRST,
            psub: SubParams::NONE,
            osc_len: ByteLen::ZERO,
            osc_truncations: Stat::ZERO,
            title_len: ByteLen::ZERO,
            icon_len: ByteLen::ZERO,
            osc_term: StringTerm::St,
            dcs_final: None,
            private: Marker::Standard,
            style: StyleId::DEFAULT,
            style_raw: StyleWord::DEFAULT,
            cursor_style: CursorStyle::BlinkingBlock,
            screen: Screen::Normal,
            alt_saved: None,
            keypad: KeypadMode::Numeric,
            terminal_mode: TerminalMode::Ansi,
            mouse: MouseTracking::Off,
            mouse_encoding: MouseEncoding::X10,
            highlight: HighlightTracking::Off,
            highlight_region: HighlightRegion::default(),
            mouse_unencodable: Stat::ZERO,
            clipboard_reads_refused: Stat::ZERO,
            clipboard_writes_dropped: Stat::ZERO,
            unsupported: Stat::ZERO,
            unsupported_param: Stat::ZERO,
            marks_dropped: Stat::ZERO,
            marks_evicted: Stat::ZERO,
            c1: C1Transmit::SevenBit,
            width: WidthTable::default(),
            cluster: ClusterBreak::new(),
            encoding: InputEncoding::Utf8,
            g: [Charset::Ascii; 4],
            gl: GSlot::G0,
            link: LinkId::NONE,
            protect: CellFlags::NONE,
            flags: CellFlags::NONE,
            saved: None,
            scroll_top: Row::ZERO,
            scroll_bot: Row::from_index(rows.clamp(MAX_ROWS).index() - 1),
            left_margin: Col::ZERO,
            right_margin: Col::at_index(cols.clamp(MAX_COLS).index() - 1),
            modes: Modes::default(),
            mode,
            bytes_in: Stat::ZERO,
            reads: Stat::ZERO,
            bytes_bulk: Stat::ZERO,
            bytes_seq: Stat::ZERO,
            bytes_slow: Stat::ZERO,
            bytes_utf8: Stat::ZERO,
            bytes_text: Stat::ZERO,
            cells_bulk: Stat::ZERO,
            cells_single: Stat::ZERO,
            cells_fill: Stat::ZERO,
            cells_scroll: Stat::ZERO,
            scrolls: Stat::ZERO,
            dispatches: Stat::ZERO,
            sgr_dispatches: Stat::ZERO,
            cells_written: Stat::ZERO,
            cells_blanked: Stat::ZERO,
            runs_written: Stat::ZERO,
            promotions: Stat::ZERO,
            tmpl_builds: Stat::ZERO,
            tmpl_hits: Stat::ZERO,
            maxrun_overflows: Stat::ZERO,
            replacements: Stat::ZERO,
            fast_hits: Stat::ZERO,
            bells: Stat::ZERO,
            reply_len: ByteLen::ZERO,
            reply_overflows: Stat::ZERO,
            csi_inter: None,
            last_cp: None,
            esc_inter: None,
            esc_inter2: None,
            rot: RowRot::NONE,
            fb_not_csi: Stat::ZERO,
            fb_boundary: Stat::ZERO,
            fb_odd_param: Stat::ZERO,
        };
        t.reset_tabs();
        t.clear_screen();
        t
    }

    /// BEL characters seen. There is no UI here to ring one.
    pub fn bells(&self) -> u64 {
        self.bells.count()
    }

    /// Bytes written to the grid per byte ingested.
    ///
    /// Rule #1 is that this stays at or below 1. It is the first thing
    /// `README.md` says every result here is predicted by, and it has had no
    /// measurement since the old counters were removed for printing
    /// `inf x amplification` -- so the quantity the architecture is justified
    /// by has been an assertion rather than a reading.
    ///
    /// Cells and runs are alternatives, not a sum: `OpMode::Runs` stores spans
    /// and the materialising modes store cells, so on any one run only one of
    /// the two is non-zero. Both are included so the caller does not have to
    /// know which mode it asked for.
    ///
    /// Zero bytes in gives zero rather than a division by it -- an empty run
    /// has no amplification, and `inf` is what the last version printed.
    /// Bytes of *span table* written per byte ingested.
    ///
    /// **This is the one rule #1 is about.** A run costs `size_of::<Run>()`
    /// however many bytes it covers, so it amortises: on a streaming payload
    /// it measures about 0.08x. A cell mode cannot compete and is not trying
    /// to -- materialising one ASCII byte into an eight-byte `PackedCell` is a
    /// floor of 8x, which is the cost of having a grid rather than a log.
    /// Are two parsers in the same state?
    ///
    /// Exposed for one measurement: `notes/b-data-parallel-fsm.md` proposes
    /// vectorising the state machine by enumerating every possible start state
    /// at once, and that pays only if runs from different starts **converge**
    /// quickly -- `[[source: dpfsm]]` § 5.2 says convergence is common and
    /// convergence to a single state is rare, on their inputs. Whether it holds
    /// on VT streams is one of that note's open questions, and answering it
    /// needs to compare two parsers fed the same bytes from different starts.
    ///
    /// Equality rather than an identifier on purpose. Convergence is a question
    /// about *sameness*, so this answers exactly that and leaks neither the
    /// state space nor its numbering -- and `State` stays `pub(crate)`, which
    /// it should, because nothing outside the parser has any business
    /// branching on it.
    pub fn same_parser_state(&self, other: &Term<'_>) -> bool {
        self.st == other.st
    }

    /// What share of the input took each of `feed_with`'s three paths.
    ///
    /// `(bulk, sequences, byte-at-a-time)`, summing to 1. The third is the one
    /// that costs: it runs the full state machine per byte, and a payload that
    /// sends most of its bytes there is one the fast paths are missing.
    pub fn path_split(&self) -> (f64, f64, f64, f64) {
        let n = self.bytes_in.count();
        if n == 0 {
            return (0.0, 0.0, 0.0, 0.0);
        }
        let f = |x: u64| x as f64 / n as f64;
        (
            f(self.bytes_bulk.count()),
            f(self.bytes_seq.count()),
            f(self.bytes_slow.count()),
            f(self.bytes_text.count()),
        )
    }

    /// The share of input that reaches the UTF-8 decoder.
    ///
    /// The number that decides whether a vectorised validator is worth
    /// building: the literature's 10x applies to these bytes and no others.
    /// Where the written cells came from, as shares of `cells_written`.
    ///
    /// `(bulk, single, fill)`. They sum to 1.0 when every write site is
    /// attributed, and `cell_attribution_accounts_for_every_write` asserts it
    /// -- the same invariant `path_split` carries, and for the same reason: an
    /// unattributed write is one nobody will think to look for.
    pub fn cell_attribution(&self) -> (f64, f64, f64) {
        let n = self.cells_written.count();
        if n == 0 {
            return (0.0, 0.0, 0.0);
        }
        let f = |x: u64| x as f64 / n as f64;
        (
            f(self.cells_bulk.count()),
            f(self.cells_single.count()),
            f(self.cells_fill.count()),
        )
    }

    pub fn utf8_share(&self) -> f64 {
        let n = self.bytes_in.count();
        match n {
            0 => 0.0,
            _ => self.bytes_utf8.count() as f64 / n as f64,
        }
    }

    /// Mean bytes per `read(2)`. The transport's batching, not the parser's.
    pub fn mean_read(&self) -> f64 {
        match self.reads.count() {
            0 => 0.0,
            r => self.bytes_in.count() as f64 / r as f64,
        }
    }

    pub fn span_amplification(&self) -> f64 {
        self.per_byte(self.runs_written.count() * core::mem::size_of::<Run>() as u64)
    }

    /// Bytes of *grid* written per byte ingested, and the share of it that is
    /// blanking rather than text.
    ///
    /// The second number is the interesting one. Scrolling blanks the incoming
    /// row, which costs `cols` cells every time the screen moves up, and on a
    /// streaming payload that is the entire cell budget -- the text itself
    /// goes into spans. Blanking is therefore the thing to attack, not the
    /// storing.
    pub fn cell_amplification(&self) -> (f64, f64) {
        let w = core::mem::size_of::<PackedCell>() as u64;
        (
            self.per_byte(self.cells_written.count() * w),
            self.per_byte(self.cells_blanked.count() * w),
        )
    }

    /// Zero bytes in gives zero rather than dividing by it. `inf` is what the
    /// instrumentation this replaces printed for several sessions.
    fn per_byte(&self, written: u64) -> f64 {
        match self.bytes_in.count() {
            0 => 0.0,
            n => written as f64 / n as f64,
        }
    }

    pub fn fast_hits(&self) -> u64 {
        self.fast_hits.count()
    }

    /// Escapes that fell back because they were not `ESC [`.
    pub fn fb_not_csi(&self) -> u64 {
        self.fb_not_csi.count()
    }

    /// Escapes that fell back because the sequence crossed the read boundary.
    pub fn fb_boundary(&self) -> u64 {
        self.fb_boundary.count()
    }

    /// Resize. Changes geometry only; the allocation is untouched.
    ///
    /// Returns [`Resized::Truncated`] when the requested geometry exceeds
    /// [`MAX_COLS`]/[`MAX_ROWS`]. Silently clamping was the old behaviour and it
    /// produces a terminal that renders a smaller grid than the application
    /// believes it has — the cursor drifts and nothing says why.
    #[must_use = "Resized::Truncated means the geometry exceeded MAX_COLS/MAX_ROWS; ignoring it is the silent-clamp bug this return value replaced"]
    pub fn resize(&mut self, ws: &WinSize) -> Resized {
        let (c, r) = ws.geometry();
        let over = c.index() > MAX_COLS || r.index() > MAX_ROWS;
        self.cols = c.clamp(MAX_COLS);
        self.rows = r.clamp(MAX_ROWS);
        self.cx = Col::ZERO;
        self.cy = Row::ZERO;
        // A scrolling region is expressed in rows that may no longer exist.
        // xterm resets DECSTBM to the full screen on resize; keeping a stale
        // bottom row would leave the region pointing off the grid.
        self.scroll_top = Row::ZERO;
        self.scroll_bot = Row::from_index(self.rows.index() - 1);
        self.reset_side_margins();
        // **Before `clear_screen`, and not optional.** `rot` is bounded by the
        // *old* row count, so shrinking the window can leave it at or past the
        // new one -- and `View::phys` is a single conditional subtract,
        // deliberately, because both operands are normally below `rows`. Past
        // that point it returns a row outside the grid, so `clear_screen`
        // blanks rows nobody can see and `viewport`'s `rotate_left` panics
        // outright: 41 rows of rotation against a ten-row slice.
        //
        // Scroll a screenful, then make the window smaller: that is a
        // full-screen application and a user dragging a corner. The grid is
        // cleared here anyway, so there is nothing for a rotation to mean.
        self.rot = RowRot::NONE;
        // **Both buffers, not just the one on screen.**
        //
        // Discarding the rotation is only sound if the buffer it described is
        // cleared too. `clear_screen` clears whichever screen is current, so
        // resizing while on the alternate screen left the *primary* holding
        // rotated content with `rot` back at zero -- every row displaced, and
        // only for applications that resize while in full-screen mode, which
        // is most of them.
        let showing = self.screen;
        for s in [Screen::Normal, Screen::Alternate] {
            self.screen = s;
            self.clear_screen();
        }
        self.screen = showing;
        if over {
            Resized::Truncated {
                cols: self.cols,
                rows: self.rows,
            }
        } else {
            Resized::Ok
        }
    }

    /// Where the cursor is, as the protocol understands it.
    ///
    /// Clamped to the last column, which matters in exactly one state. With
    /// autowrap on, `self.cx` sits one *past* the last column after a character
    /// lands there -- the deferred-wrap sentinel the next write consumes. That
    /// position is an implementation device, not a place the protocol has:
    /// `[[source: vt510-decawm]]` describes the wrap as happening to "graphic
    /// characters received when the cursor is at the right border of the page",
    /// so the cursor is *at* the border, not beyond it. A 200-column page has
    /// no column 201.
    ///
    /// This is the difference between an internal flag and an answer. CPR goes
    /// through here, and reporting a column that does not exist is the
    /// wrong-shaped reply that `docs/vt-coverage.md` rules out -- an
    /// application that asks where the cursor is and moves it back gets a
    /// one-column drift, silently, only on full lines. An embedder drawing the
    /// cursor would put it off-screen for the same reason.
    pub fn cursor(&self) -> (Row, Col) {
        let last = Col::at_index(self.cols.index() - 1);
        (self.cy, Col::at_index(self.cx.index().min(last.index())))
    }

    pub fn geometry(&self) -> (Cols, Rows) {
        (self.cols, self.rows)
    }

    pub fn stride(&self) -> Cols {
        Cols::from_stride(MAX_COLS)
    }

    /// The whole materialised region, stride included. Callers wanting a single
    /// row should use [`Term::row`], which is bounds-correct by construction.
    /// The visible grid, as one contiguous slice.
    ///
    /// **Takes `&mut self`, and that is the whole trick.** A full-screen scroll
    /// rotates an index rather than moving cells, so ingest never pays for it;
    /// the rotation has to be undone exactly once before the cells can be
    /// handed out as a slice, and that happens here. A renderer calls this once
    /// a frame, where the old code copied the grid once a *scroll* -- which on
    /// a streaming payload is every screenful, and cost 45% of cell ingest.
    ///
    /// `rotate_left` is in-place and allocation-free, which `no_std` requires.
    pub fn viewport(&mut self) -> &[PackedCell] {
        if self.screen == Screen::Normal && self.rot != RowRot::NONE {
            let n = self.rot.index() * self.stride().index();
            let len = self.rows.index() * self.stride().index();
            self.s.vp[..len].rotate_left(n);
            self.rot = RowRot::NONE;
        }
        let b = if self.screen == Screen::Alternate {
            &self.s.alt
        } else {
            &self.s.vp
        };
        RowBlock::leading(self.rows, self.stride()).of(b)
    }

    /// One row of the grid.
    ///
    /// **`y` must be below `geometry().1`.** The buffer is `MAX_ROWS` deep and
    /// the grid is `rows` deep, so an index between them is allocated memory
    /// that is not part of the screen -- it returns cells rather than an error,
    /// which is the wrong-shape failure this project rules out for replies.
    /// `viewport` is the bounded accessor and does not have this edge.
    ///
    /// Left as a precondition rather than an `Option` because that is a
    /// published signature; `row_past_the_grid_is_a_documented_sharp_edge`
    /// pins the current behaviour so a change to it is deliberate. Use
    /// [`Term::get_row`] where the index is not already known to be in range.
    pub fn row(&self, y: Row) -> &[PackedCell] {
        let b = if self.screen == Screen::Alternate {
            &self.s.alt
        } else {
            &self.s.vp
        };
        let rot = if self.screen == Screen::Alternate {
            RowRot::NONE
        } else {
            self.rot
        };
        View::new_ref(b, self.stride(), self.cols, self.rows, rot).row_slice(y)
    }

    /// One row of the grid, or `None` if `y` is not on it.
    ///
    /// The `get`/index pair `slice` already trains everyone on: [`Term::row`]
    /// takes the index on trust, this one checks it. Worth having because the
    /// unchecked form does not fail loudly -- the buffer is `MAX_ROWS` deep and
    /// the grid is `rows` deep, so an index between them is allocated memory
    /// that is not on screen and comes back looking like cells.
    ///
    /// An embedder that caches a row count across a resize is the case this
    /// exists for, and it is not hypothetical: a stale bound is what turned a
    /// shrink into a panic in `viewport` and an out-of-grid cursor in DECRC.
    pub fn get_row(&self, y: Row) -> Option<&[PackedCell]> {
        match y.index() < self.rows.index() {
            true => Some(self.row(y)),
            false => None,
        }
    }

    /// Is the alternate screen showing? `CSI ? 1049`.
    pub fn screen(&self) -> Screen {
        self.screen
    }

    #[inline(always)]
    /// Hand out the next slot for a [`baud_domain::Source`] to fill.
    ///
    /// A [`Slot`], not a `&mut [u8]`: the length is [`READ_CHUNK`] rather than
    /// whatever the caller passes, and reporting how much arrived goes through
    /// [`Filled`], which cannot exceed the slot it came from.
    pub fn read_slot(&mut self) -> Slot<'_> {
        self.reads.inc();
        self.tail = self.tail.next_slot(ARENA);
        let base = self.tail.index();
        let pos = self.tail.pos();
        Slot::new(&mut self.s.arena[base..base + READ_CHUNK], pos)
    }

    #[inline(always)]
    pub fn commit_read(&mut self, n: ByteLen) {
        self.tail = self.tail.advance(n);
    }
}
use crate::*;

impl<'a> Term<'a> {
    #[inline(always)]
    pub(crate) fn line(&self) -> LineSlot {
        LineSlot::of(self.head.plus(self.cy, SB))
    }

    #[inline(always)]
    pub(crate) fn view(&mut self) -> View<'_> {
        let alt = self.screen == Screen::Alternate;
        let rot = if alt { RowRot::NONE } else { self.rot };
        View::new(
            if alt { &mut self.s.alt } else { &mut self.s.vp },
            Cols::from_stride(MAX_COLS),
            self.cols,
            self.rows,
            rot,
        )
    }

    #[inline(always)]
    pub(crate) fn write_cell(&mut self, cp: Codepoint) {
        let (r, c, st) = (self.cy, self.cx, self.style);
        let fl = self.flags;
        self.put_counted(r, c, PackedCell::glyph(cp, st, fl));
    }

    /// Place one decoded codepoint. A 2-wide character at the last column
    /// cannot be split: the cell is left blank and it moves to the next row.
    /// That decision is forced by `try_advance` returning `Option`.
    #[inline(always)]
    pub(crate) fn put_cp(&mut self, cp: Codepoint, w: Width) {
        // **Does this codepoint continue the cluster before it?**
        //
        // Width alone cannot answer that. A ZWJ emoji sequence is three
        // codepoints of width 2, 0 and 2, so measuring each on its own gives
        // `U+1F469 U+200D U+1F4BB` four columns for one glyph. So does a flag:
        // two regional indicators, two columns each. `[[source: uax29]]` says
        // where the boundaries are, and `ClusterBreak` implements it against
        // Unicode's own conformance suite.
        //
        // A continuation is attached to the cell before it, exactly as a
        // combining mark is -- the marks table *is* the cluster continuation
        // store, which is why this needs no room in `PackedCell`.
        if !self.cluster.is_break(cp) && self.cx != Col::ZERO {
            self.attach_mark(cp);
            return;
        }
        if w == Width::ZERO {
            // **Attached, not discarded.** This returned early, so every
            // combining mark was silently thrown away: `e` + U+0301 stored `e`
            // and the accent was gone -- not mis-measured, absent, and
            // unrecoverable by a renderer, a selection or a copy.
            //
            // Zero-width codepoints are rare next to text, so this is off the
            // measured path: ASCII never reaches `put_cp` at all.
            self.attach_mark(cp);
            return;
        }
        if self.cx.try_advance(w, self.cols).is_none() {
            if !self.modes.is_set(ModeBit::AutoWrap) {
                // DECAWM reset: the character overwrites the last column and the
                // cursor stays put. No wrap, and therefore no scroll.
                self.cx = Col::at_index(self.cols.index() - 1);
                self.promote_if_runs();
                self.write_cell(cp);
                return;
            }
            self.wrap();
        }
        self.promote_if_runs();
        if self.modes.is_set(ModeBit::InsertReplace) {
            let n = match w {
                Width::WIDE => Count::TWO,
                _ => Count::ONE,
            };
            let edge = self.right_margin.after();
            self.open_gap(n, edge);
        }
        self.write_cell(cp);
        self.last_cp = Some((cp, w));
        if w == Width::WIDE {
            let (r, c, st) = (self.cy, self.cx.after(), self.style);
            let fl = self.flags;
            self.put_counted(r, c, PackedCell::wide_tail(st, fl));
        }
        self.cx = self.cx.try_advance(w, self.cols).unwrap_or(Col::ZERO);
    }

    /// Attach a zero-width codepoint to the cell the cursor last wrote.
    ///
    /// `#[inline(never)]`: `put_cp` is on the decode path and this is the rare
    /// arm, the same reason `open_gap` and `anywhere_c0` are out of line.
    #[inline(never)]
    fn attach_mark(&mut self, cp: Codepoint) {
        // A mark with nothing before it on the line has no base to attach to.
        // Dropping it is correct -- `[[source: uax29]]` GB1 puts a boundary at
        // start of text, so it is its own cluster and there is no cell for it.
        if self.cx == Col::ZERO {
            self.marks_dropped.inc();
            return;
        }
        let (r, c) = (self.cy, self.cx.before());
        let i = MarkSlot::index_of(r, c, NMARK);
        if !self.s.marks[i].is_for(r, c) {
            if !self.s.marks[i].is_empty() {
                // Someone else's marks. Evicting is the bounded-table
                // contract: the cell that loses them keeps its base character.
                self.marks_evicted.inc();
            }
            self.s.marks[i] = MarkSlot::for_cell(r, c);
        }
        if !self.s.marks[i].push(cp) {
            self.marks_dropped.inc();
        }
    }

    #[inline(always)]
    pub(crate) fn blit(&mut self, base: BytePos, off: ByteLen, room: Room) {
        let abs = base.index() + off.index();
        let (r, c, st) = (self.cy, self.cx, self.style);
        let (stride, cols, rows) = (Cols::from_stride(MAX_COLS), self.cols, self.rows);
        // Read before the split borrow below: `charset()` reads `self.g`, and
        // the destructuring holds `self.s` mutably.
        let set = self.charset();
        let (arena, vp) = (
            &self.s.arena,
            if self.screen == Screen::Alternate {
                &mut self.s.alt
            } else {
                &mut self.s.vp
            },
        );
        let fl = self.flags;
        let rot = if self.screen == Screen::Alternate {
            RowRot::NONE
        } else {
            self.rot
        };
        self.cells_written.add(room.index());
        #[cfg(feature = "instrument")]
        self.cells_bulk.add(room.index());
        View::new(vp, stride, cols, rows, rot).put_ascii_run(
            r,
            c,
            &arena[abs..abs + room.index()],
            st,
            fl,
            set,
        );
    }

    /// Shift the line right at the cursor to make room for `n` cells. IRM.
    ///
    /// **`#[inline(never)]` and deliberately so.** `put_run` is
    /// `#[inline(always)]` and is the measured ingest loop; inlining
    /// `insert_cells` into it cost ~9% of the cells path (1072.6 -> 963.6
    /// MB/s, ranges not overlapping, with ghostty stable across both runs).
    /// Insert mode is rare, so the call belongs behind a branch that costs one
    /// predictable test per run and nothing else.
    ///
    /// Insert mode also cannot use the run table: a run records "these bytes,
    /// at this position", and shifting the tail right invalidates every run
    /// after the cursor. Promote first, then shift, then write.
    #[inline(never)]
    pub(crate) fn open_gap(&mut self, n: Count, edge: Col) {
        self.promote_if_runs();
        let (r, at, b) = (self.cy, self.cx, PackedCell::empty_with(self.style));
        self.insert_cells_counted(r, at, n, edge, b);
    }

    #[inline(always)]
    pub(crate) fn put_run(&mut self, base: BytePos, mut off: ByteLen, mut n: ByteLen) {
        // Printable ASCII is blitted and never reaches `put_cp`, so
        // `ClusterBreak` does not see it. Reset, or an emoji after `a` would be
        // judged against the emoji before it. One store per *run*, not per
        // byte, so it is off the per-byte path this file is careful about.
        self.cluster = ClusterBreak::new();
        // Hoisted: a mode cannot change inside a run, and reading it per
        // iteration cost 12% of streaming throughput -- measured, not guessed.
        let wrap = self.modes.is_set(ModeBit::AutoWrap);
        // Hoisted for the same reason as `wrap`: DECSLRM cannot change inside a
        // run. With no side margins set this is one past the last column, so
        // the margin-aware form is also the fast form and there is no branch.
        let edge = self.right_margin.after();
        // IRM, hoisted for the same reason again. This is the *whole* cost of
        // insert mode on the replace path: one bool tested once per run, and
        // the branch below never taken. `[[source: ecma48]]` 8.3.64 defines IRM
        // as shifting the line right rather than overwriting, and it was
        // recorded and reported by DECRQM while nothing read it -- so an
        // application got overwrite and was told it had insert.
        let insert = self.modes.is_set(ModeBit::InsertReplace);
        while !n.is_zero() {
            let mut room = self.cols.room_until(self.cx, edge).min(n);
            if room.is_empty() {
                if wrap {
                    self.wrap();
                } else {
                    // DECAWM reset: pin to the last column and let each
                    // remaining byte overwrite it. The last one wins, and the
                    // screen never scrolls.
                    self.cx = self.right_margin;
                }
                room = self.cols.room_until(self.cx, edge).min(n);
            }
            if insert {
                self.open_gap(Count::from_room(room), edge);
            }
            // `promoted` and the run table belong to the primary screen. On the
            // alt screen every write is materialised, which is the same thing
            // "no scrollback" means one layer down.
            let promoted = self.screen == Screen::Alternate || self.s.promoted[self.cy.index()];
            if self.mode == OpMode::Runs && !promoted {
                let i = self.line();
                let c = self.s.nrun[i.index()];
                if c.index() < MAXRUN {
                    self.s.runs[i.run(c, MAXRUN)] = Run {
                        pos: base.advance(off),
                        len: ByteLen::from_room(room),
                        style: self.style,
                        encoding: 0,
                        charset: self.charset().to_u8(),
                        flags: 0,
                        _pad: [0; 1],
                    }
                    .with_encoding(Encoding::Ascii)
                    .with_flags(self.flags);
                    self.s.nrun[i.index()] = c.inc();
                    self.runs_written.inc();
                } else {
                    self.maxrun_overflows.inc();
                    self.promote();
                    self.blit(base, off, room);
                }
            } else {
                self.blit(base, off, room);
            }
            // The last byte of this run is the newest graphic character, which
            // is what REP repeats. Set here as well as in put_cp: plain ASCII
            // never reaches put_cp, so recording it only there would make
            // `abc CSI 3 b` repeat whatever was printed before the run.
            if !room.is_empty() {
                let at = base.index() + off.index() + room.index() - 1;
                let b = StreamByte::from_stream(self.s.arena[at]);
                self.last_cp = Some((Codepoint::from_ascii(b), Width::NARROW));
            }
            self.cx += room;
            // With autowrap on, the cursor may sit one past the last column --
            // the "wrap is pending" sentinel the next write consumes. With it
            // off there is no pending wrap, so that position is not reachable
            // and the cursor belongs on the last cell.
            if !wrap && self.cx.index() > self.right_margin.index() {
                self.cx = self.right_margin;
            }
            off = off.saturating_add(ByteLen::from_room(room));
            n = n.sub_room(room);
        }
    }

    pub(crate) fn promote(&mut self) {
        let y = self.cy.index();
        if self.s.promoted[y] {
            return;
        }
        let i = self.line();
        let n = self.s.nrun[i.index()].index();
        let mut c = 0usize;
        for r in 0..n {
            let run = self.s.runs[i.run(RunCount::from_index(r), MAXRUN)];
            let (o, l) = (run.pos.index(), run.len.index());
            for z in 0..l {
                if c >= self.cols.index() {
                    break;
                }
                let b = StreamByte::from_stream(self.s.arena[o + z]);
                let (rr, cc) = (Row::from_index(y), Col::at_index(c));
                let (st, fl) = (run.style, run.flags());
                // The run's own set, not whatever is designated now: a line
                // written under German and promoted later must still be German.
                let set = Charset::from_u8(run.charset);
                let cell = PackedCell {
                    content: Content::EMPTY,
                    style: st,
                    flags: fl,
                }
                .with_charset(b, set);
                self.put_counted(rr, cc, cell);
                c += 1;
            }
        }
        let blank = PackedCell::empty_with(self.style);
        let (rr, from, to) = (
            Row::from_index(y),
            Col::at_index(c),
            Col::at_index(self.cols.index()),
        );
        self.fill_counted(rr, from, to, blank);
        self.s.promoted[y] = true;
        self.promotions.inc();
    }

    #[inline(always)]
    pub(crate) fn promote_if_runs(&mut self) {
        if self.mode == OpMode::Runs && self.screen == Screen::Normal {
            self.promote();
        }
    }
}

impl<'a> Term<'a> {
    /// Counted wrappers around the grid writes.
    ///
    /// Sixteen call sites write cells. Instrumenting each by hand is how one
    /// of them ends up counting the wrong span -- and an amplification figure
    /// that is quietly low is worse than none, which is what `inf x
    /// amplification` taught this project once already. The arithmetic lives
    /// here instead, once per shape, so a wrong count is wrong everywhere and
    /// therefore visible.
    #[inline(always)]
    pub(crate) fn put_counted(&mut self, r: Row, c: Col, cell: PackedCell) {
        self.cells_written.inc();
        #[cfg(feature = "instrument")]
        self.cells_single.inc();
        self.view().put(r, c, cell);
    }

    /// The same bound as `fill_row_counted`, for a range.
    ///
    /// `EL`, `ED` and the selective-erase paths all land here, and an erase to
    /// end-of-line on a short line is the same waste scrolling was: the range
    /// runs to the margin whatever the row holds. Compared against `cell` for
    /// the same reason -- the blank carries the current style, so a row that is
    /// already empty still needs writing under a background colour.
    #[inline(always)]
    pub(crate) fn fill_counted(&mut self, r: Row, from: Col, to: Col, cell: PackedCell) {
        let n = to.index().saturating_sub(from.index());
        self.cells_written.add(n);
        self.cells_blanked.add(n);
        #[cfg(feature = "instrument")]
        self.cells_fill.add(n);
        self.view().fill(r, from, to, cell);
    }

    #[inline(always)]
    pub(crate) fn fill_row_counted(&mut self, r: Row, cell: PackedCell) {
        self.cells_written.add(self.cols.index());
        self.cells_blanked.add(self.cols.index());
        #[cfg(feature = "instrument")]
        self.cells_fill.add(self.cols.index());
        self.view().fill_row(r, cell);
    }

    /// Insert and delete rewrite everything from `at` to the margin: the
    /// shifted cells *and* the blanks that replace them. Counting only `n`
    /// would miss the shift, which is the expensive half.
    #[inline(always)]
    pub(crate) fn insert_cells_counted(
        &mut self,
        r: Row,
        at: Col,
        n: Count,
        right: Col,
        blank: PackedCell,
    ) {
        self.cells_written
            .add(right.index().saturating_sub(at.index()));
        self.view().insert_cells(r, at, n, right, blank);
    }

    #[inline(always)]
    pub(crate) fn delete_cells_counted(
        &mut self,
        r: Row,
        at: Col,
        n: Count,
        right: Col,
        blank: PackedCell,
    ) {
        self.cells_written
            .add(right.index().saturating_sub(at.index()));
        self.view().delete_cells(r, at, n, right, blank);
    }
}
use crate::*;

impl<'a> Term<'a> {
    /// Execute one VT52 escape sequence.
    ///
    /// `[[source: vt510-decanm]]` Table 5-1. This is a separate dispatch from
    /// `esc_fe` on purpose: the two protocols disagree about what the same
    /// bytes mean. `ESC D` is IND here and cursor-left there; `ESC H` is HTS
    /// here and home there. Folding them into one table would silently make one
    /// of the two wrong.
    pub(crate) fn vt52_dispatch(&mut self, b: StreamByte) {
        match Vt52::parse(b) {
            Vt52::CursorUp => self.cy = self.cy.up(Count::ONE),
            Vt52::CursorDown => self.cy = self.cy.down(Count::ONE, self.rows),
            Vt52::CursorRight => self.cx = self.cx.forward(Count::ONE, self.cols),
            Vt52::CursorLeft => self.cx = self.cx.back(Count::ONE),
            // VT52 reaches the line-drawing set directly rather than through a
            // G-slot designation; the cell flag is the same one either route.
            Vt52::GraphicsOn => {
                self.g[GSlot::G0.index()] = Charset::DecGraphics;
                self.refresh_flags();
            }
            Vt52::GraphicsOff => {
                self.g[GSlot::G0.index()] = Charset::Ascii;
                self.refresh_flags();
            }
            Vt52::Home => {
                self.cx = Col::ZERO;
                self.cy = Row::ZERO;
            }
            Vt52::ReverseLineFeed => self.reverse_index(),
            Vt52::EraseToEndOfScreen => self.erase_display(EraseExtent::ToEnd),
            Vt52::EraseToEndOfLine => self.erase_line(EraseExtent::ToEnd),
            // Two coordinate bytes follow; the state machine collects them.
            Vt52::DirectAddress => self.st = State::Vt52Row,
            Vt52::Identify => self.report(Report::Vt52Identity),
            Vt52::ExitVt52 => self.set_terminal_mode(TerminalMode::Ansi),
            Vt52::KeypadApplication => self.keypad = KeypadMode::Application,
            Vt52::KeypadNumeric => self.keypad = KeypadMode::Numeric,
            // The print functions -- `ESC ^ _ W X ] V`. There is no printer,
            // and accepting them silently is the failure this counter exists
            // to make visible.
            Vt52::Unsupported => self.unsupported.inc(),
        }
    }

    /// The column byte of `ESC Y row col`, with the row already collected.
    pub(crate) fn vt52_address(&mut self, row: Vt52Coord, col: StreamByte) {
        self.cy = row.to_row(self.rows);
        self.cx = Vt52Coord::from_wire(col).to_col(self.cols);
    }

    /// The ground state for the protocol currently in force.
    ///
    /// Read only when a sequence *ends*, never in the byte loop -- which is the
    /// point of having two ground states at all.
    #[inline(always)]
    pub(crate) fn ground(&self) -> State {
        match self.terminal_mode {
            TerminalMode::Ansi => State::Ground,
            TerminalMode::Vt52 => State::Vt52Ground,
        }
    }

    /// Enter or leave VT52, putting the parser in the matching ground state.
    pub(crate) fn set_terminal_mode(&mut self, m: TerminalMode) {
        self.terminal_mode = m;
        self.st = self.ground();
    }

    /// Is the parser speaking VT52 rather than ANSI? DECANM.
    pub fn terminal_mode(&self) -> TerminalMode {
        self.terminal_mode
    }
}
use core::marker::PhantomData;

/// An invariant lifetime. Two `Brand`s from different scopes are never equal,
/// so values carrying one cannot be passed where the other is expected.
///
/// Invariance is the point: `fn(&'id ()) -> &'id ()` makes `'id` neither
/// covariant nor contravariant, so the compiler will not silently coerce one
/// brand into another.
pub struct Brand<'id>(pub(crate) PhantomData<fn(&'id ()) -> &'id ()>);

impl<'id> Clone for Brand<'id> {
    fn clone(&self) -> Self {
        *self
    }
}

impl<'id> Copy for Brand<'id> {}

impl<'id> PartialEq for Brand<'id> {
    fn eq(&self, _: &Self) -> bool {
        true
    }
}

impl<'id> Eq for Brand<'id> {}

impl<'id> PartialOrd for Brand<'id> {
    fn partial_cmp(&self, o: &Self) -> Option<core::cmp::Ordering> {
        Some(self.cmp(o))
    }
}

impl<'id> Ord for Brand<'id> {
    fn cmp(&self, _: &Self) -> core::cmp::Ordering {
        core::cmp::Ordering::Equal
    }
}
use crate::*;
use zerocopy::{FromBytes, Immutable, IntoBytes, KnownLayout};

/// A materialised cell. Carries both brands: it is only valid for one geometry
/// and one font epoch.
#[repr(C)]
#[derive(Clone, Copy)]
pub struct Cell<'font> {
    pub slot: AtlasSlot<'font>,
    pub style: StyleId,
}

/// The brand-free form, for the one place a viewport actually crosses a byte
/// boundary: upload to the GPU.
///
/// `Cell<'font>` carries a lifetime so a stale atlas slot cannot outlive a font
/// change; a lifetime cannot be `FromBytes`. So the branded form is what the
/// domain uses, and this is what gets uploaded — the conversion is a
/// `repr(transparent)` reinterpretation, not a copy.
/// What a cell holds. **Content, not appearance.**
///
/// Values above `U+10FFFF` cannot be codepoints, so the reserved states are
/// unambiguous without a discriminant byte. The core never decides that "blank"
/// looks like `U+0020` — that conflates *nothing was written* with *a space was
/// written*, which differ for selection (copying a line must not yield trailing
/// spaces), for reflow, and for equality.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq, Debug, FromBytes, IntoBytes, Immutable, KnownLayout)]
pub struct Content(pub(crate) u32);

impl Content {
    /// Nothing was written here. The renderer draws background and no glyph.
    pub const EMPTY: Content = Content(0x0011_0000);
    /// The right half of a double-width character. The renderer skips it; the
    /// glyph in the preceding cell covers both columns.
    pub const WIDE_TAIL: Content = Content(0x0011_0001);

    /// A decoded codepoint. Full range — no truncation, so astral-plane
    /// characters survive. `U+1F680 & 0xffff` was `U+F680`, a private-use
    /// codepoint, which is what the differential test caught.
    pub fn codepoint(c: Codepoint) -> Content {
        Content(c.value())
    }
    pub fn as_codepoint(self) -> Option<Codepoint> {
        Codepoint::new(self.0)
    }
    pub fn is_empty(self) -> bool {
        self == Content::EMPTY
    }
    pub fn is_wide_tail(self) -> bool {
        self == Content::WIDE_TAIL
    }
}

impl Default for Content {
    fn default() -> Self {
        Content::EMPTY
    }
}

/// One materialised cell: content plus a style index.
///
/// Eight bytes rather than four. Measured cost of that width: 8-byte cells hit
/// 48% of the kernel ceiling against 50% for 4-byte — two points, for holding a
/// full codepoint instead of a truncated one.
#[repr(C)]
#[derive(
    Clone, Copy, Default, PartialEq, Eq, Debug, FromBytes, IntoBytes, Immutable, KnownLayout,
)]
pub struct PackedCell {
    pub content: Content,
    pub style: StyleId,
    pub flags: CellFlags,
}

/// Per-cell state that is **not** a rendition.
///
/// Lives in what used to be `PackedCell::_pad`, so the cell is still eight
/// bytes and the measurement behind that width still holds.
///
/// The distinction is the point. A rendition is interned: many cells share one
/// [`StyleId`], and the table behind it is a direct-mapped cache that evicts.
/// That is tolerable for colour -- an evicted bucket renders wrong until it is
/// rewritten -- and not tolerable for DECSCA protection, where eviction would
/// silently expose text an application asked to keep. Anything whose loss is a
/// correctness bug rather than a cosmetic one belongs here, per cell, where
/// nothing can evict it.
#[repr(transparent)]
#[derive(
    Clone, Copy, Default, PartialEq, Eq, Debug, FromBytes, IntoBytes, Immutable, KnownLayout,
)]
pub struct CellFlags(pub(crate) u16);

/// Which hyperlink a cell belongs to, or none.
///
/// Zero is "no link", so a zeroed grid has no hyperlinks and there is no
/// parallel validity array to keep in step -- the same trick `ColorWord`
/// uses for the default colour.
#[repr(transparent)]
#[derive(
    Clone, Copy, Default, PartialEq, Eq, Debug, FromBytes, IntoBytes, Immutable, KnownLayout,
)]
pub struct LinkId(pub(crate) u16);

impl LinkId {
    pub const NONE: LinkId = LinkId(0);
    pub fn from_index(i: usize) -> LinkId {
        LinkId(i as u16)
    }
    pub fn index(self) -> usize {
        self.0 as usize
    }
    pub fn is_none(self) -> bool {
        self.0 == 0
    }

    /// Which slot an `OSC 8` link hashes to.
    ///
    /// The twin of [`StyleId::bucket`], and it takes the **high** bits for the
    /// same measured reason: the low bits of a multiplicative hash are the ones
    /// that collide, and this codebase has already lost a whole style table to
    /// masking the wrong end.
    ///
    /// Slot 0 is reserved for "no link", so the range is `1..buckets`.
    ///
    /// The `id` is hashed alongside the URI because the spec lets two runs with
    /// the same `id` be one logical link across lines; distinct ids must not
    /// collapse into a single slot merely because their URIs match.
    pub fn bucket(id: &[u8], uri: &[u8], buckets: usize) -> LinkId {
        let mut h: u64 = 0xcbf2_9ce4_8422_2325;
        for &b in id.iter().chain(uri) {
            h ^= b as u64;
            h = h.wrapping_mul(0x0000_0100_0000_01b3);
        }
        let spread = h.wrapping_mul(0x9E37_79B9_7F4A_7C15) >> 32;
        LinkId::from_index(1 + (spread as usize) % (buckets - 1))
    }
}

impl CellFlags {
    pub const NONE: CellFlags = CellFlags(0);
    /// DECSCA: DECSED and DECSEL may not erase this cell.
    ///
    /// `[[source: vt510-decsca]]`: "1 DECSED and DECSEL cannot erase
    /// characters."
    pub const PROTECTED: CellFlags = CellFlags(1);
    /// The byte in this cell was written while the DEC Special Character and
    /// Line Drawing Set was invoked into GL.
    ///
    /// The cell keeps the byte the application sent, plus this flag, rather
    /// than a translated codepoint. That is deliberate and it is a *sourcing*
    /// decision, not a design preference: `[[source: ctlseqs]]` names the set
    /// (`C = 0 -> DEC Special Character and Line Drawing Set, VT100`) but does
    /// not give the byte-to-glyph mapping, and `MANIFEST.toml` records
    /// `dec-special-graphics` as `gated` -- vt100.net publishes the table as a
    /// figure, so no claim may rest on it. Translating here would mean writing
    /// the table from memory, which this project has been wrong about before.
    ///
    /// Carrying the flag loses nothing: a renderer that has the table has
    /// everything it needs, and one that does not can say so. Translating to a
    /// guessed codepoint would be unrecoverable.
    pub const GRAPHICS: CellFlags = CellFlags(2);
    pub fn is_graphics(self) -> bool {
        self.0 & CellFlags::GRAPHICS.0 != 0
    }
    pub fn with(self, o: CellFlags) -> CellFlags {
        CellFlags(self.0 | o.0)
    }

    /// Bits 2..16 carry the [`LinkId`].
    ///
    /// **The link rides in the spare bits of this word rather than in a field
    /// of its own, and that is a measured constraint, not a packing game.**
    /// `CLAUDE.md`: "`PackedCell` is 8 bytes" — going from 4 to 8 already cost
    /// two points of the kernel ceiling, and a ninth and tenth byte would round
    /// the cell to twelve. Two flag bits were in use and fourteen were not, so
    /// a link index fits with 14 bits of room, against `NLINK` of 128.
    const LINK_SHIFT: u16 = 2;

    pub fn with_link(self, l: LinkId) -> CellFlags {
        let flags = self.0 & ((1 << CellFlags::LINK_SHIFT) - 1);
        CellFlags(flags | ((l.index() as u16) << CellFlags::LINK_SHIFT))
    }
    pub fn link(self) -> LinkId {
        LinkId::from_index((self.0 >> CellFlags::LINK_SHIFT) as usize)
    }
    pub fn protection(on: bool) -> CellFlags {
        CellFlags(u16::from(on))
    }
    pub fn is_protected(self) -> bool {
        self.0 & CellFlags::PROTECTED.0 != 0
    }
    /// Just the flag bits, with any link index masked off.
    ///
    /// Interning and equality use the whole word, so two cells in different
    /// links are different cells — which is correct, and is why this exists
    /// separately for the places that mean *only* the flags.
    pub fn bare(self) -> CellFlags {
        CellFlags(self.0 & ((1 << CellFlags::LINK_SHIFT) - 1))
    }
    /// The byte, for the one place a flag set has to survive a round trip
    /// through [`Run`]'s fixed layout.
    pub fn bits(self) -> u8 {
        self.0 as u8
    }
    pub fn from_bits(b: u8) -> CellFlags {
        CellFlags(b as u16)
    }
}

/// Materialised rows currently on screen — a projection, never storage.
///
/// Over-provisioned and never reallocated: resize changes `cols`/`rows`, not
/// the allocation. Measured flat from a tight fit up to a 400 MB matrix,
/// because untouched pages are never faulted in.
///
/// Carrying `'layout` and `'font` means a resize or font change forces
/// re-materialisation — the compiler will not let a stale viewport be read.
pub struct Viewport<'layout, 'font, 'buf> {
    cells: &'buf mut [Cell<'font>],
    stride: Cols,
    _l: Brand<'layout>,
}

impl<'layout, 'font, 'buf> Viewport<'layout, 'font, 'buf> {
    pub fn stride(&self) -> Cols {
        self.stride
    }
    /// Indexing requires a [`RowIdx`] from the matching [`Layout`], so a row
    /// number computed at a different width cannot be used here.
    pub fn row(&self, l: &Layout<'layout>, r: RowIdx<'layout>) -> &[Cell<'font>] {
        let start = l.row_value(r).index() * self.stride.index();
        &self.cells[start..start + l.cols().index()]
    }
}

impl PackedCell {
    /// Unwritten. Note this is *not* a space: the renderer decides what an empty
    /// cell looks like, and selection can tell the difference.
    pub const EMPTY: PackedCell = PackedCell {
        content: Content::EMPTY,
        style: StyleId::DEFAULT,
        flags: CellFlags::NONE,
    };
    /// An erased cell.
    ///
    /// Takes no flags on purpose: an erase leaves a position with no character
    /// in it, and `[[source: vt510-decsca]]` scopes protection to "characters
    /// that follow the DECSCA function". A blank that inherited the protection
    /// would make the first selective erase under `DECSCA 1` protect everything
    /// it had just cleared.
    pub fn empty_with(style: StyleId) -> PackedCell {
        PackedCell {
            content: Content::EMPTY,
            style,
            flags: CellFlags::NONE,
        }
    }
    /// A printable ASCII byte. The proof that it is printable is also the proof
    /// that its codepoint equals its byte value.
    /// An ASCII byte under whatever character set `flags` says is invoked.
    ///
    /// The one constructor for "a byte from the wire became a cell", so the
    /// DEC Special Graphics translation cannot be applied on one path and
    /// forgotten on another. `promote` replays stored runs and had exactly that
    /// shape: the run carries the flags, and translating only in
    /// `put_ascii_run` would have made a line's content depend on whether it
    /// had been promoted yet.
    pub fn from_wire(b: StreamByte, style: StyleId, flags: CellFlags) -> PackedCell {
        let proto = PackedCell {
            content: Content::EMPTY,
            style,
            flags,
        };
        proto.with_charset(b, Charset::from_flags(flags))
    }

    /// An ASCII byte under a named character set.
    ///
    /// **The one place a wire byte becomes a character.** Every set that
    /// substitutes anything goes through here, so a path cannot honour DEC
    /// graphics and forget Finnish -- which is exactly the shape `promote`
    /// had before `from_wire` existed.
    pub fn with_charset(self, b: StreamByte, set: Charset) -> PackedCell {
        match set {
            Charset::DecGraphics => self.with_dec_graphics(b),
            Charset::Uk => self.with_nrcs(b, crate::uk_table()),
            Charset::National(n) => self.with_nrcs(b, crate::nrcs_table(n)),
            // ASCII, the DEC sets baud does not translate, and anything
            // unrecognised: the byte stands for itself.
            _ => self.with_ascii(b),
        }
    }

    pub fn from_ascii(b: StreamByte, style: StyleId, flags: CellFlags) -> PackedCell {
        PackedCell {
            content: Content::codepoint(Codepoint::from_ascii(b)),
            style,
            flags,
        }
    }
    pub fn glyph(c: Codepoint, style: StyleId, flags: CellFlags) -> PackedCell {
        PackedCell {
            content: Content::codepoint(c),
            style,
            flags,
        }
    }
    pub fn wide_tail(style: StyleId, flags: CellFlags) -> PackedCell {
        PackedCell {
            content: Content::WIDE_TAIL,
            style,
            flags,
        }
    }
    pub fn is_protected(self) -> bool {
        self.flags.is_protected()
    }
    /// This cell's style and flags with a different character in it.
    ///
    /// The whole point is that the tail is *already assembled*. `PackedCell` is
    /// `{u32, u16, u8, u8}`, and building one field-by-field inside a per-cell
    /// loop let the compiler emit four narrow stores instead of one 8-byte one
    /// -- measured at ~8% of the cells path when the flags byte was carved out
    /// of the old `_pad`. Hoisting the invariant tail out of the loop and only
    /// replacing `content` puts it back.
    #[inline(always)]
    pub fn with_ascii(self, b: StreamByte) -> PackedCell {
        PackedCell {
            content: Content::codepoint(Codepoint::from_ascii(b)),
            ..self
        }
    }

    /// The same, under a national replacement set.
    ///
    /// Each set replaces a handful of ASCII positions and leaves the rest
    /// alone, so an unlisted byte is itself.
    pub fn with_nrcs(self, b: StreamByte, table: &[(u8, u32)]) -> PackedCell {
        let v = b.raw_byte();
        let cp = match table.iter().find(|(k, _)| *k == v) {
            Some((_, cp)) => Codepoint::decoded(*cp),
            None => Codepoint::from_ascii(b),
        };
        PackedCell {
            content: Content::codepoint(cp),
            ..self
        }
    }

    /// The same, under DEC Special Graphics.
    ///
    /// **The flag stays set.** Translating and dropping `CellFlags::GRAPHICS`
    /// would lose where the character came from, and translating without
    /// storing the result would lose the character -- selection and copy would
    /// hand back `q` where the screen shows `─`. Both, and neither is lost.
    ///
    /// Bytes outside `` ` ``..`~` are unchanged: the set is ASCII everywhere
    /// else, which is why the table is 31 entries rather than 128.
    pub fn with_dec_graphics(self, b: StreamByte) -> PackedCell {
        let v = b.raw_byte();
        let cp = match v.checked_sub(0x60) {
            Some(i) if (i as usize) < crate::DEC_GRAPHICS.len() => {
                Codepoint::decoded(crate::DEC_GRAPHICS[i as usize])
            }
            _ => Codepoint::from_ascii(b),
        };
        PackedCell {
            content: Content::codepoint(cp),
            ..self
        }
    }
}

/// Combining marks attached to one cell, keyed on where that cell is.
///
/// **Not part of [`PackedCell`], deliberately.** The cell is eight measured
/// bytes with no room, so a grapheme that needs more than one codepoint keeps
/// its base in the cell and its marks here, found by position.
///
/// `len == 0` means the slot is free — a zeroed grid therefore has no marks and
/// there is nothing to initialise, which is what keeps `Storage` a plain
/// zeroable block for `new_box_zeroed`.
#[repr(C)]
#[derive(Clone, Copy, PartialEq, Eq, FromBytes, IntoBytes, Immutable, KnownLayout)]
pub struct MarkSlot {
    /// Row and column of the cell these attach to. Only meaningful when
    /// `len > 0`.
    pub row: u16,
    pub col: u16,
    pub len: u16,
    /// Padding, and it is load-bearing: `{u16,u16,u16,[u32;3]}` would carry two
    /// bytes of invisible tail padding, which is the unsound-to-reinterpret
    /// shape `Run::_pad` already exists to avoid.
    pub _pad: u16,
    pub cps: [u32; 3],
}

impl MarkSlot {
    /// The most marks one cell may carry. Past a base plus two accents, no
    /// normal orthography stacks further.
    pub const CAPACITY: usize = 3;

    pub const EMPTY: MarkSlot = MarkSlot {
        row: 0,
        col: 0,
        len: 0,
        _pad: 0,
        cps: [0; 3],
    };

    /// Which slot a cell's marks live in, in a table of `n`.
    ///
    /// Direct-mapped, and it takes the **high** bits of the product for the
    /// same measured reason `StyleId::bucket` does: the low bits of a
    /// multiplicative hash are the ones that collide, and `& (n-1)` on the
    /// product is the bug that cost 112,144 interns.
    ///
    /// Takes `Row` and `Col` rather than two integers. Passing them the wrong
    /// way round compiles, and would give a plausible index into the wrong
    /// slot -- the operands-reversed failure `RowBlock` already exists to
    /// prevent.
    pub fn index_of(r: Row, c: Col, n: usize) -> usize {
        let key = ((r.index() as u64) << 16) ^ (c.index() as u64);
        (key.wrapping_mul(0x9e37_79b9_7f4a_7c15) >> 55) as usize % n
    }

    /// An empty slot keyed to this cell.
    pub fn for_cell(r: Row, c: Col) -> MarkSlot {
        MarkSlot {
            row: r.index() as u16,
            col: c.index() as u16,
            ..MarkSlot::EMPTY
        }
    }

    /// Does this slot hold marks for that cell?
    ///
    /// A direct-mapped table can hand back somebody else's slot, so every read
    /// has to ask. This is the check that `StyleId`'s `tmpl_key` needed and did
    /// not have, which is how DECSCA protection was read from an evicted style.
    pub fn is_for(self, r: Row, c: Col) -> bool {
        !self.is_empty() && self.row == r.index() as u16 && self.col == c.index() as u16
    }

    pub fn is_empty(self) -> bool {
        self.len == 0
    }

    pub fn is_full(self) -> bool {
        self.len as usize >= MarkSlot::CAPACITY
    }

    /// Append a mark. `false` when the slot is full, which the caller counts.
    pub fn push(&mut self, cp: Codepoint) -> bool {
        if self.is_full() {
            return false;
        }
        self.cps[self.len as usize] = cp.value();
        self.len += 1;
        true
    }

    /// The marks, as codepoints.
    pub fn marks(&self) -> impl Iterator<Item = Codepoint> + '_ {
        self.cps[..(self.len as usize).min(MarkSlot::CAPACITY)]
            .iter()
            .filter_map(|c| Codepoint::new(*c))
    }
}
//! DEC Special Graphics, generated from the source pinned in
//! `docs/research/sources/MANIFEST.toml`.
//!
//! **Do not edit by hand.** Regenerate with `scripts/gen-dec-graphics.py`;
//! `dec_graphics_table_matches_the_pinned_source` fails if this file and the
//! pinned source disagree.
//!
//! Indexed by `byte - 0x60`, covering `` ` `` through `~`, which is the whole
//! of the set that differs from ASCII.

/// `[[source: foot-vt100-0]]`'s `vt100_0[]`.
pub static DEC_GRAPHICS: [u32; 31] = [
    0x25c6, // ` -> ◆  BLACK DIAMOND
    0x2592, // a -> ▒  MEDIUM SHADE
    0x2409, // b -> ␉  SYMBOL FOR HORIZONTAL TABULATION
    0x240c, // c -> ␌  SYMBOL FOR FORM FEED
    0x240d, // d -> ␍  SYMBOL FOR CARRIAGE RETURN
    0x240a, // e -> ␊  SYMBOL FOR LINE FEED
    0x00b0, // f -> °  DEGREE SIGN
    0x00b1, // g -> ±  PLUS-MINUS SIGN
    0x2424, // h -> ␤  SYMBOL FOR NEWLINE
    0x240b, // i -> ␋  SYMBOL FOR VERTICAL TABULATION
    0x2518, // j -> ┘  BOX DRAWINGS LIGHT UP AND LEFT
    0x2510, // k -> ┐  BOX DRAWINGS LIGHT DOWN AND LEFT
    0x250c, // l -> ┌  BOX DRAWINGS LIGHT DOWN AND RIGHT
    0x2514, // m -> └  BOX DRAWINGS LIGHT UP AND RIGHT
    0x253c, // n -> ┼  BOX DRAWINGS LIGHT VERTICAL AND HORIZONTAL
    0x23ba, // o -> ⎺  HORIZONTAL SCAN LINE-1
    0x23bb, // p -> ⎻  HORIZONTAL SCAN LINE-3
    0x2500, // q -> ─  BOX DRAWINGS LIGHT HORIZONTAL
    0x23bc, // r -> ⎼  HORIZONTAL SCAN LINE-7
    0x23bd, // s -> ⎽  HORIZONTAL SCAN LINE-9
    0x251c, // t -> ├  BOX DRAWINGS LIGHT VERTICAL AND RIGHT
    0x2524, // u -> ┤  BOX DRAWINGS LIGHT VERTICAL AND LEFT
    0x2534, // v -> ┴  BOX DRAWINGS LIGHT UP AND HORIZONTAL
    0x252c, // w -> ┬  BOX DRAWINGS LIGHT DOWN AND HORIZONTAL
    0x2502, // x -> │  BOX DRAWINGS LIGHT VERTICAL
    0x2264, // y -> ≤  LESS-THAN OR EQUAL TO
    0x2265, // z -> ≥  GREATER-THAN OR EQUAL TO
    0x03c0, // { -> π  GREEK SMALL LETTER PI
    0x2260, // | -> ≠  NOT EQUAL TO
    0x00a3, // } -> £  POUND SIGN
    0x00b7, // ~ -> ·  MIDDLE DOT
];
use crate::*;
use zerocopy::{FromBytes, Immutable, IntoBytes, KnownLayout};

/// One unit pulled from the byte stream.
///
/// The arena is **not** a `str`. A PTY delivers `cat /bin/ls` as readily as
/// text, and escape sequences are not characters. So the stream decodes into
/// this rather than being validated up front — a terminal must render garbage,
/// not reject it.
///
/// Note what is missing: no variant exposes a byte count as a width. The only
/// route to [`Width`] is [`Decoded::width`], and `Control` and `Invalid` have
/// their widths fixed by the protocol rather than by their length.
pub enum Decoded {
    /// A grapheme cluster — base character plus any combining marks. The unit
    /// of wrapping: splitting one orphans a mark from its base.
    Grapheme { len: ByteLen, width: Width },
    /// Malformed UTF-8. Rendered as U+FFFD, one column, never dropped.
    Invalid { len: ByteLen },
    /// A C0/C1 control byte. Occupies no columns; may move the cursor by other
    /// means, which is the parser's business and not the cursor arithmetic's.
    Control { byte: u8 },
}

impl Decoded {
    /// The only constructor of a [`Width`] from stream content.
    pub fn width(&self) -> Width {
        match self {
            Decoded::Grapheme { width, .. } => *width,
            Decoded::Invalid { .. } => Width::NARROW,
            Decoded::Control { .. } => Width::ZERO,
        }
    }
    pub fn len(&self) -> ByteLen {
        match self {
            Decoded::Grapheme { len, .. } | Decoded::Invalid { len } => *len,
            Decoded::Control { .. } => ByteLen(1),
        }
    }
}

/// One byte as it arrived. Not a number: it has no arithmetic, only
/// classification. Everything that consumes wire data takes this.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq, FromBytes, IntoBytes, Immutable, KnownLayout)]
pub struct StreamByte(pub(crate) u8);

impl StreamByte {
    pub fn from_stream(b: u8) -> StreamByte {
        StreamByte(b)
    }
    pub fn is_printable(self) -> bool {
        (0x20..0x7f).contains(&self.0)
    }
    pub fn is_c0(self) -> bool {
        self.0 < 0x20
    }
    pub fn is_continuation(self) -> bool {
        self.0 & 0xc0 == 0x80
    }
    pub fn as_ascii_digit(self) -> Option<Digit> {
        self.0.is_ascii_digit().then(|| Digit(self.0 - b'0'))
    }
    /// For the atlas and the width tables, which index by codepoint.
    pub fn index(self) -> usize {
        self.0 as usize
    }
}

/// A decimal digit from a CSI parameter. Cannot be arithmetic'd with anything
/// else, and cannot exceed 9 by construction.
#[repr(transparent)]
#[derive(Clone, Copy)]
pub struct Digit(pub(crate) u8);

/// A CSI final byte, validated to the `0x40..=0x7e` range ECMA-48 allows.
/// Constructing one is the proof that a sequence terminated legally.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq)]
pub struct FinalByte(pub(crate) u8);

impl FinalByte {
    pub fn from_stream(b: StreamByte) -> Option<FinalByte> {
        (0x40..=0x7e).contains(&b.0).then_some(FinalByte(b.0))
    }
    pub(crate) fn raw(self) -> u8 {
        self.0
    }
    /// The byte, for an encoder that has to write it out.
    ///
    /// A `StreamByte` rather than a `u8`: it is going back onto the wire, and
    /// that is the type for a byte on the wire.
    pub fn byte(self) -> StreamByte {
        StreamByte(self.0)
    }
}

impl StreamByte {
    pub const LF: StreamByte = StreamByte(b'\n');
    pub const CR: StreamByte = StreamByte(b'\r');
    pub const ESC: StreamByte = StreamByte(0x1b);
    pub const BS: StreamByte = StreamByte(0x08);
    pub const TAB: StreamByte = StreamByte(b'\t');
    pub const BEL: StreamByte = StreamByte(0x07);
    /// NUL. Discarded, never printed: `[[source: ecma48]]` § 8.3.88 makes it a
    /// fill character with no effect on the presentation.
    pub const NUL: StreamByte = StreamByte(0x00);
    /// DEL. `[[source: williams]]` gives it the `ignore` action inside escape
    /// and CSI sequences: it neither ends them nor contributes to them.
    pub const DEL: StreamByte = StreamByte(0x7f);
    /// `[[source: williams]]`'s "anywhere" block: CAN and SUB abandon whatever
    /// sequence is in progress, from any state. Named because `is_c0()` is
    /// `< 0x20` and therefore cannot distinguish them from a C0 to execute.
    /// The intermediate byte of `ESC SP F` / `ESC SP G` (S7C1T / S8C1T).
    /// `9C` — the 8-bit String Terminator, which exists only outside UTF-8.
    pub const ST_8BIT: StreamByte = StreamByte(0x9c);
    pub const SP: StreamByte = StreamByte(0x20);
    /// The intermediate byte of `ESC % @` / `ESC % G`.
    pub const PERCENT: StreamByte = StreamByte(0x25);
    pub const CAN: StreamByte = StreamByte(0x18);
    pub const SUB: StreamByte = StreamByte(0x1a);
    /// The intermediate of `ESC # 8` (DECALN).
    pub const HASH: StreamByte = StreamByte(b'#');
    /// VT. `[[source: ctlseqs]]` treats it as an index, like LF.
    pub const VT: StreamByte = StreamByte(0x0b);
    /// FF. Also an index -- a terminal does not eject a page.
    pub const FF: StreamByte = StreamByte(0x0c);
    /// SO / SI, the G1 and G0 shifts. Consumed so they are not printed; the
    /// charset they select is not implemented -- see docs/vt-coverage.md.
    pub const SO: StreamByte = StreamByte(0x0e);
    pub const SI: StreamByte = StreamByte(0x0f);
    pub const SEMICOLON: StreamByte = StreamByte(b';');

    /// The ISO 8613-6 sub-parameter separator. A *parameter* byte (0x3a), not
    /// an intermediate -- which is why it must be handled in the parameter
    /// loop and not by `is_csi_intermediate`.
    pub const COLON: StreamByte = StreamByte(b':');
    pub const QUESTION: StreamByte = StreamByte(b'?');
    /// `>`, the secondary CSI marker. A parameter byte like `?`, and a
    /// different namespace from it.
    pub const GT: StreamByte = StreamByte(b'>');
    pub const CSI_INTRO: StreamByte = StreamByte(b'[');
    pub const OSC_INTRO: StreamByte = StreamByte(b']');
    /// `ESC P`. Device Control String: a payload that must be consumed, never
    /// executed.
    pub const DCS_INTRO: StreamByte = StreamByte(b'P');
    /// `ESC X`, `ESC ^`, `ESC _`: SOS, PM, APC. Same rule as DCS.
    pub const SOS_INTRO: StreamByte = StreamByte(b'X');
    pub const PM_INTRO: StreamByte = StreamByte(b'^');
    pub const APC_INTRO: StreamByte = StreamByte(b'_');
    /// `ESC \`, the string terminator's final byte.
    pub const ST_FINAL: StreamByte = StreamByte(b'\\');
    pub fn is_csi_intermediate(self) -> bool {
        (0x20..0x30).contains(&self.0)
    }
    /// Intermediate bytes after `ESC`, per `[[source: williams]]`'s
    /// `escape_intermediate`. Same range as the CSI intermediates: `ESC # 8` is
    /// DECALN, and without this the `#` is dropped and the `8` printed.
    pub fn is_esc_intermediate(self) -> bool {
        (0x20..0x30).contains(&self.0)
    }
    /// A byte that ends an escape sequence: `0x30..=0x7e`.
    pub fn is_esc_final(self) -> bool {
        (0x30..0x7f).contains(&self.0)
    }
    /// Lead byte of a UTF-8 sequence: how many continuation bytes follow, and
    /// the payload bits. `None` for ASCII and for stray continuation bytes.
    pub fn utf8_lead(self) -> Option<(u8, u32, Utf8Min)> {
        match self.0 {
            0xc2..=0xdf => Some((1, (self.0 & 0x1f) as u32, Utf8Min::Two)),
            0xe0..=0xef => Some((2, (self.0 & 0x0f) as u32, Utf8Min::Three)),
            0xf0..=0xf4 => Some((3, (self.0 & 0x07) as u32, Utf8Min::Four)),
            _ => None,
        }
    }
    /// `20..=7E`: a byte that stands for itself.
    pub fn is_printable_ascii(self) -> bool {
        (0x20..0x7f).contains(&self.0)
    }
    pub fn utf8_continuation(self) -> Option<u32> {
        (self.0 & 0xc0 == 0x80).then_some((self.0 & 0x3f) as u32)
    }
}

impl StreamByte {
    pub(crate) fn raw(self) -> u8 {
        self.0
    }
    /// For matching against ASCII literals in escape dispatch.
    pub fn raw_byte(self) -> u8 {
        self.0
    }
    /// Reinterpret a byte slice as a stream. No copy and no `unsafe`:
    /// `repr(transparent)` plus zerocopy's `FromBytes` make this a checked
    /// no-op. This is the crate's one entry point for wire data.
    pub fn slice_from(b: &[u8]) -> &[StreamByte] {
        <[StreamByte]>::ref_from_bytes(b).expect("transparent over u8, always valid")
    }
    pub fn slice_as_bytes(s: &[StreamByte]) -> &[u8] {
        s.as_bytes()
    }
}

/// How many continuation bytes a UTF-8 sequence still needs. 1, 2 or 3 by
/// construction — never an arbitrary `u8` counter.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq)]
pub struct Pending(pub(crate) u8);

impl Pending {
    pub fn new(n: u8) -> Pending {
        Pending(n.min(3))
    }
    pub fn is_last(self) -> bool {
        self.0 == 1
    }
    pub fn dec(self) -> Pending {
        Pending(self.0.saturating_sub(1))
    }
}

/// A Unicode scalar value: `0..=0x10FFFF`, surrogates excluded.
///
/// Not a `u32`. `Width::of` and `Content::codepoint` both took one and could be
/// handed a lane mask, a byte count, or a packed colour with equal enthusiasm.
#[repr(transparent)]
#[derive(
    Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Debug, FromBytes, IntoBytes, Immutable, KnownLayout,
)]
pub struct Codepoint(pub(crate) u32);

impl Codepoint {
    pub const REPLACEMENT: Codepoint = Codepoint(0xFFFD);
    pub const SPACE: Codepoint = Codepoint(0x20);

    /// The only fallible constructor. Rejects surrogates and out-of-range —
    /// both of which a UTF-8 decoder can produce from malformed input.
    pub fn new(v: u32) -> Option<Codepoint> {
        (v <= 0x10_FFFF && !(0xD800..0xE000).contains(&v)).then_some(Codepoint(v))
    }
    /// From a decoder that has already validated. Malformed input becomes
    /// U+FFFD rather than an invalid `Codepoint`, so the type's invariant holds
    /// without the caller having to branch.
    pub fn decoded(v: u32) -> Codepoint {
        Codepoint::new(v).unwrap_or(Codepoint::REPLACEMENT)
    }
    /// From a Rust `char`, which is by definition already a scalar value.
    ///
    /// Total and lossless, so no `Option`: `char` cannot hold a surrogate or a
    /// value above U+10FFFF. Exists so callers outside this crate do not write
    /// `c as u32` -- the cast belongs where the newtype is, which is here.
    pub fn from_char(c: char) -> Codepoint {
        Codepoint(c as u32)
    }
    pub fn from_ascii(b: StreamByte) -> Codepoint {
        Codepoint(b.raw() as u32)
    }
    pub fn value(self) -> u32 {
        self.0
    }
}

/// The smallest codepoint a UTF-8 sequence of a given length may encode.
///
/// **This is `[[source: unicode-ch3]]` Table 3-7's second-byte column, said as
/// the constraint it exists to enforce.** The table narrows the `80..BF`
/// continuation pattern for exactly four lead bytes — `E0`, `ED`, `F0`, `F4` —
/// and the standard notes the exceptions "occur only in the second byte of a
/// sequence". What all four encode is one rule: a sequence must be the
/// *shortest* form of the value it represents.
///
/// baud implemented only the first-byte column, so every overlong three- and
/// four-byte form decoded to a real character. `E0 80 AF` rendered `/` — the
/// canonical path-traversal overlong, which a filter checking for a slash would
/// not have seen. `Codepoint::new` could not catch it, structurally: a
/// non-shortest form still yields a legal scalar value, so nothing is wrong
/// with the *result*, only with the encoding of it.
///
/// Carried with the sequence rather than derived from the bytes remaining,
/// because `Pending` cannot tell "second byte of three" from "third byte of
/// four" — both have two continuations left. Deriving it from `Pending` was the
/// first attempt and it rejected `F0 90 80 80`, which is U+10000.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum Utf8Min {
    /// `C2..DF`: two bytes, so at least U+0080.
    Two,
    /// `E0..EF`: three bytes, so at least U+0800.
    Three,
    /// `F0..F4`: four bytes, so at least U+10000.
    Four,
}

impl Utf8Min {
    pub fn floor(self) -> u32 {
        match self {
            Utf8Min::Two => 0x80,
            Utf8Min::Three => 0x800,
            Utf8Min::Four => 0x1_0000,
        }
    }
}

/// Codepoint bits accumulated mid-sequence, *before* they are known to be a
/// valid scalar value. Deliberately not a [`Codepoint`] — a partial sequence
/// has not earned that type yet, and calling it one would be a lie the width
/// tables would then believe.
#[repr(transparent)]
#[derive(Clone, Copy, PartialEq, Eq)]
pub struct Utf8Acc(pub(crate) u32);

impl Utf8Acc {
    pub fn lead(bits: u32) -> Utf8Acc {
        Utf8Acc(bits)
    }
    pub fn push(self, cont: u32) -> Utf8Acc {
        Utf8Acc((self.0 << 6) | cont)
    }
    /// The only exit. Malformed input becomes U+FFFD rather than an invalid
    /// codepoint, so the invariant holds without the caller branching.
    ///
    /// A value below `min.floor()` is a non-shortest form and is **ill-formed**
    /// even though it is a perfectly legal scalar value — see [`Utf8Min`].
    /// Conformance clause C10 requires it be treated as an error rather than
    /// interpreted as the character it spells.
    pub fn finish(self, min: Utf8Min) -> Codepoint {
        if self.0 < min.floor() {
            return Codepoint::REPLACEMENT;
        }
        Codepoint::decoded(self.0)
    }
}

/// How incoming bytes are interpreted as characters.
///
/// `[[source: ctlseqs]]`: `ESC % G` is "Select UTF-8 character set, ISO 2022"
/// and `ESC % @` is "Select default character set. That is ISO 8859-1 (ISO
/// 2022)." An application may switch at any point in the stream, so this is
/// live state rather than startup configuration.
///
/// An enum and not a `bool`, for the reason `baud-domain` is gated at zero bool
/// fields: `utf8: true` does not say what the alternative is, and there is
/// more than one alternative in principle.
///
/// xterm's `utf8` resource is four-valued and only an explicitly configured
/// `always` makes these two sequences inert — by default xterm honours them,
/// which is what baud does.
#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
pub enum InputEncoding {
    /// Multi-byte, and the default. Bytes `80..FF` are lead and continuation
    /// bytes, so 8-bit C1 controls are unusable — see `docs/vt-coverage.md`.
    #[default]
    Utf8,
    /// ISO 8859-1: every byte is one character, `00..FF` mapping to
    /// `U+0000..U+00FF`. Single-byte and therefore fixed-width, which is the
    /// property [`Encoding::is_byte_per_column`] names.
    Latin1,
}

impl InputEncoding {
    /// The UTF-8 byte-order mark, `EF BB BF`.
    ///
    /// Unicode calls it a signature when it appears at the start of a stream.
    /// Mid-stream the same codepoint is `U+FEFF` ZERO WIDTH NO-BREAK SPACE and
    /// is text, which is why this is only meaningful at offset zero.
    pub const BOM: [u8; 3] = [0xef, 0xbb, 0xbf];

    /// Which encoding a sample is in, or `None` when the sample cannot say.
    ///
    /// **It reports; it does not switch.** Nothing in baud calls this — an
    /// embedder does, and decides. Guessing an encoding wrong corrupts text
    /// silently and gives the application no way to find out, which is the
    /// failure this project refuses everywhere else, so the guess is not
    /// baud's to make. xterm makes it a resource for the same reason.
    ///
    /// The three answers, and why the third is not a cop-out:
    ///
    /// * A UTF-8 BOM at offset zero is a signature, and decisive.
    /// * A byte sequence that is ill-formed UTF-8 rules UTF-8 out. ISO 8859-1
    ///   has no ill-formed bytes at all -- every one of the 256 is a character
    ///   -- so it is what remains.
    /// * A sample of nothing but ASCII returns **`None`**, because the two
    ///   encodings agree on every byte below `0x80`. There is no evidence
    ///   either way, and answering anyway would be inventing one. This is the
    ///   common case for a terminal, and it is why detection cannot be a
    ///   default: most of what a terminal sees decides nothing.
    pub fn detect(sample: &[u8]) -> Option<InputEncoding> {
        if sample.starts_with(&InputEncoding::BOM) {
            return Some(InputEncoding::Utf8);
        }
        let mut saw_multibyte = false;
        let mut i = 0;
        while i < sample.len() {
            let b = StreamByte::from_stream(sample[i]);
            let Some((rem, acc, min)) = b.utf8_lead() else {
                if sample[i] < 0x80 {
                    i += 1;
                    continue;
                }
                // A lead byte UTF-8 has no encoding for, or a stray
                // continuation. Latin-1 reads it as a character.
                return Some(InputEncoding::Latin1);
            };
            let n = rem as usize;
            if i + n >= sample.len() {
                // Truncated at the end of the sample: not evidence either way.
                break;
            }
            let mut v = Utf8Acc::lead(acc);
            for k in 1..=n {
                match StreamByte::from_stream(sample[i + k]).utf8_continuation() {
                    Some(bits) => v = v.push(bits),
                    None => return Some(InputEncoding::Latin1),
                }
            }
            if v.finish(min) == Codepoint::REPLACEMENT {
                // Overlong, surrogate, or out of range -- ill-formed UTF-8.
                return Some(InputEncoding::Latin1);
            }
            saw_multibyte = true;
            i += n + 1;
        }
        saw_multibyte.then_some(InputEncoding::Utf8)
    }

    /// The character a byte stands for, in a single-byte encoding.
    ///
    /// `None` for `80..9F`, which ISO 8859-1 reserves for C1 controls. baud
    /// does not act on 8-bit C1 — it cannot, having chosen UTF-8 as the other
    /// mode — so they are ignored rather than printed, which is what xterm's
    /// `CASE_IGNORE` does and what ghostty does citing xterm.
    /// The 7-bit escape a C1 byte stands for, in a single-byte encoding.
    ///
    /// **Only meaningful outside UTF-8**, which is the whole point. In UTF-8
    /// `9B` is a continuation byte and cannot be a control -- that is why
    /// `docs/vt-coverage.md` lists 8-bit C1 as out. In ISO 8859-1 it is
    /// unambiguously CSI, and `[[source: ctlseqs]]` describes the two forms as
    /// equivalent: `ESC [` is "a 7-bit equivalent to 8-bit" `9B`.
    ///
    /// So the refusal was scoped to the encoding without saying so. baud is not
    /// always in UTF-8 any more.
    ///
    /// Returns the byte the sequence would carry after `ESC`, so one table
    /// serves both forms and they cannot drift.
    pub fn c1_as_escape(self, b: StreamByte) -> Option<StreamByte> {
        if self == InputEncoding::Utf8 {
            return None;
        }
        let v = b.raw_byte();
        // C1 occupies `80..9F`, and its 7-bit form is `ESC` plus the byte
        // shifted down by 0x40: `9B` is `ESC [`, `9D` is `ESC ]`.
        (0x80..0xa0)
            .contains(&v)
            .then(|| StreamByte::from_stream(v - 0x40))
    }

    pub fn single_byte(self, b: StreamByte) -> Option<Codepoint> {
        match self {
            InputEncoding::Utf8 => None,
            InputEncoding::Latin1 => {
                let v = b.raw_byte();
                (!(0x80..0xa0).contains(&v)).then_some(Codepoint(v as u32))
            }
        }
    }
}
use crate::*;
use core::marker::PhantomData;
use zerocopy::{FromBytes, Immutable, IntoBytes, KnownLayout};

/// A font configuration generation. Atlas slots are only meaningful within one.
pub struct FontEpoch<'font> {
    _b: Brand<'font>,
}

/// Index into the glyph atlas — **font-dependent**, and that is legal only
/// because the viewport is disposable. On a font change the viewport
/// re-materialises from spans in 44 us and every slot is regenerated.
///
/// The brand makes that mandatory rather than optional: a `Viewport<'font>`
/// cannot survive into a new epoch.
#[derive(Clone, Copy)]
pub struct AtlasSlot<'font> {
    v: u16,
    _b: Brand<'font>,
}

/// A glyph within one font face, as the shaper resolved it. Font-specific:
/// glyph 47 is a different character in every font, which is why this may
/// never be stored anywhere but the disposable viewport.
#[derive(Clone, Copy, PartialEq, Eq, FromBytes, IntoBytes, Immutable, KnownLayout)]
#[repr(transparent)]
pub struct GlyphId(pub(crate) u16);

impl GlyphId {
    pub fn from_shaper(n: u16) -> GlyphId {
        GlyphId(n)
    }
}

impl<'font> FontEpoch<'font> {
    pub fn slot(&self, g: GlyphId) -> AtlasSlot<'font> {
        AtlasSlot {
            v: g.0,
            _b: self._b,
        }
    }
    /// Named so the widening is visible where the atlas is indexed.
    pub fn index(&self, s: AtlasSlot<'font>) -> usize {
        s.v as usize
    }
}

/// Enter a font scope. A font change means calling this again; anything
/// holding the old epoch's slots will not type-check.
pub fn with_font<R>(f: impl for<'id> FnOnce(FontEpoch<'id>) -> R) -> R {
    f(FontEpoch {
        _b: Brand(PhantomData),
    })
}
