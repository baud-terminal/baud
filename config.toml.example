# baud configuration. Every key below is commented out at its default, or,
# where the default is unset or follows the system, at an example, so this
# file as it stands changes nothing: take the # off a key's line to change it.
#
# When baud finds no config at launch, it writes this file, once, to
# $XDG_CONFIG_HOME/baud/config.toml, or ~/.config/baud/config.toml when that
# is unset -- never to the file $BAUD_CONFIG names. It never changes the file
# after that, so a later baud's new keys are not added to it: remove the file
# and the next launch writes the current one. An empty file stays as it is
# and means the defaults.
#
# Looked up at $BAUD_CONFIG, then $XDG_CONFIG_HOME/baud/config.toml, then
# ~/.config/baud/config.toml -- no entry of its own under the directory baud is
# started in. A relative $BAUD_CONFIG names a file under that directory; an
# empty or relative $XDG_CONFIG_HOME is ignored, as the XDG specification says.
# A font is named by its family, as "JetBrains Mono" or "Menlo"; a relative
# font file or theme path below names a file beside this one. A key baud
# does not know is ignored, and any field left out keeps its built-in default,
# so a config with only the keys you care about is fine. With no key set, baud
# draws with the fonts it carries inside itself: JetBrains Mono (its
# ligatures, and real Bold, Italic and Bold Italic faces) with baud's own Hebrew
# in its Regular and Bold, and Symbols Nerd Font Mono (the Nerd Fonts icons),
# with Menlo, the emoji, symbol and CJK system faces behind it. `fonts` below
# replaces that stack, and the embedded Regular, icon and symbol faces stay
# behind it for what your faces lack unless `font_fallback = false`.

# Points. On macOS a point is a pixel at the display's backing scale; on
# Linux it is 96 dots to the inch times the desktop's text scaling, at the
# output's scale ([font] dpi below).
# font_size = 13

# The gutter in points around the grid -- left, right and below -- so the window
# material shows through rather than the cells meeting the window's edge. The titlebar
# strip is the top gutter. 8 is the default; 0 turns it off.
# padding = 8

# The palette. "auto" follows the system appearance (System Settings >
# Appearance) and changes with it; "dark" and "light" pin it. On Linux "auto"
# follows the desktop's light or dark setting, light where the desktop states
# no preference, and dark where no desktop portal answers.
#
# The sixteen ANSI colours are xterm's on the dark palette and Modus Operandi's
# on the light one (by Protesilaos Stavrou, GPL-3.0-or-later), with five made
# readable on their page: on dark, red, blue, magenta and bright blue are
# lighter, and on light, colour 7 is darker, each keeping its hue, so every
# colour but the page's own black or white reads at 4.5:1 as text. A theme
# you set is drawn in its own colours. When the system flips under "auto",
# colours a program set with OSC 4, 10, 11 or 12 are dropped with the old
# palette, and a program that asked (mode 2031) is told dark or light.
# theme = "auto"

# What the surface's bytes mean, converted to each display by the compositor:
# "srgb", which every colour a terminal receives is specified as, or
# "display-p3" to read the theme's numbers as the wider gamut on purpose.
# colorspace = "srgb"

# How wide a text-default emoji is when a U+FE0F asks for emoji presentation,
# such as a heart followed by U+FE0F. "two" cells, which tmux, fish, macOS
# bash, helix and lipgloss assume; "one" for a session whose programs measure
# with a legacy wcwidth (zsh prompts outside tmux, readline and ncurses on
# glibc). DECRQM ?2027 reports it; nothing an application sends changes it.
# vs16_width = "two"

# How a character with no variation selector is drawn. "font": from a text
# face, whatever its default presentation (a lightning bolt is the font's
# bolt). "system": a character whose default presentation is emoji is drawn
# in colour, as macOS draws it. U+FE0F asks for colour and U+FE0E for text
# under either.
# emoji = "font"

# What a BEL (Control-G) does while baud's window is focused: "sound" plays
# the system's alert sound, "flash" shows the screen in the other video for
# the 100 ms the xterm-256color entry's flash names -- not under Reduce
# Motion, and nothing in its place, nor in a minimized window -- and "none"
# does neither. While the
# window is not focused nothing sounds, and whatever this says, a program
# that set mode 1042 makes the Dock icon bounce and one that set mode 1043
# raises the window, unless it is minimized. Bells within one frame ring
# once. On Linux "sound" is the desktop's system bell, where it offers one
# (xdg-system-bell-v1), and modes 1042 and 1043 both ask the desktop to
# bring the window to you (xdg-activation-v1): it decides whether the
# window comes forward or is marked as wanting attention.
# bell = "sound"

# Saved changes to this file, and to the theme and font files it names,
# show in the open window a moment after the save. A few settings wait
# for the next launch (docs/guide/configuration.md, "When a change
# shows"). "off" leaves every change for the next launch.
# config_reload = "on"


# The fallback stack, first font first: a font supplies the glyphs the fonts
# before it lack. Name each by its family, as other terminals take a font
# name -- "Fira Code", "Menlo", "JetBrains Mono" -- and baud finds it among
# the fonts installed on the machine (on macOS ~/Library/Fonts,
# /Library/Fonts and the system's fonts; on Linux ~/.local/share/fonts,
# ~/.fonts, /usr/share/fonts and the other XDG data folders), once, when it
# starts. The name is matched in any letter case, under any of the names
# the font gives its family, and the family's regular face is used. On
# Linux a name no installed font has, such as "monospace", is looked up
# through the aliases in fontconfig's configuration -- the families it
# prefers for that name, then those it accepts, then its defaults -- and the
# first one installed is used; a name an installed font has is used as it
# is, even where an alias prefers another font for it. A name
# no installed font has is left out, with a warning on the terminal baud
# was started from (naming the aliases tried), and the rest of the list
# goes on without it; if nothing
# you named is found, the built-in stack is used. A font file can still be
# given by its path, as other terminals allow for a font that is not
# installed: a value with a "/" or ending in .ttf, .otf, .ttc or .otc is a
# file, and a ".ttc" collection may carry "@N" to pick a face in it.
#
# Left unset, the stack is the embedded JetBrains Mono, with baud's Hebrew in
# its Regular and Bold, and its icon face, then the system's mono (Menlo;
# DejaVu Sans Mono on Linux), its colour emoji, and its symbol and CJK fonts,
# with the embedded Bold, Italic and Bold Italic for styled text. Set, it
# replaces that stack -- and the embedded faces still follow it: the embedded
# Regular, so Hebrew none of the named faces carries comes from it, then the
# icon face, so a Nerd Fonts icon does, rather than either drawing as a
# missing-glyph box. The embedded Regular also takes whatever else JetBrains
# Mono maps that your faces lack -- behind FiraCode, 458 code points by cmap,
# among them 8 symbols (U+23FB-23FE, U+26A1, U+276E-276F, U+2B58) that drew
# from the icon face before -- so those come from it, not the icon face. Bold,
# italic and bold italic text draw from the family of the first font in the
# list that is found: its Bold, Italic and Bold Italic, found among the
# installed fonts (and, for a font given by path, in its own folder), a
# variable font at the weight asked for. That first font, if variable, is
# drawn at the weight searched whether it is named by family or by path: its
# regular text at 400 where its weight axis reaches it. A style the family has
# no face for draws from the nearest face it has -- bold italic from its Bold
# when it has no italic, bold from its regular face when it has no bold -- and
# is never faked. A file path that does not start with / is read beside this
# file, so "fonts/Mine.ttf" is the fonts directory next to it:
# fonts = [
#   "Menlo",
#   "Apple Color Emoji",
#   "Apple Symbols",
# ]

# Whether the embedded Regular, the icon face and STIX Two Math follow a `fonts`
# stack you named. true, the default, keeps them behind your faces, in that
# order; false leaves none of baud's faces behind yours. Either way, a character
# none of them has is drawn from the font your system picks for it.
# Without `fonts` it changes nothing: the embedded faces are the stack then.
# font_fallback = true

# Two more stacks, each in place of the `fonts` above. For Fira Code with
# programming ligatures, name it first and keep the emoji and symbol fallbacks
# -- Fira Code has neither:
#
#     fonts = ["Fira Code", "Apple Color Emoji", "Apple Symbols"]
#
# For CJK coverage (Japanese, Chinese, Korean), stack a CJK face before the
# emoji and symbol fallbacks. Hiragino Sans GB covers Japanese kana and Chinese
# Han; Apple SD Gothic Neo covers Korean. A face earlier in the list wins per
# cluster, so keep your text face first:
#
#     fonts = [
#       "Menlo",
#       "Hiragino Sans GB",
#       "Apple SD Gothic Neo",
#       "Apple Color Emoji",
#       "Apple Symbols",
#     ]

# How many columns an East Asian Ambiguous character takes -- box drawing,
# block elements, Greek and Cyrillic letters, the plus-minus sign -- "narrow"
# (one, the default) or "wide" (two), for programs that count them as two,
# such as vim with ambiwidth=double. Set it only to match them: a program
# counting one column for such a character puts everything after it one
# column off. Private Use Area characters, the Nerd Font icons, stay one
# column either way. Under "wide" a box-drawing line or block element that
# East Asian Width marks Ambiguous takes two cells and is drawn across both,
# so boxes stay unbroken: its lines run on through the second cell to meet
# the next character, its vertical strokes and corners stay in the first, at
# the weight of a one-cell line, and a block fills its share of both cells.
# The pieces it leaves narrow (U+254C-254F, U+2574-257F, U+2590-2591,
# U+2596-259F) and DEC Special Graphics lines stay one cell. Read at launch;
# DECRQM ?1021 reports it.
# [text]
# ambiguous_width = "narrow"
#
# join_spacing_marks: whether a vowel sign written after its letter, such as
# the ि and ा of Hindi, a visarga, or Thai's and Lao's SARA AM, takes no column
# of its own. "off", the default, gives it a column, as Linux shells and vim
# count, so the cursor stays where they expect; "on" suits the Mac's own bash
# or zsh, or tmux, which count it as none. A program that asks for grapheme
# cluster mode, such as Neovim, gets a whole syllable in one cell either way.
# join_spacing_marks = "off"

# The contrast floor: text whose contrast with the colour it is drawn on is
# below this ratio is darkened or lightened, keeping its hue, until it reads
# at 4.5:1 -- or at this ratio, when it is higher. Only pairs a program did not
# choose outright: the same colour on both sides, or a page the program set as
# a 256-colour or truecolour value with its own text on it, is left alone, so
# pictures drawn in text are untouched while [glass] pictures = "opaque" draws them solid. The floor also covers text that
# [glass] app_backgrounds = "dim" makes unreadable: a page the program set,
# drawn at the dim over the window's own background, is measured as drawn,
# and text that reads at this ratio on the page as asked but not on the page
# as drawn is lifted; so is text that reads at 3:1 as asked and below 3:1 as
# drawn (or at this ratio, when it is higher). A pair below it as asked is
# still the program's. Box-drawing lines (U+2500-U+257F, where the lines and
# corners of DEC Special Graphics land) are left out: a divider is drawn in
# the colour asked. Block elements, which graphs are drawn with, are not. What
# a program asked for is unchanged in what the terminal reports; only the
# pixel moves. 1.2, the default, lifts only text that is nearly invisible;
# "off" turns it off. While Accessibility's Increase Contrast is on, the floor
# lifts text below 3:1 to 4.5:1, or to what is set here when that is higher,
# even when it is "off".
#
# `light` and `dark` name a theme file for each half of the palette; `theme`
# above still picks which half is drawn. baud reads base16 and base24 schemes
# (tinted-theming), ghostty, kitty, foot and alacritty themes (alacritty's TOML,
# or its YAML from before 0.13), iTerm2 .itermcolors presets (their sRGB, P3
# and calibrated colours converted as macOS converts them), Windows Terminal
# schemes, X resources (as xrdb loads them: their #define, #ifdef and
# #include "file" lines run, and only the entries every program reads,
# *color0 or *.color0, used), and a list of 16 colours, one per line, like
# pywal's colors file. A kitty theme's oklch() and lab() colours are drawn
# as kitty draws them, one outside sRGB as kitty's theme preview shows it. It
# tells them apart by what is in the file, not by its name, and says what it
# read each file as. A foot file or iTerm2 preset holding both a dark and a
# light theme is refused: save the one you want on its own. Other theme
# formats are named for what they are, and a file mixing two is refused with
# the line of each.
# A value with a / is a path: ~/ is your home, and a path that does not start
# with / or ~/ is read beside this file. A bare name is looked up in the
# `themes` directory beside this file, then
# in $XDG_CONFIG_HOME/baud/themes/ and ~/.config/baud/themes/, as given and
# then with .yaml and .yml. What a file leaves unset stays baud's own, entries 16-255
# stay xterm's, and a file that cannot be read is reported and leaves baud's
# own half. On Linux `auto` draws the light half when the desktop reports
# light or no preference, and the dark half until it reports and where nothing
# does.
#
# `selection` and `selection_text`: the colour behind selected text and the
# colour of the text itself -- also of the find field and its current match,
# which is selected, and of a region a program highlights (mode 1001). Left
# out, a selection is drawn in a theme file's selection colours where the
# file names them, and otherwise in reverse video: each cell's text and
# background exchanged. A colour set here wins over the theme file's, on both
# halves. A background colour with no text colour, from here or the theme
# file, keeps each cell's own text colour on it. "none" means no colour of
# its own, so both set to "none" is reverse video whatever the theme file
# says. A colour is written as "#rrggbb", "rgb:rr/gg/bb" or an X11 name such
# as "steelblue". A program can still set its own (OSC 17 and 19), and its
# reset (OSC 117 and 119) returns to these.
#
# `cursor` and `cursor_text`: the cursor's colour and the colour of the text
# under a block cursor. "baud", the default, is baud's amber, the logo's:
# #F4A32C on the dark and the light theme and on each reversed, with the logo's
# near-black #15171B under it. On the light theme it reads at 1.80:1, under the
# 4.5:1 of text, by choice; for the contrast, set `cursor` to "#986100" and
# `cursor_text` to "#EFEFEF". On a theme file's background or one a program sets,
# it is chosen against the background then drawn: darkened until it reads at
# 4.5:1, with the near-black under it where that reads at 4.5:1 and else the
# background. "baud" keeps the amber whatever a theme file says; "theme" asks for a theme file's cursor
# colour and text where it names them. A colour set here wins over the theme
# file's, and "none", or a theme file's none under "theme", makes a block
# cursor its cell's text and background exchanged, the classic cursor. Every
# trail and blink animation takes the cursor's colour. A program can set its
# own cursor colour (OSC 12), and its reset (OSC 112) returns to this one; the
# text under the block keeps its colour, baud's own included, under the
# program's colour.
# [palette]
# floor = 1.2
# light = "~/.config/baud/themes/day.yaml"
# dark = "night"
# selection = "#3f638b"
# selection_text = "none"
# cursor = "baud"
# cursor_text = "#102030"

# The cursor: its shape -- "block", "underline" or "bar" -- and whether it
# blinks. This is the cursor the terminal starts with and the one it returns
# to when an application resets it; an application can still ask for another.
# `blink = "auto"`, the default, blinks and holds steady under Accessibility's
# "prefer non-blinking cursor" (macOS 15 and later). `true` blinks whatever
# that switch says, with a warning, and `false` starts the cursor steady. A
# blinking cursor blinks only while the window has focus, and shows at once on
# a key, a paste, or output that moves it, hides or shows it, or changes its
# shape; output that leaves it as it was -- another pane of a multiplexer
# redrawing -- keeps it blinking. `stop_blinking_after` stops it, shown, after
# that many seconds without a key, a click or a paste -- output does not
# count; 0 is never.
#
# `blink_interval_ms`: how long each phase lasts, shown and hidden alike.
# Unset, macOS's `NSTextInsertionPointBlinkPeriodOn` and `...Off` are followed
# where you have set them, and each phase is otherwise 250 ms -- a symmetric
# two blinks a second, on Linux too. Set here, it wins over the system's keys.
# A phase is kept between 1/60 s and 60 s.
#
# `blink_animation`: what the cursor does while it is hidden. "none", the
# default, switches it hard: shown, then gone, one even beat. "plasma" is the
# plasma trail's glow on the cursor's cell, swelling out from nothing to a
# faint ghost of the cursor and back across the hidden phase.
# "fade" eases the cursor out over the first 30% of the hidden phase and back
# in over the last 30%, gone in between. "fire" burns the cursor down into
# embers and relights it from the bottom, in the fire trail's look. "ufo" has
# a little saucer's beam lift the cursor away and set it back down, in the ufo
# trail's. Each fits inside the hidden phase at any interval. Under macOS's
# Reduce Motion, or the Linux desktop's reduced-motion setting once the
# desktop has reported it, it is always "none". An animation draws a frame a
# display tick while it moves: the plasma, the fire and the ufo about 31 a
# 500 ms cycle at 120 Hz, the fade
# about 18, "none" two. The GPU and the CPU path, which Linux draws with,
# draw each animation the same, pixel for pixel; "none" draws nothing while
# the cursor is hidden. Linux draws each animation with the pixels a Mac
# draws: its math gives the same bits on macOS and on Linux.
#
# `trail`: what a cursor move leaves behind. "plasma", the default, is a faint
# tube in the cursor's colour over kitty's trail as it collapses onto the
# cursor, with three filaments braided into the cursor and ions curling off
# the path, dimming out over about half a second. "fire" is a flame rising off
# the same trail, burning out from the tail and shedding embers along the
# path. "lightning" is a jagged bolt from the old cell to the cursor that
# draws itself in, holds and fades in a third of a second, with forks, a
# corona and falling sparks. "ice" lays a lace of frost crystals along the
# path that holds, glints and melts tail first into falling hexagonal
# platelets, in about 0.7 s. "ufo" is a flying saucer that swoops along the
# path, hovers over the cursor, lowers a tractor beam onto it and flies off,
# in 0.72 s. "orb" is a glowing sphere that flies to the cursor with a halo
# and a comet's tail and bursts into sparks as it lands, in about half a
# second. "liquid" is a clear glass gel in the cursor's colour that stretches
# from where the cursor was to where it is, pinches and draws its back end
# into a drop round the cursor, which bulges as it lands, and fades, in about
# 0.4 s. "quad" is kitty's trail: a quadrilateral whose four corners chase the
# cursor's, the ones facing the move leading and the ones behind it lagging,
# over about half a second. Both follow a move of more than two cells once the
# cursor has rested for 10 ms, so typing and streaming output leave none.
# "sweep" is sfte's trail on the same moves: the cursor's box swept from a
# tail chasing it, fading from half the cursor's colour at the cursor to
# nothing at the tail. "ghost" is a one-cell box sweeping from the cell the
# cursor left to the cell it reached. "off" is none; true and false still mean
# the default and "off". An idle terminal pays nothing for any of them,
# because only a cursor that moved leaves one. Every trail is drawn on the GPU
# and on the CPU path, which Linux draws with: "quad", "sweep" and "ghost" as
# the same pixels on both, and each of the others within one step of 255.
# docs/cursor.md shows each, and docs/cursor.html plays them. Under macOS's
# Reduce Motion, or the Linux desktop's reduced-motion setting once the
# desktop has reported it, the default is off; a trail named here is kept, so
# take the # off the `trail` line below only to keep a trail whatever that
# setting says.
#
# `trail_scroll`: when output scrolls the whole screen under a trail in
# flight, "ride", the default, carries the trail up with the text for at most
# two rows and then folds it into the cursor, so it lands while output
# streams. It does so whether the screen slides or jumps (`[scroll] mode`
# "smooth" or "normal"), in a full-screen program and with a status line; a
# scroll of part of the screen, a region a program sets such as the text
# above its own status line, leaves the trail where it was. "stay" draws it
# where the screen had it, as before the ride was built, and under a smooth
# scroll may lie over part of a sliding cursor for up to 60 ms. "ride" also
# takes a program's own scroll away from the cursor's move: when a program
# scrolls its text and keeps the cursor on its line, as helix and vim do on a
# wheel step, the trail moves with the text and only the rest of the move
# trails; under "stay" that move trails as any other.
#
# `guide`: "on" highlights the row the cursor is on with a pale blue band
# the window's width, iTerm2's cursor guide, so the cursor's line is easy
# to find. "off" by default. A program can turn it on or off for itself
# (iTerm2's OSC 1337 ; HighlightCursorLine) until the terminal is reset.
#
# `unfocused_hollow`: "on" draws the cursor as a hollow box round its cell,
# whatever its shape, while another window has the keyboard, so you can
# tell at a glance which window your typing goes to. "off", the default,
# draws it as it is drawn in front.
# [cursor]
# shape = "block"
# blink = "auto"
# blink_animation = "none"
# blink_interval_ms = 250
# stop_blinking_after = 0
# trail_scroll = "ride"
# unfocused_hollow = "off"
# trail = "plasma"
# guide = "off"

# transition: whether opening or leaving a full-screen program like vim or
# less slides its screen in over the one before, in a quarter of a second:
# the program's screen rises from below as it opens, and the shell's comes
# back down from above as it exits. The screen slides in faint and comes up
# to full once it lands, so moving text never flashes (it stays under the
# flash limits of the web accessibility guidelines, WCAG 2.3.1). What the
# program draws meanwhile shows at once, sliding with it. With macOS's
# Reduce Motion on, the new screen fades in instead. "off" by default; an
# idle terminal pays nothing for it.
#
# checksum: whether a program that asks for a checksum of part of the screen
# (DECRQCRA) gets one. Test suites such as vttest check what they drew this
# way. "on" by default; "off" leaves every request unanswered. A program
# can ask one cell at a time and so read back what is on the screen,
# including what other programs printed there; "off" stops that.
#
# logging: whether a program can log everything it sends to a file it names
# (xterm's CSI ? 46 h and OSC 46). "on" by default: the file is appended to,
# and only one you own that no one else may write; with no name the log is
# baud.log.<host>.<local date and time>.<pid> where the shell started, and a
# relative name is read from there. A program on the other end of an ssh
# connection, or a file you cat, can otherwise append to any such file,
# your shell's startup files included; "off" stops that.
#
# printing: whether a program can print (DEC's Media Copy, autoprint and
# printer controller mode). "on" by default: each print opens the macOS
# print panel, which shows what will print and nothing reaches paper until
# you press Print; a program that sends its output to the printer hides it
# from the screen until it is done, and the title says "Printing" meanwhile.
# Programs are told there is a printer only when macOS lists one. "off"
# tells every program there is no printer. Linux has no print panel yet,
# so programs there are always told there is no printer.
#
# notifications: whether a program can post a desktop notification -- a
# build or a long command saying it finished (OSC 9, OSC 777 and kitty's
# OSC 99). "on" by default: one shows while baud's window is not focused,
# or whenever the program asks for that, at most four at once and then one
# a second. On macOS the first asks your permission. "off" posts none, and
# a program asking whether baud shows notifications hears nothing back. A
# program's progress bar, in the Dock on macOS, shows either way.
#
# print_colour, print_rgb, print_background, print_rotated: how a picture a
# program prints (a ReGIS hard copy) is sent to the printer, each "off" by
# default as on DEC's VT340. print_colour "on" prints its colours, "off"
# black and white, every coloured pixel inked; print_rgb "on" names the
# colours in RGB rather than HLS; print_background "on" prints the
# background too, in colour only; print_rotated "on" turns the picture a
# quarter, counter-clockwise, to fit a large one down the page.
#
# exit_status: whether each command's result is shown beside its prompt,
# for a shell that marks its prompts (shell integration, OSC 133): a filled
# dot when it succeeded, a cross when it failed and a ring when it was
# cancelled, in the theme's blue, red and grey. "off" by default. "on" gives
# the marks a column of their own at the left, so the text has one column
# fewer; a command still running, or one the shell reported nothing for,
# has no mark.
#
# badge: whether a program's badge is shown -- a large faint label in the
# top right of the window, behind the text, such as the host you are on or
# the branch you are working in, which programs and shell scripts written
# for iTerm2 set (OSC 1337 ; SetBadgeFormat). "on" by default; "off" hides
# it.
#
# substitute_mark: whether a program's SUB control -- which marks a character
# lost on the way, and cancels an escape sequence cut short -- shows a mark
# where it arrived, as DEC's VT220 to VT500 and xterm show one. "off" by
# default, showing nothing; "on" shows substitute_character there, in the
# colours around it. substitute_character is one character, written as itself
# or as a \u escape, that is one cell wide under every width setting: § or ¿,
# one cell by default and two under ambiguous_width = "wide", is refused.
# DEC's reversed question mark, U+2426, is the default; a character that does
# not fit is named in the message row and U+2426 is used.
#
# prompt_at_bottom: whether the shell's prompt sits on the window's last row.
# "on" draws each new prompt there -- in a new window, after clear, after
# Control-L, and when the shell redraws its prompt after the window grows,
# as bash and zsh do -- with earlier output staying where it was and blank
# rows between; a prompt of several lines lands whole, its last line on the
# last row, and once the window is full every prompt is there anyway. A
# window made smaller moves its top rows into the scrollback, as it does
# whenever the prompt is on the last row, and growing it brings them back.
# It needs a shell that marks its prompt and where the typing begins (OSC
# 133 A and B, as fish, nushell and Ghostty's shell integration send) and
# leaves full-screen programs alone. Turned on at a prompt, that prompt
# moves down at once. "off" by default: the prompt follows the output down.
#
# wrap_words: finished text wraps at its words. A word that does not fit at
# the end of a line moves whole to the next one, where "off" cuts it at the
# last column as the program wrote it. It covers text you scroll back to
# and, with a shell that marks its prompts (shell integration, OSC 133), the
# output above the prompt you are at; the line you are typing, a command
# still running and full-screen programs keep the program's lines, and so
# does output the window was narrowed past while the shell waited at its
# prompt. Copying gives the text as the program wrote it either way, except
# while a program has set ?96, when a copy follows the lines as drawn. A
# path wraps before its slashes, /home then /jordan, and moves to the next
# line whole after a space; a Windows path wraps at its backslashes. "on"
# by default.
#
# wrap_marker: a small hook arrow in the window's padding beside each line
# wrap_words carried on, on the right for a right-to-left line. It takes no
# column and is never copied; a full-screen program's screen and lines a
# program wrapped at the edge have none, and with padding = 0 there is no
# room for it. "on" by default.
# [screen]
# transition = "off"
# checksum = "on"
# logging = "on"
# printing = "on"
# notifications = "on"
# print_colour = "off"
# print_rgb = "off"
# print_background = "off"
# print_rotated = "off"
# exit_status = "off"
# badge = "on"
# substitute_mark = "off"
# substitute_character = "\u2426"
# prompt_at_bottom = "off"
# wrap_words = "on"
# wrap_marker = "on"

# How output scrolls the screen: "normal" jumps it up in one step, "smooth"
# slides it. "smooth" by default -- the slide is bounded to one row so a fast
# burst snaps forward rather than accumulating lag, and an idle screen pays
# nothing, so the added latency is bounded rather than a reason to opt out.
# Set "normal" for an instant jump with no slide.
# [scroll]
# mode = "smooth"

# How much memory the image store (Sixel and kitty graphics) is given:
# pixels_mb bounds the DECODED images (a 1024x1024 picture is 4 MiB whatever
# its Sixel or PNG encodes to). It is the one limit on an image's size,
# beside the 65535 pixels a side and 32 images at once: a Sixel is decoded as
# its bytes arrive and the bytes are not kept, so a long Sixel is no
# different from a short one. An image past the arena is refused (and
# counted) rather than shown in half.
# On macOS it also bounds the picture a program written for iTerm2 names
# for a notification: a larger one is left out and the text still shows.
#
# The default, 95 MiB, holds three 3840x2160 screens decoded, the "few full
# screen images" kitty's protocol asks a terminal to allow, and costs nothing
# until an image comes: the store's memory is committed as images write it.
# Until 2026-10-14 the raw bytes were held first, under a second key,
# body_kb: at its 256 KiB a UI screenshot (334-390 KiB at 600x375), a photo
# (474-680 KiB at 600x800) and a page of a text PDF (797-820 KiB at 600x776)
# were refused and the pane stayed blank. body_kb limits nothing now, and
# naming it logs a line saying so. Each refusal logs one warning naming the
# limit and the sizes, on stderr, so it shows when baud is launched from a
# terminal and not from the Dock.
#
# advertise_sixel makes the Primary DA claim Sixel (attribute 4), so a
# previewer such as yazi draws a real image instead of its text fallback --
# chafa's grid of block elements, box-drawing strokes and coloured spaces.
# Off by default: the text preview is what baud is proven to draw right, and
# the claim is the reader's to make.
#
# animation: whether an animated picture (kitty's protocol) plays. "os", the
# default, plays it unless Reduce Motion is on or "Auto-play animated images"
# is off in macOS's Accessibility settings (on Linux, unless the desktop's
# reduced-motion setting is on); "on" always plays it; "off" holds every one
# at the frame it shows.
#
# kitty_string_end: where a picture command of kitty's protocol ends.
# "standard", the default, reads it as every other control string: only
# ESC \ ends it, and a bare ESC, CAN or SUB inside it cancels it, so what a
# program writes into a command -- a player's status line, or the sequences
# that restore the screen when it quits -- runs and prints, and a picture
# cut that way is not shown. "kitty" ends it only at BEL or ESC \: every
# other byte is part of the command, nothing inside it runs or prints, and
# a command left open swallows what follows until a BEL or ESC \ arrives.
# [images]
# pixels_mb = 95
# advertise_sixel = false
# animation = "os"
# kitty_string_end = "standard"

# Whether a program can put text on the clipboard with OSC 52: remote
# Neovim, tmux's copy mode or a multiplexer over ssh, which have no other way
# to reach this Mac's pasteboard, or on Linux the desktop's clipboard and
# primary selection. "write" lets them, "off" refuses every copy and logs
# once that it did. Reading the clipboard back is always refused --
# what a program would read is whatever you last copied.
#
# The price of "write": anything printed to the terminal, a file you cat
# included, can replace the clipboard without asking. Every accepted copy is
# counted in the five-second report, logged at BAUD_LOG=info; the default
# level, warn, shows only refusals.
#
# body_kb is the largest copy, in KiB of the base64 the program sends: 256
# holds 192 KiB of text. A longer copy is refused whole, never cut, and logs
# a warning naming this key.
# [clipboard]
# osc52 = "write"
# body_kb = 256
# Whether finishing a selection with the mouse copies it. "on" by default:
# on macOS the selection goes to the clipboard as you let go; "off" leaves
# the clipboard to Cmd-C, unless a program asks for copy-on-select itself
# (xterm's ?1041). On Linux a finished selection sets the primary
# selection, which the middle button pastes, as Linux terminals do, or the
# clipboard while a program has asked for that with ?1041; this key
# changes neither.
# copy_on_select = "on"
#
# select: where SELECT puts a selection you make on Linux and a program's
# copy that names no selection, and what a middle click pastes, while no
# program has asked for the CLIPBOARD selection (?1041). "both" sets the
# CLIPBOARD and PRIMARY selections, so Ctrl+V pastes it too; "primary" the
# PRIMARY selection only; "clipboard" the CLIPBOARD selection only.
# select = "both"

# baud's short messages, such as the words a copy says, are drawn in a box of
# their own, opaque, in two colours a program cannot change.
#
# [message]
#
# The box's colour: "baud", amber on dark, on light and under every theme;
# "#rrggbb"; or "none", the selection's colour, read as each frame is drawn.
# Keep it quoted: an unquoted # starts a comment. A pair of fixed colours that
# reads under 4.5:1 is refused and said, and baud's stay; with "none", a pair
# under 4.5:1 at the moment it is drawn draws in baud's instead.
# box_color = "baud"
#
# The text's colour, the same way.
# text_color = "baud"

# What baud says when something is copied: "Copied 42 characters", or "A
# program copied 42 characters" for a program's OSC 52, never the text. On
# Linux a copy you make names the selections it went to: "Copied 42 characters
# to the clipboard and the primary selection" by default. It goes after 1.5
# seconds or at any key, which still reaches the program.
#
# [message.copy]
#
# "on" or "off". "off" stops the words, the pulse and VoiceOver's announcement.
# enable = "on"
#
# Where a copy of your selection is said: "tip", the row under it, or above it
# on the last row; or "bar", the bottom of the window. A program's copy always
# goes at the bottom. While Cmd (Ctrl on Linux) shows a link's address, no words
# show.
# place = "tip"
#
# "on" draws the selection in the box's colours for 150 ms when it is copied.
# Never under Reduce Motion or Dim Flashing Lights, or with both colours "none".
# pulse = "off"

# [message.held]
#
# How the line a link's window shows when its program fails at once is drawn:
# "box", in [message]'s box_color and text_color like every message of baud's;
# or "plain", like the program's text.
# look = "box"
#
# Where it goes: "tip", the row below the blank one under what the program
# printed; or "bar", the bottom of the window. While Cmd (Ctrl on Linux) shows
# a link's address by the link, or at the bottom with the line there too, the
# line hides and comes back after; at the bar a copy's words hide it the same
# way.
# place = "tip"

# [message.link]
#
# Where a link's address shows while Cmd (Ctrl on Linux) is held over it:
# "tip", the row under the link, or above it when the link is on the last
# row; or "bar", the bottom of the window.
# place = "tip"

# How links show. A web, mail or file link is underlined as it appears, whether
# a program marks it or prints the address as plain text. Cmd-click (Ctrl-click
# on Linux) opens it and a plain click selects, whatever these say.
#
# [link]
#
# "on" or "off". "off" draws no line and no look under the pointer, and does no
# work for either; Cmd-click (Ctrl-click on Linux) still works.
# urls = "on"
#
# "on" or "off". A file path printed as plain text, starting with /, ~/, ./
# or ../, or a file name alone such as README.md, is underlined once baud
# has checked that the file exists on this computer. The check runs on a
# thread of its own and never holds up drawing, and looks nothing up on a
# network or automounted disk. A ./, a ../ or a name alone needs your shell
# to report its folder with OSC 7, naming this computer. A click shows the
# file in Finder (the file manager on Linux), and never opens or runs it.
# "off" checks nothing.
# paths = "on"
#
# "on" or "off". A link a program cut at the edge of the window itself, as a
# multiplexer repainting a full-width pane a row at a time does, is read on
# into the next row: where the row ends in the link at the last column and the
# next row starts in the link's characters, written by the same kind of
# program, here or over ssh. The whole address is underlined, shown under the
# pointer and opened, as across a line that wraps. "off" reads each row alone,
# and an address cut that way gets no line. A pane narrower than the window
# has no edge baud can see, and is never joined.
# join_rows = "on"
#
# The line at rest, in [message]'s box_color, baud's amber #F4A32C unless you
# set it, and under the pointer, or with hover = "line", in the text's own
# colour: "solid", "dotted" or "off". A
# program's own underline stays, and an address that may have been cut, or that
# a click would refuse, gets no line.
# line = "solid"
#
# The link under the pointer with no key held: "box", in [message]'s colours;
# "line", a line in the box's colour; or "text", the text in the box's colour
# where it reads at least 1.5:1 on the cell's own background.
# hover = "box"
#
# A link baud knows would open nothing: "strike" draws it struck through, or
# "off" draws it as any other. Struck at rest: a link to a file on this Mac
# whose file is gone, when the program marked it and named this computer as
# its host, and a kind of link no app on this Mac opens. A path printed as
# plain text, or a file link that names no computer, is struck only while
# Cmd (Ctrl on Linux) is held over it, and the bar says it is not on this
# computer. Anything baud can't be sure of is never struck: a file on another
# computer, over ssh, on a network disk, or one it couldn't check. Struck
# text still selects and copies as written, and a click on it opens nothing
# and says why. On Linux no kind of link is struck, since the system falls
# back to a browser for one it has no app for.
# missing = "strike"
#
# The struck text's colour: "gray", the theme's color 8; "#rrggbb"; or
# "none", the text's own. It is used only where it reads at least 4.5:1 on
# the cell's background, in the colours on screen then, so a program can't
# make a struck link unreadable. Elsewhere the text keeps its colour, and the
# strike shows either way.
# missing_color = "gray"

# Printed file paths: which kinds are read, and what a click does. Every kind
# is checked as paths above: the file must be on this computer. A key or value
# baud doesn't know here ignores the whole section, with a warning.
#
# [link.path]
#
# The kinds read: "/", "~/", "./", "../"; "relative", a path with no prefix
# and a / inside such as src/app.rs, which ends before an = so the path in
# --file=/tmp/a is /tmp/a; "name", a file name alone with a dot in
# it, such as README.md, Cargo.toml or .zshrc; and "word", any name alone,
# such as Makefile or src. Like ./, the last four need your shell to report
# its folder, and get no line in a multiplexer. A name lights only when a
# file of exactly that name is in the folder, so a version number or a
# word in a sentence gets no line. Leave "name" out to turn names off.
# forms = ["/", "~/", "./", "../", "relative", "name"]
#
# How a name or word found is drawn: "line", underlined like any other
# link, or "hover", lit only under the pointer.
# names = "line"
#
# "on" reads a :12 or :12:3 after a path as a line and a column, for a
# command's {line} and {col}.
# line_col = "off"
#
# "on" lets a path inside quotes hold spaces, up to the closing quote.
# spaces = "off"
#
# What a click does. "reveal", the default, shows a clicked file in Finder
# (the file manager on Linux), and never opens or runs it; "command" hands it
# to the command below, and is what a command named alone means; "window"
# runs the command in a new baud window of its own, in the file's folder,
# for a program that draws in a terminal, such as an editor: ["hx",
# "{path}"], the window closing when it ends; "copy" puts its path on the
# clipboard; "off" is the same as paths = "off" above. Any value but
# "command" or "window" beside a command ignores the section, so this
# example names "command" with its command.
# action = "command"
#
# The program a click runs, then its arguments: {path} is the file's full
# path, {line} and {col} the numbers after it with line_col on, else 1. No
# shell runs it, and its output goes nowhere. A name with no folder is looked
# up on PATH, which for a baud started from the Dock is the system's short
# one; a full path always works.
# command = ["/usr/bin/env", "code", "-g", "{path}:{line}:{col}"]
#
# With "window", what runs on another computer when you click a file link
# a program printed inside an ssh session: a new window runs ssh to that
# session, and that computer runs these strings, {path} the file's path
# there. A program under ~/ is under your home folder there, not this one.
# Unset, it is the command above as you wrote it.
# remote = ["hx", "{path}"]

# Your own link types: a [link.NAME] section adds a kind of link, such as
# tel: or ssh://, or changes what a click on web, mail or file links does.
# None is set out of the box. Rules come only from this file, never from a
# program, and whatever a rule says, the address still shows under Cmd (Ctrl
# on Linux), a link with a part that starts with - is refused, and a file
# link must be on this computer. A key or value baud doesn't know ignores the
# whole rule, with a warning. The guide's "Your own link types" has the rest.
#
# [link.tel]
#
# The links the rule takes: this scheme and a colon. The section's NAME if
# left out. javascript, data, vbscript, blob and about can't be named.
# scheme = "tel"
#
# "open" hands the link to the app your system has for it; "command" runs
# command; "window" runs command in a new baud window of its own, in the
# folder of the window you clicked in, for a program that draws in a
# terminal, such as the text browser in ["w3m", "{url}"]; "copy" puts the
# link on the clipboard and opens nothing; "off" turns the scheme off. Left
# out, it is "command" when a command is named, else "open".
# action = "open"
#
# [link.https]
#
# The program a click runs, then its arguments, {url} standing for the whole
# link. No shell runs it, so {url} is one argument whatever it holds; a rule
# that puts {url} in a script, after sh -c, osascript -e or the script flag of
# an interpreter baud knows (-c, -C, -e, -E, -m, -p or -r, by interpreter), is
# ignored. Beside action = "window", the same command runs in a new baud
# window of its own, for a program that draws in a terminal.
# command = ["/usr/bin/env", "open", "-a", "Firefox", "{url}"]
#
# [link.mailto]
#
# Turn one of baud's own off: mail links get no line, and a click on one
# opens nothing, whether a program marks it or prints it.
# action = "off"

# Whether a program can move, resize, minimise, raise, lower, maximise or
# full-screen the window (xterm's window operations, CSI 1 t to CSI 10 t, and
# DECSLPP, which asks for a number of lines). "on" by default, as xterm ships
# them; "off" refuses every one. A program on the other end of an ssh
# connection, or a file you cat, can otherwise move the window off the
# screen, shrink it or hide it; "off" stops that. Programs can still ask
# where the window is and how big it is either way.
# [window]
# operations = "on"
# Nine small lights, as on a modem's front panel: HS (High Speed) while
# the program's output floods in, AA (Auto Answer) when baud answers the
# program on its own, CD (Carrier Detect) while the program in front is
# ssh with its connection up, OH (Off Hook) while a program other than the
# shell is in front, RD (Receive Data) and SD (Send Data) when baud
# receives data from the program and sends data to it, CS (Clear to Send)
# while the program takes what baud sends, out while it is not taking it,
# FAX while a picture is shown, and SYN while the program holds the screen
# to draw it at once. Hold the pointer over one to see what it means. They
# follow Reduce Motion (steady) and, on macOS, Dim Flashing Lights (no
# glow). They sit on a plate of your theme's background, and every
# lamp is one of your theme's sixteen colours exactly.
#   "title_bar"    a modem's panel at the right of the title bar (macOS):
#                  baud's logo and the nine on one plate, each lamp over its
#                  letters. With the lights anywhere else there is no plate
#                  in the title bar, and the logo is beside its buttons
#   "top_line"     on a thin line of their own above the program's first
#                  line, only as tall as the lights and right-aligned on
#                  it; the program is never told about it (Linux, which
#                  has no title bar)
#   "bottom_line"  the same line under the program's last line
#   "on"           your system's place: the title bar on macOS, the
#                  top line on Linux
#   "off"          nowhere, and nothing is read for them
# activity_lights = "on"
# Which of your theme's sixteen colours each light is lit in:
#   "meaning"  baud's own: one colour for each kind of thing, CS green
#              for a clear line; on a dark theme HS 10, AA 11, CD 4,
#              OH 6, RD 2, SD 3, CS 2, FAX 5, SYN 13, and on a light one
#              no yellow: AA 6, OH 12, SD 14
#   "iec"      the IEC 60073 standard's colours for an indicator's
#              meaning: HS, CD and CS green 2, FAX and SYN cyan 6, the
#              rest white 7
#   "modem"    every light red 1, as the modems' front-panel lamps were
# An unlit light is a dot half the size, colour 8 in every set.
# activity_lights_colours = "meaning"
# How strongly a lit light glows, 0 (none) to 1 (the strongest): a soft
# halo of its own colour a point off the dot. A value outside 0..1 is held
# to it. Dim Flashing Lights (macOS) always draws none.
# activity_lights_glow = 0.4
# Whether DEC's indicator status line, when a program shows it, also
# carries five of the lights as words in its free columns, after the
# printer: CD, OH, CS, FAX and SYN, each there while what it shows holds,
# and following it within the 80 milliseconds DEC's standard gives the line
# rather than at the lights' calm pace. CD or OH reads CD? or OH? when baud
# cannot tell: the system would not let baud look, or, for CD on Linux,
# baud has no way to look yet. HS, AA, RD and SD never go there: the line
# shows what is true, not what just happened. Past 37 points of the default
# font the words are left out, so they never flash past the web
# accessibility guidelines' limit (WCAG 2.3.1). Hold the pointer over a
# word to see what it means, the same words as the light's own hover
# text; the box stays while the pointer is on the word or the box, and
# any key you type hides it. "off" by default, the lights then only where
# activity_lights puts them; "states" adds the words. Both macOS and
# Linux.
# status_line_lights = "off"
# Whether the desktop may show a frame the moment it is drawn, even partway
# through the screen's refresh: the least delay, at the price of a moving
# picture sometimes cut along a line. "off" by default, so every frame
# waits for the refresh; "on" asks the desktop, where it offers that, and
# the desktop still decides. Linux only: on macOS frames always wait.
# tearing = "off"

# baud's colour logo in the middle of each window as it opens, the first
# and every one you open after it: it comes out of a burst of plasma from
# left to right, and as soon as it is whole a quick sweep takes it out
# from left to right, gone half a second after it starts. Nothing waits
# for it: your keys go to the shell the whole time, and the shell's
# output and prompt show the moment they arrive, in front of the logo,
# which plays around them. With reduced motion on -- macOS's Reduce Motion, or the Linux
# desktop's setting once the desktop has reported it -- the logo shows whole
# and fades once your shell has drawn something (or half a second after the
# window opens, if it draws nothing).
# "on" by default; "off" turns it off. Saving "off" while it shows takes
# it down at once.
# [launch]
# splash = "on"

# Whether baud marks your shell's prompts for it (shell integration), so
# the output above the prompt you are at counts as finished: it wraps at
# its words like the rest ([screen] wrap_words), each command's result
# can show beside its prompt ([screen] exit_status), and a list of
# completions stays on the screen. It covers the zsh, bash and fish baud
# starts for you ($SHELL). Your own startup files run as they always do,
# in the same order, and baud exports nothing of its own to the commands
# you run. fish 4 and later mark their own prompts, and baud adds nothing
# to them; in fish 3 baud marks each prompt and command but not where
# your input begins, which only a fish_prompt of baud's in place of yours
# could. Startup files that already mark the prompt (WezTerm's, kitty's
# or Ghostty's shell integration) keep their own marks. In zsh and bash
# your startup files can test the shell variable BAUD_SHELL_INTEGRATION,
# and unsetting it keeps baud's marks out of that shell; fish reads its
# configuration before baud's marks are added. bash 4.4 or later gets the
# marks; macOS's own /bin/bash (3.2) and bash before 4.4 start as before,
# with no marks. bash-preexec 0.6.0 and 0.7.0, and Atuin's setup, which
# loads it, run as without baud; a bash that loads Atuin gets none of
# baud's marks, as Atuin's functions spell marks of their own. In bash,
# these differ from a shell without baud: from bash 5.1 a PROMPT_COMMAND
# you did not export is an array, yours first as it was and baud's entry
# last, so what your entries print counts as the last command's output; in
# that array your entries read $_ at the first prompt as the name of one
# of baud's functions rather than what your startup files left in it; an
# exported PROMPT_COMMAND passes baud's two entries on to the shells bash
# starts, where they mark nothing; with PROMPT_COMMAND exported or bash
# before 5.1, your own entries read the command's $?, but PIPESTATUS only
# as its last status and $_ as the name of one of baud's functions; a
# DEBUG trap of yours also runs before the commands of baud's entries, so
# one that starts a timer, as a command-duration prompt's does, starts it
# at the prompt; and an exported PS1, PS2 or PS0 keeps baud's marks while
# a command runs when another entry follows baud's in PROMPT_COMMAND, as
# bash-preexec's does, or when the line begins with a subshell ( ... ) or
# coproc. "on" by default; "off" starts every shell as any other terminal
# does. A change shows in the next window.
#
# program: the shell each new window starts, by its full path (or under
# your home folder after ~/), in place of $SHELL. Unset by default, which
# starts $SHELL, else the system's shell. baud starts it as it starts
# $SHELL: as a login shell, its prompts marked when its name is zsh, bash
# or fish, and the shell and what it runs see it as their $SHELL. Opened
# from the Dock or Finder, baud is given the shell your account names,
# which can be another shell than the one your other terminals run. A
# path that is not absolute, or names no file you may run, shows a notice
# and the window starts the default shell. A change shows in the next
# window. The line below names /bin/sh only because every system has it at
# that path, and a bare name is not looked up; sh gets no prompt marks, so
# name your zsh, bash or fish by its own full path.
#
# ssh_env: "on" makes ssh typed in the zsh, bash or fish baud starts ask to
# send COLORTERM and TERM_PROGRAM, as ssh -o SendEnv=COLORTERM -o
# SendEnv=TERM_PROGRAM, so a program on the other computer that reads
# COLORTERM draws in all its colours. The other computer keeps them only
# where its sshd_config names them in AcceptEnv (Debian 13 does, Debian 12
# does not). An ssh function or alias of yours is kept. A program that asks
# the terminal, as Neovim does, finds baud's colours over any ssh anyway.
# "off" by default.
# [shell]
# integration = "on"
# ssh_env = "off"
# program = "/bin/sh"

# How keys behave before a program asks otherwise, the four keyboard modes a
# DEC terminal lets you set in its Set-Up screen. A program can still change
# each one; saving a different value here while baud runs (with
# config_reload on, the default) changes it in the open windows at once, and
# leaves the rest as the program set them.
#
# auto_repeat: a held key repeats. "on" by default.
# application_cursor_keys: the arrow keys send the codes programs ask for
#   with DECCKM (ESC O A rather than ESC [ A). "off" by default.
# new_line: Return sends a carriage return and a line feed, and a line feed
#   received also returns to the first column (LNM). "off" by default.
#
# A new window starts with these three, and a full reset (RIS) returns to
# them; a soft reset (DECSTR) turns application_cursor_keys off, as a DEC
# terminal does, and keeps the other two.
#
# application_keypad: the numeric keypad sends the codes programs ask for
#   with DECKPAM (ESC O p for 0) rather than its digits. As on the VT420 and
#   VT510, it is not kept: changing it here switches the open windows'
#   keypad, and a new window or a reset starts with digits. "off" by default.
# [keyboard]
# auto_repeat = "on"
# application_cursor_keys = "off"
# new_line = "off"
# application_keypad = "off"

# Whether a key you type hides the mouse pointer until the mouse moves, as
# xterm does. "on" by default: it hides unless a program is using the mouse
# (vim with mouse support, htop, tmux), when the pointer stays so you can
# click. "off" never hides it. A program can choose differently for itself
# (xterm's XTSMPOINTER); a reset returns to this.
# [pointer]
# hide_while_typing = "on"

# Whether a program can change the font (xterm's OSC 50): name one of the
# faces baud has loaded -- the embedded font or a font this file lists
# above -- by its family, full or PostScript name, as `fonts` does (the
# embedded font's family is "baud Mono", its bold "baudMono-Bold"), or
# make the text bigger or smaller a step at a time, within 6 to 72
# points (on Linux, which has no size keys, the step and the bounds are in
# pixels of the configured size). "on" by default; "off" refuses every
# change. A program can ask which font is in use either way, and gets back
# the name it set.
# [font]
# changes = "on"

# What a point is on Linux. "desktop", the default: 96 dots to the inch
# times the desktop's text scaling (its text-scaling-factor, read through
# the settings portal), so font_size here matches the same number in the
# desktop's other windows; a change
# of the desktop's text scaling resizes the window. "physical": the
# output's own dots to the inch, from the size in millimetres it reports,
# or the desktop's where that size is unknown or not plausible. Or a
# number of dots to the inch, from 50 to 500. macOS reads none of this.
# A change shows in the next window.
# dpi = "desktop"

# The fonts a program can switch its text to: SGR 11 to SGR 19 ask for
# the first to the ninth alternative font, and SGR 10 for your ordinary
# one. Name each as in `fonts`, by family or by file; an empty name leaves
# that font unset, and text in an unset font draws in your ordinary font.
# Bold and italic come from each family's own faces, and a character the
# font lacks from your ordinary fonts. None by default.
# alternatives = ["Fira Code", "", "Menlo"]

# The face Fraktur (Gothic) text draws in, as SGR 20 asks for, named as in
# `fonts`. baud carries no Fraktur face, so with none named here Fraktur
# text draws in your ordinary font. A character the face lacks comes from
# the alternative font the text is in, if any, then your ordinary fonts.
# fraktur = "UnifrakturMaguntia"

# The window's material and how it is dimmed. Every key here is one the
# macos-liquid-glass example sweeps with a GN_* environment variable -- the
# content both its examples draw, and what was built as "glassterm". The
# material and the two dims follow Apple's guidance: the regular material for a
# surface that is mostly text, and dims that keep text at 4.5:1, Apple's
# minimum contrast, whatever is behind the window. The rest are that example's
# own calibration, a starting point, which is why they are keys.
#
# Four of the eight are PAIRS, because macOS light/dark is two different
# surfaces: the same darkening that reads right over a dark desktop is far too
# much over a light one. baud picks the one the system appearance names and
# changes it when that changes -- so does the palette, unless "theme" above
# pins it. On Linux the dim follows the half of the palette drawn, which
# "theme" and the desktop's light or dark setting decide, and the style,
# tint, hue, saturation and shadow keys have no counterpart at all.
# [glass]

# Which material. "standard", the default, is macOS's standard see-through
# window material, the one Apple's guidelines put behind an app's content:
# the desktop shows through faintly, and Apple draws it subdued while
# another window is in front. "regular" is Liquid Glass, frosted, and
# "clear" the thinner, more see-through Liquid Glass, which Apple keeps
# for controls over photos and video.
# style = "standard"

# The body dim, `dim_dark` and `dim_light`: the opacity EVERY background is
# painted at, 0 clear to 1 opaque, so the desktop shows through it. Not just the default background --
# a colour an application sets is translucent too, so btop and anything else
# that paints its own panels is see-through rather than a slab. The defaults keep the
# default text at 4.5:1 or more over a white desktop and over a black one; turn them down to see more of the desktop, at the cost of text over a bright
# window behind. One background is drawn more solid than the dim: a
# reversed default one -- the status bar less and vim draw in reverse video,
# DEC's status line, and the whole screen under reverse-screen mode (?5) --
# whose text is the default background's colour. It is raised just far
# enough for its text to read at 4.5:1 too over any desktop, on every
# material: 0.68 with the light palette at 0.60, while the dark palette's
# 0.70 and Linux's light 0.85 already read. On Linux `dim_light` defaults
# to 0.85: nothing light is under the page there, only the desktop's blur,
# which the desktop may darken. While Accessibility's
# Reduce Transparency is on, every background and the margin are drawn
# opaque, whatever these say. `dim_light` below is macOS's default.
# dim_dark = 0.70
# dim_light = 0.60

# Whether a background an application sets is dimmed with the default one.
# "dim" draws it at the body dim, so btop's panels are see-through. "opaque" draws
# every background an application sets as it chose it, and leaves only the
# default background see-through, so btop's panels are solid.
# app_backgrounds = "dim"

# Under "dim" above, whether a picture drawn in text keeps its backgrounds
# solid. A file manager's photo preview (chafa, when there is no Sixel) is a
# glyph on a background in every cell; dimmed, the backgrounds turn to holes
# between solid glyphs and the photo reads as noise. "opaque" finds the
# pictures -- a connected block of set backgrounds with sixteen or more
# colours, which a photo has and no measured TUI panel does (the busiest,
# vim's diff mode, has 8) -- and draws only those solid. "dim" dims them too.
# pictures = "opaque"

# How a Sixel image's solid background draws on the see-through window
# (an image that asks for one, P2 0 or 2). "opaque", the default, draws it
# solid, as on an opaque window. "dim" draws it see-through at the body dim
# over the text, which shows through it, faded. "clear" clears what is
# under it to the see-through background, as erased cells look.
# sixel_backgrounds = "opaque"

# The glass darkening, `tint_dark` and `tint_light`, applied to the material
# itself rather than as a layer over it, so the titlebar strip and the body are one surface. 0 turns
# it off. It and the hue and saturation below darken Liquid Glass only;
# the standard material has no tint.
# tint_dark = 0.54
# tint_light = 0.14

# The darkening's hue and saturation, 0 to 1 each. Not black: black scales
# every channel equally, so it cannot shift the material's hue, only scale the
# colour down -- the harder it darkens, the less colour survives. 0.60 is a
# blue.
# hue = 0.60
# saturation = 0.80

# Whether the window casts a shadow: "auto", "always" or "never". "auto" casts
# one only under a dark appearance -- over a light material a window shadow
# draws as a hard black outline, which none of the system's own light glass
# surfaces have.
# shadow = "auto"
