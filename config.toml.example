# baud configuration -- copy to ~/.config/baud/config.toml and edit.
#
# Looked up at $BAUD_CONFIG, then $XDG_CONFIG_HOME/baud/config.toml, then
# ~/.config/baud/config.toml -- no entry of its own under the directory baud is
# started in. A relative $BAUD_CONFIG names a file under that directory; an
# empty or relative $XDG_CONFIG_HOME is ignored, as the XDG specification says.
# A relative font or theme path below names a file beside this one. A key baud
# does not know is ignored, and any field left out keeps its built-in default,
# so a config with only the keys you care about is fine -- or no config at all,
# which draws with the fonts baud carries inside itself: JetBrains Mono (its
# ligatures, and real Bold, Italic and Bold Italic faces) with baud's own Hebrew
# in its Regular and Bold, and Symbols Nerd Font Mono (the Nerd Fonts icons),
# with Menlo, the emoji, symbol and CJK system faces behind it. `fonts` below
# replaces that stack, and the embedded Regular, icon and symbol faces stay
# behind it for what your faces lack unless `font_fallback = false`.

# Points; pixels are this times the display's backing scale.
font_size = 13

# The gutter in points around the grid -- left, right and below -- so the glass
# shows through rather than the cells meeting the window's edge. The titlebar
# strip is the top gutter. 8 is the default; 0 turns it off.
padding = 8

# The palette. "auto" follows the system appearance (System Settings >
# Appearance) and changes with it; "dark" and "light" pin it. On Linux "auto"
# resolves to dark, because no appearance signal is wired there yet.
#
# The sixteen ANSI colours are xterm's on the dark palette and Modus Operandi's
# on the light one (by Protesilaos Stavrou, GPL-3.0-or-later), whose six
# colours and their bright forms read at 6:1 or better on its page. When the system flips under "auto",
# colours a program set with OSC 4, 10, 11 or 12 are dropped with the old
# palette, and a program that asked (mode 2031) is told dark or light.
theme = "auto"

# What the surface's bytes mean, converted to each display by the compositor:
# "srgb", which every colour a terminal receives is specified as, or
# "display-p3" to read the theme's numbers as the wider gamut on purpose.
colorspace = "srgb"

# How wide a text-default emoji is when a U+FE0F asks for emoji presentation,
# such as a heart followed by U+FE0F. "two" cells, which tmux, fish, macOS
# bash, helix and lipgloss assume; "one" for a session whose programs measure
# with a legacy wcwidth (zsh prompts outside tmux, readline and ncurses on
# glibc). DECRQM ?2027 reports it; nothing an application sends changes it.
vs16_width = "two"

# How a character with no variation selector is drawn. "font": from a text
# face, whatever its default presentation (a lightning bolt is the font's
# bolt). "system": a character whose default presentation is emoji is drawn
# in colour, as macOS draws it. U+FE0F asks for colour and U+FE0E for text
# under either.
emoji = "font"

# What a BEL (Control-G) does while baud's window is focused: "sound" plays
# the system's alert sound, "flash" shows the screen in the other video for
# the 100 ms the xterm-256color entry's flash names -- not under Reduce
# Motion, and nothing in its place, nor in a minimized window -- and "none"
# does neither. While the
# window is not focused nothing sounds, and whatever this says, a program
# that set mode 1042 makes the Dock icon bounce and one that set mode 1043
# raises the window, unless it is minimized. Bells within one frame ring
# once. macOS only: the Linux driver rings nothing yet.
bell = "sound"


# The fallback stack, first face first: a face supplies the glyphs the faces
# before it lack. A ".ttc" collection may carry "@N" to pick a face in it.
#
# Left unset, the stack is the embedded JetBrains Mono, with baud's Hebrew in
# its Regular and Bold, and its icon face, then the system's mono, its colour
# emoji, and its symbol and CJK faces, with the embedded Bold, Italic and Bold
# Italic for styled text. Set, it replaces that stack -- and the embedded faces
# still follow it: the embedded Regular, so Hebrew none of the named faces
# carries comes from it, then the icon face, so a Nerd Fonts icon does, rather
# than either drawing as a missing-glyph box. The embedded Regular also takes
# whatever else JetBrains Mono maps that your faces lack -- behind FiraCode,
# 458 code points by cmap, among them 8 symbols (U+23FB-23FE, U+26A1,
# U+276E-276F, U+2B58) that drew from the icon face before -- so those come
# from it, not the icon face. A stack named here draws bold and italic in its
# regular faces, unfaked, until faces can be named by family. A path that does
# not start with / is read beside this file, so "fonts/Mine.ttf" is the fonts
# directory next to it:
# fonts = [
#   "/System/Library/Fonts/Menlo.ttc@0",
#   "/System/Library/Fonts/Apple Color Emoji.ttc@0",
#   "/System/Library/Fonts/Apple Symbols.ttf",
# ]

# Whether the embedded Regular, the icon face and STIX Two Math follow a `fonts`
# stack you named. true, the default, keeps them behind your faces, in that
# order; false leaves the stack exactly as named.
# Without `fonts` it changes nothing: the embedded faces are the stack then.
font_fallback = true

# For FiraCode with programming ligatures, point the first face at its file and
# keep the emoji and symbol fallbacks -- FiraCode has neither:
# fonts = [
#   "/path/to/FiraCode-Regular.ttf",
#   "/System/Library/Fonts/Apple Color Emoji.ttc@0",
#   "/System/Library/Fonts/Apple Symbols.ttf",
# ]

# For CJK coverage (Japanese, Chinese, Korean), stack a CJK face before the
# emoji and symbol fallbacks. Hiragino Sans GB covers Japanese kana and Chinese
# Han; Apple SD Gothic Neo covers Korean. A face earlier in the list wins per
# cluster, so keep your text face first:
# fonts = [
#   "/System/Library/Fonts/Menlo.ttc@0",
#   "/System/Library/Fonts/Hiragino Sans GB.ttc@0",
#   "/System/Library/Fonts/AppleSDGothicNeo.ttc@0",
#   "/System/Library/Fonts/Apple Color Emoji.ttc@0",
#   "/System/Library/Fonts/Apple Symbols.ttf",
# ]

# How many columns an East Asian Ambiguous character takes -- box drawing,
# block elements, Greek and Cyrillic letters, the plus-minus sign -- "narrow"
# (one, the default) or "wide" (two), for programs that count them as two,
# such as vim with ambiwidth=double. Set it only to match them: a program
# counting one column for such a character puts everything after it one
# column off. Private Use Area characters, the Nerd Font icons, stay one
# column either way. Under "wide" a box-drawing line or block is still drawn
# one cell wide, in the first of its two cells. Read at launch; DECRQM ?1021
# reports it.
[text]
ambiguous_width = "narrow"

# The contrast floor: text whose contrast with the colour it is drawn on is
# below this ratio is darkened or lightened, keeping its hue, until it reads
# at 4.5:1 -- or at this ratio, when it is higher. Only pairs a program did not
# choose outright: the same colour on both sides, or a page the program set as
# a 256-colour or truecolour value with its own text on it, is left alone, so
# pictures drawn in text are untouched while [glass] pictures = "opaque" draws them solid. The floor also covers text that
# [glass] app_backgrounds = "dim" makes unreadable: a page the program set,
# drawn at the dim over the window's own background, is measured as drawn,
# and text that reads at this ratio on the page as asked but not on the page
# as drawn is lifted; so is text that reads at 3:1 as asked and below 3:1 as
# drawn (or at this ratio, when it is higher). A pair below it as asked is
# still the program's. Box-drawing lines (U+2500-U+257F, where the lines and
# corners of DEC Special Graphics land) are left out: a divider is drawn in
# the colour asked. Block elements, which graphs are drawn with, are not. What
# a program asked for is unchanged in what the terminal reports; only the
# pixel moves. 1.2, the default, lifts only text that is nearly invisible;
# "off" turns it off.
#
# `light` and `dark` name a theme file for each half of the palette; `theme`
# above still picks which half is drawn. A theme is a base16 or base24 scheme
# (tinted-theming), or a ghostty, kitty or foot theme, told apart by what is in
# the file and not by its name; each load says what the file was read as. A
# foot file holding both [colors-dark] and [colors-light] is refused: save the
# half you want on its own. Theme files of other terminals are named for what
# they are, and a file mixing two formats is refused with the line of each.
# A value with a / is a path: ~/ is your home, and a path that does not start
# with / or ~/ is read beside this file. A bare name is looked up in the
# `themes` directory beside this file, then
# in $XDG_CONFIG_HOME/baud/themes/ and ~/.config/baud/themes/, as given and
# then with .yaml and .yml. What a file leaves unset stays baud's own, entries 16-255
# stay xterm's, and a file that cannot be read is reported and leaves baud's
# own half. On Linux, where `auto` is dark, a light half is drawn only with
# theme = "light".
[palette]
floor = 1.2
# light = "~/.config/baud/themes/day.yaml"
# dark = "night"

# The cursor: its shape -- "block", "underline" or "bar" -- and whether it
# blinks. This is the cursor the terminal starts with and the one it returns
# to when an application resets it; an application can still ask for another.
# `blink = "auto"`, the default, blinks and holds steady under Accessibility's
# "prefer non-blinking cursor" (macOS 15 and later). `true` blinks whatever
# that switch says, with a warning, and `false` starts the cursor steady. A
# blinking cursor blinks only while the window has focus, and shows at once on
# a key or on output. `stop_blinking_after` stops it, shown, after that many
# seconds without a key, a click or a paste -- output does not count; 0 is
# never.
#
# `blink_interval_ms`: how long each phase lasts, shown and hidden alike.
# Unset, macOS's `NSTextInsertionPointBlinkPeriodOn` and `...Off` are followed
# where you have set them, and each phase is otherwise 333 ms -- a symmetric
# 1.5 blinks a second, on Linux too. Set here, it wins over the system's keys.
# A phase is kept between 1/60 s and 60 s.
#
# `blink_animation`: what the cursor does while it is hidden. "plasma", the
# default, is the plasma trail's glow on the cursor's cell, swelling out from
# nothing to a faint ghost of the cursor and back across the hidden phase.
# "fade" eases the cursor out over the first 30% of the hidden phase and back
# in over the last 30%, gone in between. "fire" burns the cursor down into
# embers and relights it from the bottom, in the fire trail's look. "ufo" has
# a little saucer's beam lift the cursor away and set it back down, in the ufo
# trail's. "none" switches it hard. Each fits inside the hidden phase at any interval. Under
# macOS's Reduce Motion it is always "none". An animation draws a frame a
# display tick while it moves: the plasma, the fire and the ufo about 41 a
# 666 ms cycle at 120 Hz, the fade about 25, "none" two.
#
# `trail`: what a cursor move leaves behind. "plasma", the default, is a faint
# tube in the cursor's colour over kitty's trail as it collapses onto the
# cursor, with three filaments braided into the cursor and ions curling off
# the path, dimming out over about half a second; on the CPU path it draws
# kitty's trail alone. "fire" is a flame rising off the same trail, burning
# out from the tail and shedding embers along the path; it too is kitty's
# trail alone on the CPU path. "lightning" is a jagged bolt from the old cell
# to the cursor that draws itself in, holds and fades in a third of a second,
# with forks, a corona and falling sparks; kitty's trail alone on the CPU path.
# "ice" lays a lace of frost crystals along the path that holds, glints and
# melts tail first into falling hexagonal platelets, in about 0.7 s; kitty's
# trail alone on the CPU path. "ufo" is a flying saucer that swoops along the
# path, hovers over the cursor, lowers a tractor beam onto it and flies off,
# in 0.72 s; kitty's trail alone on the CPU path. "orb" is a glowing sphere
# that flies to the cursor with a halo and a comet's tail and bursts into
# sparks as it lands, in about half a second; kitty's trail alone on the CPU
# path. "liquid" is a clear glass gel in the cursor's colour that stretches
# from where the cursor was to where it is, pinches and draws its back end
# into a drop round the cursor, which bulges as it lands, and fades, in about
# 0.4 s; kitty's trail alone on the CPU path. "quad" is kitty's trail: a
# quadrilateral whose four corners chase the cursor's, the ones facing the
# move leading and the ones behind it lagging, over about half a second. Both
# follow a move of more than two cells once the cursor has rested for 10 ms,
# so typing and streaming output leave none. "sweep" is sfte's trail on the
# same moves: the cursor's box swept from a tail chasing it, fading from half
# the cursor's colour at the cursor to nothing at the tail. "ghost" is a
# one-cell box sweeping from the cell the cursor left to the cell it reached.
# "off" is none; true and false still mean the default and "off". An idle
# terminal pays nothing for any of them, because only a cursor that moved
# leaves one. docs/cursor.md shows each, and docs/cursor.html plays them.
# Under macOS's Reduce Motion the default is off; a trail named here is kept,
# so the line below is commented out -- uncomment it only to keep a trail
# whatever that setting says.
#
# `trail_scroll`: when output scrolls the screen smoothly under a trail in
# flight, "ride", the default, carries the trail up with the text for at most
# two rows and then folds it into the cursor, so it lands while output
# streams; "stay" draws it where the screen had it, as before the ride was
# built, and may lie over part of a sliding cursor for up to 60 ms. It changes
# nothing under `[scroll] mode = "normal"`.
[cursor]
shape = "block"
blink = "auto"
blink_animation = "plasma"
# blink_interval_ms = 333
stop_blinking_after = 0
trail_scroll = "ride"
# trail = "plasma"

# Whether switching to or from the alternate screen (opening or leaving a
# full-screen program like vim or less) fades the new screen in from the
# background. Off by default; opt-in polish, and an idle terminal pays
# nothing for it.
[screen]
transition = false

# How output scrolls the screen: "normal" jumps it up in one step, "smooth"
# slides it. "smooth" by default -- the slide is bounded to one row so a fast
# burst snaps forward rather than accumulating lag, and an idle screen pays
# nothing, so the added latency is bounded rather than a reason to opt out.
# Set "normal" for an instant jump with no slide.
[scroll]
mode = "smooth"

# How much memory the image store (Sixel and kitty graphics) is given:
# pixels_mb bounds the DECODED images (a 1024x1024 picture is 4 MiB whatever
# its Sixel or PNG encodes to). It is the one limit on an image's size,
# beside the 65535 pixels a side and 32 images at once: a Sixel is decoded as
# its bytes arrive and the bytes are not kept, so a long Sixel is no
# different from a short one. An image past the arena is refused (and
# counted) rather than shown in half.
#
# The default, 95 MiB, holds three 3840x2160 screens decoded, the "few full
# screen images" kitty's protocol asks a terminal to allow, and costs nothing
# until an image comes: the store's memory is committed as images write it.
# Until 2026-10-14 the raw bytes were held first, under a second key,
# body_kb: at its 256 KiB a UI screenshot (334-390 KiB at 600x375), a photo
# (474-680 KiB at 600x800) and a page of a text PDF (797-820 KiB at 600x776)
# were refused and the pane stayed blank. body_kb limits nothing now, and
# naming it logs a line saying so. Each refusal logs one warning naming the
# limit and the sizes, on stderr, so it shows when baud is launched from a
# terminal and not from the Dock.
#
# advertise_sixel makes the Primary DA claim Sixel (attribute 4), so a
# previewer such as yazi draws a real image instead of its text fallback --
# chafa's grid of block elements, box-drawing strokes and coloured spaces.
# Off by default: the text preview is what baud is proven to draw right, and
# the claim is the reader's to make.
[images]
pixels_mb = 95
advertise_sixel = false

# Whether a program can put text on the clipboard with OSC 52: remote
# Neovim, tmux's copy mode or a multiplexer over ssh, which have no other way
# to reach this Mac's pasteboard. "write" lets them, "off" refuses every copy
# and logs once that it did. Reading the clipboard back is always refused --
# what a program would read is whatever you last copied.
#
# The price of "write": anything printed to the terminal, a file you cat
# included, can replace the clipboard without asking. Every accepted copy is
# counted in the five-second report, logged at BAUD_LOG=info; the default
# level, warn, shows only refusals.
#
# body_kb is the largest copy, in KiB of the base64 the program sends: 256
# holds 192 KiB of text. A longer copy is refused whole, never cut, and logs
# a warning naming this key.
[clipboard]
osc52 = "write"
body_kb = 256


# The window's material and how it is dimmed. Every key here is one the
# macos-liquid-glass example sweeps with a GN_* environment variable -- the
# content both its examples draw, and what was built as "glassterm" -- and the
# defaults below are that example's own calibration, which its header records
# as tuned against the system widget over one wallpaper rather than derived
# from a measurement. So they are a starting point, which is why they are keys.
#
# Four of the eight are PAIRS, because macOS light/dark is two different
# surfaces: the same darkening that reads right over a dark desktop is far too
# much over a light one. baud picks the one the system appearance names and
# changes it when that changes -- so does the palette, unless "theme" above
# pins it. On Linux there is no appearance signal yet, so "dim_dark" is used
# and the rest of this section has no counterpart at all.
[glass]

# Which material. "clear" is the thinner, more transparent one, which Apple's
# HIG pairs with a dimming layer over bright content -- which is what a
# terminal body is. "regular" is the standard frosted material.
style = "clear"

# The body dim: the opacity EVERY background is painted at, 0 clear to 1
# opaque, so the desktop shows through it. Not just the default background --
# a colour an application sets is translucent too, so btop and anything else
# that paints its own panels is glass rather than a slab. This is the key to
# turn up if the text over those panels is hard to read, and down for more
# glass.
dim_dark = 0.22
dim_light = 0.12

# Whether a background an application sets is dimmed with the default one.
# "dim" draws it at the body dim, so btop's panels are glass. "opaque" draws
# every background an application sets as it chose it, and leaves only the
# default background glass, so btop's panels are solid.
app_backgrounds = "dim"

# Under "dim" above, whether a picture drawn in text keeps its backgrounds
# solid. A file manager's photo preview (chafa, when there is no Sixel) is a
# glyph on a background in every cell; dimmed, the backgrounds turn to holes
# between solid glyphs and the photo reads as noise. "opaque" finds the
# pictures -- a connected block of set backgrounds with sixteen or more
# colours, which a photo has and no measured TUI panel does (the busiest,
# vim's diff mode, has 8) -- and draws only those solid. "dim" dims them too.
pictures = "opaque"

# The material darkening, applied to the material itself rather than as a
# layer over it, so the titlebar strip and the body are one surface. 0 turns
# it off.
tint_dark = 0.54
tint_light = 0.14

# The darkening's hue and saturation, 0 to 1 each. Not black: black scales
# every channel equally, so it cannot shift the material's hue, only scale the
# colour down -- the harder it darkens, the less colour survives. 0.60 is a
# blue.
hue = 0.60
saturation = 0.80

# Whether the window casts a shadow: "auto", "always" or "never". "auto" casts
# one only under a dark appearance -- over a light material a window shadow
# draws as a hard black outline, which none of the system's own light glass
# surfaces have.
shadow = "auto"
